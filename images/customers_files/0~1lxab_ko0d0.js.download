utral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"glacier-blue":eV({id:"glacier-blue",name:"Glacier Blue",category:"cool",description:"A deep ice-blue palette with moderate saturation in the blue range at low-medium brightness, paired with steel-gray secondary tones at very low saturation. The primary evokes glacial depth while the secondary provides neutral structure. A frost-white accent at very high brightness creates crisp highlights against the cool base. Ideal for HVAC companies, ski resorts, and cold-storage logistics brands.",colorPalette:{primary:{colorSet:_("#E8F0F5"),isDynamic:!0},secondary:{colorSet:_("#2E4A62"),isDynamic:!0},accent:{colorSet:_("#1A6B8A"),isThemeColor:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.slate,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"white",contrast:7}},secondary:{backgroundColor:{category:"primary",scale:"interactive-bg-3"}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"canvas-bg-2"},featured:{category:"accent",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"moonlit-ocean":eV({id:"moonlit-ocean",name:"Moonlit Ocean",category:"cool",description:"A deep teal palette with moderate-to-high saturation in the blue-green range at low brightness, paired with silver secondary tones at very low saturation and high brightness. The contrast between deep oceanic primaries and luminous silver surfaces creates moonlit reflections. A midnight-blue accent adds depth. Ideal for marine services, aquariums, and coastal hospitality seeking mysterious, nocturnal cool tones.",colorPalette:{primary:{colorSet:_("#0B3D4A"),isThemeColor:!0},secondary:{colorSet:_("#C5CED6"),isDynamic:!0},accent:{colorSet:_("#1E5F74"),isDynamic:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.slate,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"primary",scale:"solid"},foregroundColor:{tint:"white",contrast:7}},secondary:{backgroundColor:{category:"secondary",scale:"interactive-bg-2"}}}}},globalColorOverrides:{background:{base:{category:"secondary",scale:"canvas-bg"},featured:{category:"primary",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"northern-sky":eV({id:"northern-sky",name:"Northern Sky",category:"cool",description:"A pale sky-blue palette with low saturation in the blue range at very high brightness, paired with cloud-gray secondary tones at minimal saturation. Both scales sit in the high-brightness range, creating an open, expansive feel. A deep teal accent at high saturation and low brightness adds rich, grounded contrast against the airy base. Ideal for airlines, cloud services, and meditation apps seeking serene openness.",colorPalette:{primary:{colorSet:_("#E6F0FA"),isDynamic:!0},secondary:{colorSet:_("#D0D8E0"),isDynamic:!0},accent:{colorSet:_("#00425A"),isThemeColor:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.gray,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"white",contrast:7}},secondary:{backgroundColor:{category:"secondary",scale:"interactive-bg-3"}}}}},globalColorOverrides:{background:{base:{category:"accent",scale:"solid"},featured:{category:"primary",scale:"canvas-bg"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"frozen-slate":eV({id:"frozen-slate",name:"Frozen Slate",category:"cool",description:"A dark blue-gray palette with low-to-moderate saturation in the cool blue range at very low brightness, creating a frozen, overcast atmosphere. The primary delivers icy darkness with subtle blue undertones. A pale ice-blue secondary provides crisp contrast against the dark base. A steel-blue accent adds cold metallic focus. Ideal for winter sports brands, cold brew companies, and Scandinavian furniture studios.",colorPalette:{primary:{colorSet:_("#1A2530"),isThemeColor:!0},secondary:{colorSet:_("#D5E3ED"),isDynamic:!0},accent:{colorSet:_("#4A8CAF"),isDynamic:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.slate,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"white",contrast:7}},secondary:{backgroundColor:{category:"secondary",scale:"interactive-bg-2"}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"interactive-bg",isInverted:!0},featured:{category:"accent",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"abyss-green":eV({id:"abyss-green",name:"Abyss Green",category:"cool",description:"A dark cold-green palette with moderate saturation in the blue-green range at very low brightness, evoking deep underwater chill. The primary delivers dark emerald depth with cool undertones. A silver-white secondary creates stark contrast. A muted cyan accent adds cold oceanic highlights. Ideal for environmental nonprofits, deep-sea documentaries, and premium seafood restaurants.",colorPalette:{primary:{colorSet:_("#0A2A28"),isThemeColor:!0},secondary:{colorSet:_("#E0E8E6"),isDynamic:!0},accent:{colorSet:_("#2D9B8A"),isDynamic:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.sage,{neutra