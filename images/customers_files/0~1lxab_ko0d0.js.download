e to our overwhelming response, we'll respond within five business days to discuss your bespoke floral needs.",watermark:"Get in touch",fields:[{slug:"name",kind:"built-in",question:"Full Name",answerType:"text",required:!0},{slug:"email",kind:"built-in",question:"Email Address",answerType:"text",required:!0},{slug:"interest",kind:"custom",question:"What are you interested in?",answerType:"dropdown",required:!1,options:[{id:"0a3d8c1e-1f2b-4c3d-8e5f-1a2b3c4d5e6f",label:"Weddings"},{id:"1b4e9d2f-2a3c-4d4e-9f6a-2b3c4d5e6f7a",label:"Events"},{id:"2c5f0e3a-3b4d-4e5f-0a7b-3c4d5e6f7a8b",label:"Spaces"},{id:"3d6a1f4b-4c5e-4f6a-1b8c-4d5e6f7a8b9c",label:"Something else"}]},{slug:"message",kind:"built-in",question:"Tell us about your vision",answerType:"textarea",required:!0}],submitLabel:"Send message",formSuccess:{successTitle:"Thank you!",successMessage:"We'll be in touch within five business days.",successButtonLabel:"Send another message"},showWatermark:!0},versionedSchema:T7["contact-form-watermark"],colorTokensSchema:tL.colorTokensSchema}),IC=T8({id:"contact-image-links",name:"Contact Image Links",description:"A contact section featuring contact information links alongside an image.",type:"contact",visualConfigPresets:[{imagePosition:"right"},{imagePosition:"left"}],exampleConfig:{kicker:"Contact us",heading:"Send us a message",description:"We would love to hear from you",businessContact:{contactEmail:"email@example.com",contactPhone:"+1 (555) 000-0000",contactAddress:"123 far away street, 123456 - Vancouver BC",directionsLink:"https://www.google.com/maps/dir/?api=1&destination=123+far+away+street,+123456+-+Vancouver+BC"},image:{src:"https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&q=80",alt:"Contact us"},imagePosition:"right"},versionedSchema:T7["contact-image-links"],colorTokensSchema:tV.colorTokensSchema}),IT=T8({id:"cta-background-image",name:"Background Image CTA",description:"A call-to-action section with a background image, heading, description, and buttons.",type:"cta",visualConfigPresets:[{textAlignment:"center"},{textAlignment:"split"}],exampleConfig:{heading:"Get the Yard You Want Today!",description:"Transform your outdoor space into a vibrant sanctuary. From lush blooms to timeless layouts, we'll bring beauty and balance to your garden.",backgroundImage:{src:"https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=1920",alt:"Professional gardener tending to plants in a beautiful garden"},buttons:[{label:"Talk to an Expert",href:"#",actionType:"section"},{label:"Get a Free Quote",href:"#",actionType:"section"}],textAlignment:"center",showButtons:!0},versionedSchema:T7["cta-background-image"],colorTokensSchema:t$.colorTokensSchema}),II=T8({id:"cta-basic",name:"Basic CTA",description:"A simple call-to-action section with heading, description, and buttons.",type:"cta",visualConfigPresets:[{textAlignment:"center"},{textAlignment:"split"}],exampleConfig:{heading:"Get the Yard You Want Today!",description:"Transform your outdoor space into a vibrant sanctuary. From lush blooms to timeless layouts, we'll bring beauty and balance to your garden.",buttons:[{label:"Talk to an Expert",href:"#",actionType:"section"},{label:"Get a Free Quote",href:"#",actionType:"section"}],textAlignment:"center",showButtons:!0},versionedSchema:T7["cta-basic"],colorTokensSchema:tK.colorTokensSchema}),IS=T8({id:"cta-card",name:"Card CTA",description:"A call-to-action section styled as a card with heading, description, and buttons.",type:"cta",visualConfigPresets:[{textAlignment:"center"},{textAlignment:"split"}],exampleConfig:{heading:"Get the Yard You Want Today!",description:"Transform your outdoor space into a vibrant sanctuary. From lush blooms to timeless layouts, we’ll bring beauty and balance to your garden.",buttons:[{label:"Talk to an Expert",href:"#",actionType:"section"},{label:"Get a Free Quote",href:"#",actionType:"section"}],textAlignment:"center",showButtons:!0},versionedSchema:T7["cta-card"],colorTokensSchema:tY.colorTokensSchema}),IB=T8({id:"cta-card-2",name:"Card CTA 2",description:"A centered call-to-action section with a prominent card container.",type:"cta",visualConfigPresets:[{textAlignment:"center"},{textAlignment:"left"}],exampleConfig:{heading:"Let's start building a brighter financial future together.",description:"We're here to help you manage your finances with smart planning and investing tips.",buttons:[{label:"Get Started",href:"#",actionType:"section"}],textAlignment:"center",showButtons:!0},versionedSchema:T7["cta-card-2"],colorTokensSchema:tZ.colorTokensSchema}),IF=T8({id:"cta-editorial-image",name:"Editorial Image CTA",description:"A full-width editorial call-to-action with text over a darkened background image.",type:"cta",visualConfigPresets:[],exampleConfig:{kicker:"",heading:"In Full Bloom.",description:"Every arrangement tells a story. Our florists handcraft seasonal bouquets sourced from sustainable farms worldwide—delivering nature's finest to your door, same day.",buttons:[{label:"Explore Services",href:"#services",actionType:"section"}],backgroundImage:{src:"https://images.unsplash.com/photo-1655842211964-92aba6abfde6?w=1920&q=80",alt:"Pink hibiscus flowers in warm light"},showButtons:!0},versionedSchema:T7["cta-editorial-image"],colorTokensSchema:tQ.colorTokensSchema}),IO=T8({id:"embed-code",name:"Custom Code",description:"Embed custom HTML, CSS, or JavaScript code.",type:"embed",disallowAiGeneration:!0,visualConfigPresets:[{}],exampleConfig:{code:""},previewConfig:{code:'<div style="display:flex;align-items:center;justify-content:center;min-height:15rem;font-family:ui-monospace,monospace;font-size:2rem;color:rgb(100,116,139);background:rgba(100,116,139,0.1);"><span>&lt; custom code &gt;</span></div>'},versionedSchema:T7["embed-code"],colorTokensSchema:tJ.colorTokensSchema}),ID=T8({id:"faq-accordion",name:"FAQ Accordion",description:"A frequently asked questions section with an accordion layout.",type:"faq",visualConfigPresets:[{contentAlignment:"center"},{contentAlignment:"split"}],exampleConfig:{kicker:"FAQ",heading:"Frequently asked questions",description:"If you have any further questions, please contact us.",buttons:[],items:[{question:"What services do you offer for landscape design and maintenance?",answer:"We offer a variety of services for landscape design and maintenance, including custom garden design, lawn care, tree and shrub planting, irrigation system installation, and seasonal clean-up. Our team is dedicated to creating beautiful outdoor spaces that suit your needs and preferences."},{question:"What is the best time to plant a garden?",answer:"The best time to plant a garden depends on your location and the types of plants you want to grow. Generally, spring and fall are ideal for most plants, as temperatures are moderate and rainfall is more consistent. However, some plants thrive in summer or winter, so it's important to research the specific requirements of your chosen plants."},{question:"How do I maintain my landscape throughout the year?",answer:"Maintaining your landscape throughout the year involves regular tasks such as mowing, watering, fertilizing, pruning, and mulching. In spring, focus on planting and fertilizing. Summer requires consistent watering and pest control. Fall is the time for cleanup and preparation for winter. Winter maintenance includes protecting plants from frost and planning for the next growing season."},{question:"What types of plants thrive in my area?",answer:"The types of plants that thrive in your area depend on your climate zone, soil type, and sun exposure. Native plants are often the best choice as they are adapted to local conditions and require less maintenance. Consider consulting with a local nursery or landscape professional to identify plants that will flourish in your specific environment."},{question:"How can I create a sustainable garden?",answer:"Creating a sustainable garden involves choosing native plants, using organic fertilizers and pest control methods, conserving water through efficient irrigation systems and mulching, composting yard waste, and encouraging beneficial insects and wildlife. These practices help create a healthy ecosystem while reducing environmental impact."}],contentAlignment:"center",showButtons:!0},versionedSchema:T7["faq-accordion"],colorTokensSchema:t6.colorTokensSchema}),IP=T8({id:"faq-accordion-image",name:"FAQ Accordion with Image",description:"A frequently asked questions section with an accordion layout and an image on the right side.",type:"faq",visualConfigPresets:[{}],exampleConfig:{heading:"Frequently asked questions",items:[{question:"What services do you offer for landscape design and maintenance?",answer:"We offer a variety of services for landscape design and maintenance, including custom garden design, lawn care, tree and shrub planting, irrigation system installation, and seasonal clean-up. Our team is dedicated to creating beautiful outdoor spaces that suit your needs and preferences."},{question:"What is the best time to plant a garden?",answer:"The best time to plant a garden depends on your location and the types of plants you want to grow. Generally, spring and fall are ideal for most plants, as temperatures are moderate and rainfall is more consistent. However, some plants thrive in summer or winter, so it's important to research the specific requirements of your chosen plants."},{question:"How do I maintain my landscape throughout the year?",answer:"Maintaining your landscape throughout the year involves regular tasks such as mowing, watering, fertilizing, pruning, and mulching. In spring, focus on planting and fertilizing. Summer requires consistent watering and pest control. Fall is the time for cleanup and preparation for winter. Winter maintenance includes protecting plants from frost and planning for the next growing season."},{question:"What types of plants thrive in my area?",answer:"The types of plants that thrive in your area depend on your climate, soil type, and sunlight availability. Native plants are often the best choice as they are adapted to local conditions and require less maintenance. Consult with a local nursery or landscape professional to determine the best plants for your specific location and preferences."}],image:{src:"https://images.unsplash.com/photo-1558618666-fcd25c85cd64?q=80&w=1000&auto=format&fit=crop",alt:"Beautiful garden landscape"}},versionedSchema:T7["faq-accordion-image"],colorTokensSchema:t8.colorTokensSchema}),IE=T8({id:"faq-accordion-merged",name:"FAQ Accordion Merged",description:"A frequently asked questions section with accordion items grouped in a merged card container.",type:"faq",visualConfigPresets:[{}],exampleConfig:{heading:"FAQ's",description:"Still have questions? Contact us.",items:[{question:"What is Financial Planning?",answer:"Our team for analyzing and engaging with customers, evaluating valuable insights and connecting the branches."},{question:"How do I set Financial Goals?",answer:"Start by identifying your short-term and long-term financial objectives. Consider factors like retirement, education, emergency funds, and major purchases when setting your goals."},{question:"What is a Retirement Plan?",answer:"A retirement plan is a financial strategy designed to provide income during retirement. It typically involves saving and investing over your working years to build a nest egg for your future."},{question:"How do I invest my Money?",answer:"Investing involves putting your money into assets like stocks, bonds, mutual funds, or real estate with the expectation of earning returns. Consider your risk tolerance and time horizon when choosing investments."},{question:"What are the benefits of Financial Planning?",answer:"Financial planning helps you achieve your life goals, manage your money effectively, prepare for emergencies, and build long-term wealth through disciplined saving and investing strategies."}]},versionedSchema:T7["faq-accordion-merged"],colorTokensSchema:t9.colorTokensSchema}),IL=T8({id:"faq-card",name:"FAQ Card",description:"A FAQ section displaying questions and answers as cards in a responsive grid layout.",type:"faq",visualConfigPresets:[{}],exampleConfig:{kicker:"FAQ",heading:"Frequently asked questions",description:"We would love to hear from you",items:[{question:"What are the best plants for a low-maintenance garden?",answer:"Create a low-maintenance garden with native plants that need less water. Use perennials like lavender and sedum, which attract pollinators. Mulch retains moisture and reduces weeds, simplifying garden care."},{question:"How to choose the right low-maintenance shrubs?",answer:"Select shrubs that are drought-tolerant and disease-resistant. Options like boxwood and juniper require minimal pruning and can thrive in various soil types."},{question:"What ground cover is best for a low-maintenance yard?",answer:"Consider creeping thyme or clover as ground cover. They spread easily, suppress weeds, and require little watering once established, making them perfect for low-maintenance landscaping."},{question:"Tips for maintaining a low-maintenance lawn?",answer:"Opt for drought-resistant grass varieties like fescue or Bermuda. Mow less frequently and leave grass clippings on the lawn to provide nutrients and reduce the need for fertilizer."},{question:"What are some easy-care flowering plants?",answer:"Plant daylilies and coneflowers for vibrant blooms with minimal effort. These perennials are hardy, withstand various conditions, and attract beneficial insects."},{question:"How to design a low-maintenance outdoor space?",answer:"Incorporate hardscaping elements like stone pathways and patios. Use raised beds for easy access and select plants that thrive in your local climate to minimize upkeep."}],bottomTitle:"Still have questions?",bottomDescription:"Send us a message, and our team will get back to you as soon as possible.",buttons:[{label:"Contact us",href:"#contact",actionType:"section"}],showButtons:!0},versionedSchema:T7["faq-card"],colorTokensSchema:aa.colorTokensSchema}),IM=T8({id:"faq-editorial-split",name:"Editorial Split FAQ",description:"A split FAQ section with editorial intro content and a numbered accordion list.",type:"faq",visualConfigPresets:[{showButtons:!0},{showButtons:!1}],exampleConfig:{kicker:"FAQ",heading:"Questions",description:"Every arrangement tells a story. Our florists handcraft seasonal bouquets sourced from sustainable farms worldwide-delivering nature's finest to your door, same day.",buttons:[],items:[{question:"Wedding Floristry",answer:"Wedding Floristry involves designing and arranging beautiful floral decorations that enhance the ambiance of your special day, from bouquets to centerpieces and venue adornments."},{question:"Event Styling",answer:"Large-scale floral moments for dinners, launches, private gatherings, and editorial sets."},{question:"Corporate Subscriptions",answer:"Rotating weekly arrangements that keep studios, hospitality spaces, and offices alive."},{question:"Editorial & Workshops",answer:"Creative direction, botanical styling, and hands-on floral sessions for curious teams."}],showButtons:!1},versionedSchema:T7["faq-editorial-split"],colorTokensSchema:ao.colorTokensSchema}),Iq=T8({id:"faq-stretch",name:"FAQ Stretch",description:"A frequently asked questions section with a stretched layout featuring title on the left and FAQ items offset to the right.",type:"faq",visualConfigPresets:[{}],exampleConfig:{kicker:"00",heading:"/FAQ",description:"We combine strategic planning, targeted ads, and engaging content to reach ideal customers. Our focus is on clarity and relevance, ensuring our message resonates.",buttons:[{label:"Contact us",href:"#contact",actionType:"section"}],items:[{question:"How can I measure the effectiveness of my branding efforts?",answer:"Brand lift studies, social listening, website analytics, and customer surveys can help measure branding effectiveness."},{question:"How often should I update my branding materials?",answer:"Branding materials should be reviewed and updated regularly, ideally every 1-2 years, or whenever there are significant changes in your business or market."},{question:"What role does storytelling play in branding?",answer:"Storytelling helps create an emotional connection with your audience, making your brand more relatable and memorable."},{question:"What are some common branding mistakes to avoid?",answer:"Common mistakes include lacking a clear brand identity, inconsistent messaging, neglecting audience feedback, and failing to adapt to market changes."},{question:"What are the key components of a successful branding strategy?",answer:"A successful branding strategy includes defining your brand purpose, understanding your target audience, creating a unique value proposition, and consistent messaging."},{question:"How can I ensure brand consistency across different platforms?",answer:"Establish a brand style guide that outlines your brand's visual elements, tone of voice, and messaging guidelines to ensure consistency."}],showButtons:!0},versionedSchema:T7["faq-stretch"],colorTokensSchema:ai.colorTokensSchema}),IV=T8({id:"feature-bento-grid",name:"Feature Bento Grid",description:"A bento grid layout to showcase features or services with images and descriptions",type:"feature",visualConfigPresets:[],exampleConfig:{kicker:"Why choose us",heading:"Transform Your \nOutdoor Space with \nOur Expert Care",description:"We bring years of expertise, a love for nature, and a commitment to quality to every project. Whether it's a small garden or a full landscape transformation, we ensure exceptional results.",buttons:[{label:"Talk to an expert",href:"#",actionType:"section"}],items:[{type:"text",title:"Seasonal Cleanup & Landscaping",description:"Spring and fall leaf removal, debris clearing, mulching, and small landscaping enhancements such as planting or edging beds.",isInverted:!1},{type:"text",title:"Aeration & Overseeding",description:"Core aeration to improve soil oxygen and water absorption, followed by overseeding to thicken the turf and repair bare patches.",isInverted:!1},{type:"image",src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/Frame-32.png",alt:"Framed living wall of succulents above a shelf of potted plants"},{type:"image",src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/_base_image.png",alt:"Geometric sun icon on a textured cream background"},{type:"text",title:"Fertilization & Weed Control",description:"Scheduled nutrient applications and targeted weed treatments to promote lush, growth and prevent invasive species.",isInverted:!1},{type:"text",title:"Seasonal Cleanup & Landscaping",description:"Spring and fall leaf removal, debris clearing, mulching, and small landscaping enhancements such as planting or edging beds.",isInverted:!0},{type:"text",title:"Aeration & Overseeding",description:"Core aeration to improve soil oxygen and water absorption, followed by overseeding to thicken the turf and repair bare patches.",isInverted:!1},{type:"text",title:"Seasonal Cleanup & Landscaping",description:"Spring and fall leaf removal, debris clearing, mulching, and small landscaping enhancements such as planting or edging beds.",isInverted:!1},{type:"image",src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1779397975493-e5d61088-0a8d-4d66-9935-f1000ea3eff0.png",alt:"Framed living wall of succulents above a shelf of potted plants"}],showButtons:!0},versionedSchema:T7["feature-bento-grid"],colorTokensSchema:ah.colorTokensSchema}),IR=T8({id:"feature-card-carousel",name:"Feature Card Carousel",description:"A horizontally scrollable carousel of service/feature cards with icons, titles, and descriptions. Supports light and dark (inverted) modes with arrow navigation on desktop and dot pagination on mobile.",type:"feature",visualConfigPresets:[{isInverted:!1,sliderType:"arrows"},{isInverted:!0,sliderType:"arrows"},{isInverted:!1,sliderType:"dots"},{isInverted:!0,sliderType:"dots"}],exampleConfig:{kicker:"Services",heading:"Everything your small business needs to thrive financially",description:"From day-to-day bookkeeping to high-level strategic planning, we provide a holistic suite of services designed to support your business at every stage.",items:[{title:"Bookkeeping",description:"Monthly bookkeeping, organized statements, and financial clarity so you always know where your business stands."},{title:"Tax Planning",description:"Strategic tax planning and preparation to minimize your liability and maximize your returns year after year."},{title:"Payroll Services",description:"Comprehensive payroll management including direct deposits, tax withholdings, and compliance reporting."},{title:"Financial Analysis",description:"In-depth financial analysis and reporting to help you make informed decisions about your business growth."},{title:"Audit Support",description:"Professional audit preparation and support to ensure your business is always ready for any financial review."},{title:"Business Consulting",description:"Expert business consulting to help you navigate challenges and identify opportunities for growth and expansion."}],isInverted:!1,sliderType:"arrows"},versionedSchema:T7["feature-card-carousel"],colorTokensSchema:az.colorTokensSchema}),IU=T8({id:"feature-carousel",name:"Feature Carousel",description:"A horizontal carousel layout to highlight key features with supporting media and calls to action.",type:"feature",visualConfigPresets:[{showItemButtons:!0}],exampleConfig:{items:[{title:"Expert diagnostics",kicker:"Step 1",description:"We pinpoint the issue fast—so you get a clear plan before any wrench turns.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/premium-images/generated/1781558786585-e83d6b69-3c98-41cd-9387-49f02da86f16.png",alt:"Silver classic Porsche parked in a clean garage with organized tools"},buttons:[{label:"Diagnostics",actionType:"section",href:"#diagnostics"}]},{title:"Precision repairs",kicker:"Step 2",description:"From brakes to sensors, we fix it right the first time with pro-grade tools and parts.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/premium-images/generated/1781558608420-e45bbf75-1a38-4331-964e-83a9898b3201.png",alt:"Silver Porsche 911 parked in a modern garage workshop"},buttons:[{label:"Repairs",actionType:"section",href:"#repairs"}]},{title:"We come to you",kicker:"Step 3",description:"Skip the shop drop-off. We service your car at home, work, or wherever you’re parked.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/premium-images/generated/1781551944591-6c7a3d6a-2e5f-4930-99fa-3575efe27fce.png",alt:"White sedan parked on a quiet residential street"},buttons:[{label:"Book a visit",actionType:"section",href:"#book"}]},{title:"Trucks & SUVs",kicker:"Step 4",description:"Built for bigger vehicles too—routine maintenance and repairs for the cars your life runs on.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/premium-images/generated/1781558834920-f64178ef-2b99-4cfd-a6ed-f1fc17239ecb.png",alt:"White Jeep Wrangler Rubicon parked in a garage workshop"},buttons:[{label:"SUV care",actionType:"section",href:"#suvs"}]},{title:"Scheduled maintenance",kicker:"Step 5",description:"Oil changes, inspections, and upkeep that keep your daily driver reliable mile after mile.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/premium-images/generated/1781558945584-96d237eb-8444-4d07-8123-f0b854a09485.png",alt:"Blue sedan parked in a clean home garage with tool storage"},buttons:[{label:"Maintenance",actionType:"section",href:"#maintenance"}]}],showItemButtons:!0},versionedSchema:T7["feature-carousel"],colorTokensSchema:aw.colorTokensSchema}),IN=T8({id:"feature-carousel-accordion",name:"Feature Carousel Accordion",description:"A horizontal carousel layout to highlight key features with supporting media and accordion based navigation.",type:"feature",visualConfigPresets:[{}],exampleConfig:{kicker:"How we help",heading:"Financial clarity\nfor every stage\nof life",description:"From everyday budgeting to long-term goals, we help you build a plan that protects what matters and grows with you.",items:[{title:"Education savings",description:"College and future-ready plans that grow alongside your kids—so opportunity is within reach when they need it.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1776191894455-4d53ac55-01a4-4583-8719-4fb3ea27efbc.png",alt:"Two children laughing on a sofa while wearing homemade robot hats"}},{title:"Budgeting that sticks",description:"Simple systems for tracking spending, paying down debt, and building habits that keep your household on solid ground.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1779910235856-2900206c-2eea-4d10-966d-c52c1c51feb1.png",alt:"Couple reviewing financial documents together at a kitchen table"}},{title:"Retirement planning",description:"Clear roadmaps for saving, investing, and stepping into retirement with confidence—so your later years feel secure.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1779910115906-c5986b07-b05a-493e-97fc-ca0790e1d349.png",alt:"Happy elderly couple sitting together on a living room sofa"}},{title:"Family protection",description:"Insurance, emergency funds, and estate basics designed to safeguard the people who depend on you most.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1779910163760-c73dce96-8c09-4dd6-826c-4ea802947656.png",alt:"Parents swinging their toddler between them on a wooded path"}},{title:"Personal advisory",description:"One-on-one guidance through big decisions—home buying, investments, and tax strategy—with advice you can act on.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1779841350790-d1b4a434-4866-4434-9788-6d194166c07f.png",alt:"Financial advisors reviewing documents and a laptop at a conference table"}}]},versionedSchema:T7["feature-carousel-accordion"],colorTokensSchema:aC.colorTokensSchema}),IH=T8({id:"feature-centered-carousel",name:"Feature Centered Carousel",description:"A centered carousel layout to showcase features with images, titles, and descriptions. Features partial visibility of adjacent slides and dot navigation.",type:"feature",visualConfigPresets:[{}],exampleConfig:{kicker:"Our Services",heading:"Your Partner in\nFinancial Success",description:"Our certified financial experts guide individuals and businesses in making informed decisions about retirement, investing, and daily finances.",buttons:[{label:"Schedule a Call",href:"#contact",actionType:"section"}],items:[{title:"Tax Optimization Services",description:"We provide tax planning to lower liabilities and enhance returns. Our experts stay updated on tax laws.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1779910154621-72803567-5c6e-4f1d-9aa7-f60be38d907e.png",alt:"Parents swinging their toddler between them in a sunny grassy field"}},{title:"Wealth Management",description:"Comprehensive wealth management solutions tailored to your financial goals and risk tolerance.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/premium-images/generated/1781303422200-8d2b33f1-0a9d-4625-9beb-eef4b157ece4.png",alt:"Couple smiling at each other in front of a craftsman-style home"}},{title:"Retirement Planning",description:"Strategic retirement planning to secure your future with personalized investment strategies.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/premium-images/generated/1781303372014-63179f8d-fc9e-4893-bca1-c7f19beba4fe.png",alt:"Advisor in a warm office speaking with a client taking notes"}},{title:"Estate Planning",description:"Protect your legacy with comprehensive estate planning and wealth transfer strategies.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/premium-images/generated/1781304022739-902ed775-ffd5-4f5b-a5b8-4c6106c66f4f.png",alt:"Woman laughing while cooking at a stove in a bright kitchen"}},{title:"Insurance Solutions",description:"Tailored insurance coverage to protect what matters most to you and your family.",image:{src:"https://images.unsplash.com/photo-1450101499163-c8848c66ca85?w=1200&h=900&fit=crop",alt:"Insurance Solutions"}}],showButtons:!0},versionedSchema:T7["feature-centered-carousel"],colorTokensSchema:aS.colorTokensSchema}),IW=T8({id:"feature-expandable-carousel",name:"Feature Expandable Carousel",description:"An expandable carousel that displays features with the active slide expanded and others collapsed showing only numbers on desktop. On tablet and mobile, it becomes a horizontal slider with dot indicators.",type:"feature",visualConfigPresets:[{textContentAlignment:"left"},{textContentAlignment:"center"}],exampleConfig:{kicker:"Features",heading:"Everything you need to succeed",description:"Powerful tools and features designed to help you achieve your goals faster and more efficiently.",textContentAlignment:"left",buttons:[{label:"Get Started",actionType:"section",href:"#get-started"},{label:"Learn More",actionType:"section",href:"#learn-more"}],items:[{tag:"01",title:"Guided onboarding",description:"Personalized setup paths enable every role to get productive on day one."},{tag:"02",title:"Workflow automations",description:"Automate repetitive handoffs with adaptable playbooks built for your processes."},{tag:"03",title:"Actionable insights",description:"Real-time dashboards surface trends and recommended actions before issues appear."},{tag:"04",title:"Integrated support",description:"Live specialists and deep documentation keep launches on track around the clock."}],showButtons:!0},versionedSchema:T7["feature-expandable-carousel"],colorTokensSchema:aF.colorTokensSchema}),IG=T8({id:"feature-grid",name:"Feature Grid",description:"A grid layout to showcase features or services with images and descriptions",type:"feature",visualConfigPresets:[{imageOptions:{showImages:!0,isCaptionInside:!0}},{imageOptions:{showImages:!0,isCaptionInside:!1}},{imageOptions:{showImages:!1}}],exampleConfig:{kicker:"The studio",heading:"Handmade pottery\nfor everyday\nrituals",description:"Small-batch stoneware shaped by hand—quiet pieces meant for slow mornings, shared tables, and the rituals that make a house feel like home.",buttons:[{label:"Visit the studio",href:"#",actionType:"section"}],items:[{title:"Studio collection",description:"Shelves of finished work—mugs, bowls, and plates ready to bring home.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1779473519857-1b4048e0-92c2-46d3-ae5c-fe0f71fe3d40.png",alt:"Handmade mugs, bowls, and plates displayed on rustic wooden shelves"}},{title:"Everyday vessels",description:"Functional forms with soft glazes and speckled details for daily use.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1779473035884-622137d8-3fd0-48aa-a144-29dd51165809.png",alt:"Fluted dish, speckled bowl, and two-tone mug on a wooden shelf"}},{title:"Wheel throwing",description:"Hands-on classes where you learn to center clay and shape your own pieces.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1779475691756-1515d817-9b68-4f7a-b273-1169ae75bb9c.png",alt:"Potter shaping a speckled blue-rimmed bowl on a wooden pottery wheel"}},{title:"Dinnerware sets",description:"Stacked plates with creamy glaze and fine speckles for the table you gather around.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1779473609618-d3ecad14-9368-438d-989d-e051bb0941b4.png",alt:"Stack of speckled cream ceramic plates on weathered wood"}},{title:"Serving bowls",description:"Generous bowls with blue-rim accents, made for sharing and slow meals.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1779472511888-ec0d7faf-36dc-4990-8b35-ada6f3526da9.png",alt:"Stacked cream bowls with blue speckled rims on a wooden shelf"}},{title:"Custom commissions",description:"One-of-a-kind pieces and small runs crafted to match your space and style.",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1779472643120-37da583a-2b6a-4ac4-99dd-4bdbf8593ce8.png",alt:"Ceramic mugs, jug, bowls, and terracotta pots on sunlit studio shelves"}}],imageOptions:{showImages:!0,isCaptionInside:!1},showButtons:!0},versionedSchema:T7["feature-grid"],colorTokensSchema:aR.colorTokensSchema}),I$=T8({id:"feature-grid-with-image",name:"Feature Grid with Image",description:"A two-column layout combining a hero image with a grid of features",type:"feature",visualConfigPresets:[{imagePositionOptions:{imagePosition:"right",hasImagePadding:!1}},{imagePositionOptions:{imagePosition:"right",hasImagePadding:!0}},{imagePositionOptions:{imagePosition:"left",hasImagePadding:!1}},{imagePositionOptions:{imagePosition:"left",hasImagePadding:!0}},{imagePositionOptions:{imagePosition:"top"}},{imagePositionOptions:{imagePosition:"bottom"}}],exampleConfig:{kicker:"WHY CHOOSE US",heading:"Spaces that feel\nas good as\nthey look",description:"Thoughtful interiors tailored to how you live—balancing beauty, function, and the quiet details that make a house feel like home.",buttons:[{label:"Talk to an expert",href:"#",actionType:"section"}],items:[{title:"Full-home design",description:"Cohesive plans for every room—from layout and finishes to furniture and lighting."},{title:"Material curation",description:"Textures, palettes, and pieces selected to feel intentional, lasting, and uniquely yours."},{title:"Indoor-outdoor living",description:"Seamless transitions between interior spaces and patios, courtyards, and gardens."},{title:"Project guidance",description:"Clear direction from concept through install, so every detail lands with confidence."}],image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1779405609350-243483c3-ccd0-4f42-b30c-253448f3547e.png",alt:"Mediterranean courtyard lounge with lanterns, planters, and lush greenery"},imagePositionOptions:{imagePosition:"right"},showButtons:!0},versionedSchema:T7["feature-grid-with-image"],colorTokensSchema:a1.colorTokensSchema}),IK=T8({id:"feature-icons",name:"Feature Icons",description:"A grid layout showcasing features or services with icons, titles, and descriptions.",type:"feature",visualConfigPresets:[],exampleConfig:{items:[{icon:"check-circle",title:"Seasonal Cleanup & Landscaping",description:"Stunning, tailored gardens and outdoor spaces designed for you."},{icon:"calendar",title:"Aeration & Overseeding",description:"Revitalize your lawn with professional aeration and overseeding services."},{icon:"check",title:"Fertilization & Weed Control",description:"Keep your lawn lush and weed-free with targeted treatments."},{icon:"location-pin",title:"Landscape Design",description:"Custom landscape designs that transform your outdoor living space."}]},versionedSchema:T7["feature-icons"],colorTokensSchema:a2.colorTokensSchema}),IY=T8({id:"feature-images-carousel",name:"Feature Images Carousel",description:"A horizontal scrolling carousel showcasing features with images and captions",type:"feature",visualConfigPresets:[{}],exampleConfig:{kicker:"Care",heading:"Support for every chapter",description:"Warm, grounded therapy for individuals, parents, and families—helping you build healthier patterns and feel more present in everyday life.",items:[{image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/premium-images/generated/1781304375150-8865e971-b6e3-4d93-972b-1d32831dbe2f.png",alt:"Father and son smiling together while cooking in a home kitchen"},title:"Family therapy",description:"Strengthen communication and connection so home feels safer and more supportive."},{image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/premium-images/generated/1781304024129-b51473c4-148e-4da1-a431-7246f11abc21.png",alt:"Woman laughing joyfully while cooking at a kitchen stove"},title:"Individual therapy",description:"One-on-one sessions to process stress, rebuild confidence, and find steadier ground."},{image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/premium-images/generated/1781304146469-4644abc5-24bb-48c1-b279-e03547376c35.png",alt:"Parent and child relaxing together on a sofa with their dog"},title:"Parenting support",description:"Tools for calmer routines, clearer boundaries, and more ease in daily family life."},{image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/premium-images/generated/1781304445666-b4eab031-62d7-4b94-8541-8b92128d8ada.png",alt:"Man and young boy talking warmly in a sunlit kitchen"},title:"Child & teen therapy",description:"A safe space for kids and teens to share feelings and build emotional resilience."}]},versionedSchema:T7["feature-images-carousel"],colorTokensSchema:a4.colorTokensSchema}),IX=T8({id:"feature-menu-grid",name:"Feature Menu Grid",description:"A grid layout to showcase menu items or services with images, descriptions, and prices",type:"feature",visualConfigPresets:[{showImages:!0},{showImages:!1}],exampleConfig:{kicker:"Available after 5pm",heading:"Dessert Menu",description:"Always fresh, always in season, always tasty",items:[{title:"Berry Crumble with Oat Topping",description:"Seasonal berries baked with a golden oat crumble, served warm with vanilla bean ice cream.",price:"$10",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1775857214570-f95affb6-0e1b-4922-9723-4036d61dfbca.png",alt:"Berry Crumble with Oat Topping"}},{title:"Tiramisu",description:"Classic Italian dessert with espresso-soaked ladyfingers, mascarpone cream, and cocoa dusting.",price:"$12",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1775864346250-75cd6fe9-93c2-4989-8a65-f899d41619b3.png",alt:"Tiramisu"}},{title:"Apple Pie",description:"Warm spiced apple filling in a buttery, flaky crust, served with a scoop of cream.",price:"$9",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1775864360708-e44ac009-4193-4f27-bee4-b94f2bcb65c4.png",alt:"Apple Pie"}},{title:"Strawberry Rhubarb Compote",description:"Tart rhubarb and sweet strawberries slow-cooked into a vibrant, glossy compote.",price:"$8",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1775864405495-077ee441-a075-47c6-bed1-17bbcde428da.png",alt:"Strawberry Rhubarb Compote"}},{title:"Ginger Ice Cream",description:"Hand-churned ice cream infused with fresh ginger root, served in a chilled bowl.",price:"$8",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1775864417066-3b482e74-b850-4480-bd49-575ef0663c67.png",alt:"Ginger Ice Cream"}},{title:"Deluxe Brownie",description:"Rich dark chocolate brownie with a fudgy centre, topped with toasted pecans and sea salt.",price:"$9",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1775864446474-1d983b5d-26da-4edc-9676-d29666fb8598.png",alt:"Deluxe Brownie"}}],showImages:!0},versionedSchema:T7["feature-menu-grid"],colorTokensSchema:a8.colorTokensSchema}),IZ=T8({id:"feature-menu-list",name:"Feature Menu List",description:"A list layout to showcase services or features with images, descriptions, and prices",type:"feature",visualConfigPresets:[{showImages:!0},{showImages:!1}],exampleConfig:{kicker:"Available after 5pm",heading:"Dinner Menu",description:"Always fresh, always in season, always tasty",items:[{title:"Heirloom Tomato & Burrata Salad",description:"Creamy burrata paired with ripe heirloom tomatoes, basil, and a drizzle of local honey and olive oil.",price:"$14",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1775857177608-cc4192d5-e2a1-4d39-a689-2576bdf0eb2e.png",alt:"Heirloom Tomato & Burrata Salad"}},{title:"Spring Pea & Mint Risotto",description:"Arborio rice slowly cooked with fresh spring peas, garden mint, parmesan, and vegetable stock.",price:"$19",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1775857181461-3cb4a472-b30c-49a0-a863-1fb99a701f1e.png",alt:"Spring Pea & Mint Risotto"}},{title:"Wood-Fired Free-Range Chicken",description:"Herb-marinated chicken roasted over wood fire, served with roasted root vegetables and pan jus.",price:"$26",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1775857299981-1adc074f-d1a8-448a-87b6-734371ae7820.png",alt:"Wood-Fired Free-Range Chicken"}},{title:"Grass-Fed Beef Burger",description:"Juicy local beef patty with aged cheddar, lettuce, tomato, house pickles, and hand-cut fries.",price:"$22",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1775857282820-1069623e-0d33-44ef-aa71-4d6b369f965b.png",alt:"Grass-