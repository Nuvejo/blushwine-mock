ight","showcase-list","showcase-strip-images","metrics-basic","metrics-editorial-split","metrics-card-grid","metrics-card-highlight","metrics-big-numbers","metrics-numbers","text-basic","text-scroll-reveal","location-map","location-text-and-map","location-editorial-map","location-business-hours","blog-feed","blog-featured","blog-list","location-card","embed-code","feature-video"],"sectionRegistry",0,SK],387062)},54674,235585,831199,e=>{"use strict";let t,a;var o,r=e.i(387361),i=e.i(808583),n=e.i(491918),s=e.i(290583),c=e.i(387062);let l=e=>c.sectionRegistry[e],d=e=>Object.values(c.sectionRegistry).filter(t=>t.type===e).map(e=>e.id);e.s(["getAllSectionsOfType",0,d,"getSection",0,l],235585);let g=["global","professional-structure","airy-spacious","vibrant-blooms","growth-engine","clay-cool","pure-vitality","midnight-aurora","alpina-ventures","steady-ascent","sharp-signal","strategic-insight","heritage-drive","honest-craft","urban-edge","modern-foundation","reliable-core","serene-wellness","artisan-craft","paw-voyage","nordic-edge","true-exposure"],p={global:{id:"global",name:"Global",description:"Internal audit baseline — broad section coverage, rounded corners, serif default type, and global palette controls for checking visual consistency. Best for Storybook-only review rather than a user-facing aesthetic.",tags:["neutral","structured","utility"],isPublished:!1,themeConfig:{colorSchemes:[{id:"neutral-cloud",name:"Neutral Cloud",description:"A clean neutral palette inspired by soft grayscale gradients, pairing misty mid-gray structure with bright silver surfaces and charcoal accents. The tones stay balanced and understated while preserving strong readability and hierarchy. Ideal for professional brands that need a minimal, calm, and versatile visual baseline.",category:"light",themeColor:"#404040",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-porcelain",name:"Neutral Porcelain",description:"A light porcelain-inspired neutral palette with airy stone-gray foundations, soft silver surfaces, and balanced graphite accents for calm, minimal layouts.",category:"light",themeColor:"#212121",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"tranquil-rest",name:"Tranquil Rest",description:"A refined, calm color palette featuring warm cream-beige primary tones paired with deep charcoal secondary accents. The primary scale delivers low-to-moderate saturation with very high brightness, creating soft, peaceful backgrounds that evoke rest and mindfulness. The secondary provides rich, dark contrast through near-black tones that ground the palette. A saturated deep blue accent adds focused pops of color. High brightness-to-darkness contrast creates clear visual hierarchy while maintaining a serene, contemplative mood. Ideal for wellness brands, creative studios, mindfulness spaces, and artisan businesses seeking a calm, sophisticated, sleep-and-rest-inspired aesthetic.",category:"light",themeColor:"#15118B",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"morning-mist",name:"Morning Mist",description:"A soft, high-brightness palette with barely-there lavender-white primaries and muted slate-blue accents. Both scales sit at very low saturation with extreme brightness, producing an airy, misty calm. The accent introduces a medium-saturation cool violet for focused contrast. Ideal for wellness studios, spas, and creative agencies seeking a delicate, dreamlike lightness.",category:"light",themeColor:"#5B4FA0",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"pearl-shimmer",name:"Pearl Shimmer",description:"An iridescent cream palette with very low saturation primaries at near-maximum brightness paired with warm rose-gold accents at moderate saturation. The secondary provides a soft blush warmth that prevents the light base from feeling cold. High brightness across both scales with gentle tonal variance creates a luminous, pearlescent quality. Ideal for jewelry brands, wedding services, and luxury boutiques.",category:"light",themeColor:"#9B5E4A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"honey-dew",name:"Honey Dew",description:"A warm honey-tinted palette with very low saturation in the yellow range at near-maximum brightness, paired with soft olive secondary tones. The primary delivers sunlit warmth without intensity while the secondary grounds with quiet green-gray. A muted gold accent adds gentle focal points. Ideal for organic grocers, honey farms, and daycare centers seeking a warm, approachable lightness.",category:"light",themeColor:"#B8922F",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-graphite",name:"Neutral Graphite",description:"A deep neutral palette inspired by graphite swatches, using layered charcoal tones with cool gray contrast and a soft lilac-gray highlight accent.",category:"dark",themeColor:"#424143",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"modern-grid",name:"Modern Grid",description:"A dark modern palette with steel-blue structure, deep cool-gray surfaces, and a clean turquoise accent for product-forward interfaces.",category:"dark",themeColor:"#2FA39A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"obsidian-ember",name:"Obsidian Ember",description:"A near-black palette with very low brightness primaries and deep crimson accents at high saturation. The primary provides obsidian-dark foundations while the secondary adds warm charcoal tones. The accent introduces smoldering red at moderate-to-high saturation, creating dramatic ember-like focal points against the void. Ideal for premium steakhouses, whiskey brands, and luxury automotive services.",category:"dark",themeColor:"#1A1114",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"midnight-ink",name:"Midnight Ink",description:"A deep navy-black palette with very low brightness and moderate saturation in the cool-blue range, paired with warm gold accents at high saturation and medium brightness. The primary evokes the depth of ink on dark paper while the secondary adds deep blue-gray structure. The gold accent creates luxurious contrast against the dark canvas. Ideal for law firms, financial advisors, publishing houses, and luxury brands seeking authoritative elegance.",category:"dark",themeColor:"#0D1B2A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"deep-burgundy",name:"Deep Burgundy",description:"A richly saturated dark wine palette with moderate-to-high saturation in the red-purple range at low brightness, paired with dusty rose secondary tones. The primary delivers deep velvet darkness with visible chromatic warmth rather than flat black. A warm copper accent adds luxurious metallic highlights. Ideal for wine bars, fine dining, and high-end fashion brands seeking saturated dark elegance.",category:"dark",themeColor:"#2D0A1E",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"deep-ocean",name:"Deep Ocean",description:"A saturated deep-blue palette with high saturation in the blue range at very low brightness, paired with warm amber secondary for striking contrast. The primary evokes abyssal oceanic depth with visible blue chromatic intensity rather than neutral black. A bright teal accent adds bioluminescent focal points. Ideal for dive shops, aquatic brands, and oceanography organizations seeking vivid dark depth.",category:"dark",themeColor:"#091B3A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"classic-persian",name:"Classic Persian",description:"A high-contrast classic palette with a rich golden-amber primary foundation, deep navy-charcoal support tones, and a warm muted neutral range. The primary scale radiates warm saturated gold that anchors the palette with opulent warmth, while the secondary provides grounding darkness. A bold crimson accent introduces a strong chromatic focal point for actions and highlights. Suitable for traditional brands that want a composed but confident visual rhythm.",category:"warm",themeColor:"#D13F31",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"desert-canyon",name:"Desert Canyon",description:"A warm terracotta palette with moderate saturation in the orange-red range at medium brightness, paired with burnt sienna secondary tones. Both scales share warm undertones but differ in lightness, creating depth through tonal warmth rather than hue contrast. A warm gold accent adds sun-baked highlights. Ideal for outdoor adventure brands, southwestern restaurants, and travel agencies.",category:"warm",themeColor:"#D4A03C",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"golden-hour",name:"Golden Hour",description:"A rich amber palette with high saturation in the golden-orange range at medium-high brightness, paired with deep bronze secondary tones at low brightness. The primary radiates warm sunset energy while the secondary provides grounding depth. A burnt orange accent at high saturation bridges the two. Ideal for photography studios, wine bars, and artisan food brands seeking a golden, atmospheric warmth.",category:"warm",themeColor:"#D4782F",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"spiced-saffron",name:"Spiced Saffron",description:"A deep saffron palette with high saturation in the yellow-orange range at medium brightness, paired with cinnamon secondary tones at moderate saturation and low-medium brightness. The primary exudes aromatic richness while the secondary adds spiced depth. A warm ivory accent at very low saturation and high brightness provides breathing room. Ideal for spice shops, Indian restaurants, and artisan tea brands.",category:"warm",themeColor:"#E8A317",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"molten-sunset",name:"Molten Sunset",description:"A deep burnt-umber palette with high saturation in the dark red-brown range at low brightness, used as a bold, moody saturated background. The primary delivers smoldering warmth with rich chocolatey depth. Deep charcoal secondary provides grounding contrast against the dark base. A warm yellow accent adds solar highlights that pop against the deep umber. Ideal for BBQ joints, fire pit bars, and adventure touring brands.",category:"warm",themeColor:"#932700",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"rosewood",name:"Rosewood",description:"A rich, saturated pinkish-red palette with moderate-to-high saturation in the warm rose range at medium brightness, creating a bold rosy background. The primary radiates warm chromatic intensity. Ivory secondary provides soft, breathable contrast. A deep plum accent adds sophisticated depth. Ideal for florists, romantic restaurants, and beauty salons seeking saturated warmth.",category:"warm",themeColor:"#C94C60",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"glacier-blue",name:"Glacier Blue",description:"A deep ice-blue palette with moderate saturation in the blue range at low-medium brightness, paired with steel-gray secondary tones at very low saturation. The primary evokes glacial depth while the secondary provides neutral structure. A frost-white accent at very high brightness creates crisp highlights against the cool base. Ideal for HVAC companies, ski resorts, and cold-storage logistics brands.",category:"cool",themeColor:"#1A6B8A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"moonlit-ocean",name:"Moonlit Ocean",description:"A deep teal palette with moderate-to-high saturation in the blue-green range at low brightness, paired with silver secondary tones at very low saturation and high brightness. The contrast between deep oceanic primaries and luminous silver surfaces creates moonlit reflections. A midnight-blue accent adds depth. Ideal for marine services, aquariums, and coastal hospitality seeking mysterious, nocturnal cool tones.",category:"cool",themeColor:"#0B3D4A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"northern-sky",name:"Northern Sky",description:"A pale sky-blue palette with low saturation in the blue range at very high brightness, paired with cloud-gray secondary tones at minimal saturation. Both scales sit in the high-brightness range, creating an open, expansive feel. A deep teal accent at high saturation and low brightness adds rich, grounded contrast against the airy base. Ideal for airlines, cloud services, and meditation apps seeking serene openness.",category:"cool",themeColor:"#00425A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"frozen-slate",name:"Frozen Slate",description:"A dark blue-gray palette with low-to-moderate saturation in the cool blue range at very low brightness, creating a frozen, overcast atmosphere. The primary delivers icy darkness with subtle blue undertones. A pale ice-blue secondary provides crisp contrast against the dark base. A steel-blue accent adds cold metallic focus. Ideal for winter sports brands, cold brew companies, and Scandinavian furniture studios.",category:"cool",themeColor:"#1A2530",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"abyss-green",name:"Abyss Green",description:"A dark cold-green palette with moderate saturation in the blue-green range at very low brightness, evoking deep underwater chill. The primary delivers dark emerald depth with cool undertones. A silver-white secondary creates stark contrast. A muted cyan accent adds cold oceanic highlights. Ideal for environmental nonprofits, deep-sea documentaries, and premium seafood restaurants.",category:"cool",themeColor:"#0A2A28",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"polar-night",name:"Polar Night",description:"A very dark indigo palette with moderate saturation in the violet-blue range at very low brightness, capturing the deep blue-purple of arctic night skies. The primary delivers inky cool darkness with chromatic depth. A pale lavender secondary creates ethereal contrast. A bright aurora-blue accent adds celestial highlights. Ideal for planetariums, luxury sleep brands, and Nordic travel agencies.",category:"cool",themeColor:"#11132B",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"dusty-rose",name:"Dusty Rose",description:"A refined, warm color palette featuring desaturated dusty-rose primary tones paired with muted sage-green secondary accents. The primary scale delivers low-to-moderate saturation with medium brightness, producing a gentle, romantic warmth without veering into vibrant pinks. The secondary offers cool, desaturated green tones that ground the palette with an organic contrast. High brightness backgrounds with soft, muted solid tones create an understated elegance. Ideal for florists, boutique bakeries, handmade cosmetics, artisan candle makers, and craft studios seeking a soft, feminine yet sophisticated handcrafted aesthetic.",category:"natural",themeColor:"#3A693A",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"forest-floor",name:"Forest Floor",description:"A deep moss-green palette with moderate saturation in the green range at low-medium brightness, paired with bark-brown secondary tones at low saturation and low brightness. The primary captures damp forest depth while the secondary adds woody grounding. A mushroom-cream accent at very low saturation and high brightness creates organic highlights. Ideal for landscapers, organic farms, and eco-lodges seeking rich woodland character.",category:"natural",themeColor:"#3A5F40",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"clay-earth",name:"Clay Earth",description:"A warm clay palette with moderate saturation in the red-orange range at medium brightness, paired with ochre secondary tones at moderate saturation and medium-high brightness. Both scales share earthy undertones at different lightness levels, creating a sun-baked, terracotta warmth. A dried-grass accent at low saturation and medium brightness adds organic texture. Ideal for pottery studios, natural skincare brands, and farm-to-table restaurants.",category:"natural",themeColor:"#A0522D",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"stone-garden",name:"Stone Garden",description:"A soft sage palette with low saturation in the green-gray range at high brightness, paired with warm limestone secondary tones at very low saturation and high brightness. Both scales are gentle and muted, creating a zen-garden tranquility. A river-pebble accent at low saturation and medium brightness adds subtle grounding. Ideal for yoga studios, garden centers, and sustainable fashion brands seeking understated organic elegance.",category:"natural",themeColor:"#5B7A5E",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"peat-moss",name:"Peat Moss",description:"A dark olive-green palette with moderate saturation in the green-brown range at very low brightness, evoking rich forest undergrowth and decomposing leaf litter. The primary delivers deep moss darkness with organic warmth. A warm sand secondary provides earthy contrast. A muted amber accent adds fungal-gold highlights. Ideal for hiking brands, national park services, and mushroom foragers.",category:"natural",themeColor:"#1C2A16",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"volcanic-soil",name:"Volcanic Soil",description:"A dark warm-brown palette with low-to-moderate saturation in the red-brown range at very low brightness, evoking rich volcanic earth and dark mineral soil. The primary delivers deep umber darkness with organic depth. A warm terracotta secondary provides earthy warmth. A burnt sienna accent adds iron-oxide focal points. Ideal for coffee roasters, chocolate makers, and geothermal spas.",category:"natural",themeColor:"#1E140E",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"electric-clash",name:"Electric Clash",description:"A max-intensity electric palette that pairs signal red with saturated cobalt and a vivid lime accent for loud, attention-grabbing interfaces.",category:"electric",themeColor:"#2C1249",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"neon-pulse",name:"Neon Pulse",description:"A max-saturation neon palette with hot magenta primary at very high saturation and medium brightness, paired with electric cyan secondary at very high saturation and medium-high brightness. Both scales push chromatic intensity to the limit against a near-black base. The complementary warm-cool neon pairing creates pulsing visual energy. Ideal for nightclubs, gaming studios, and streetwear brands seeking maximum visual impact.",category:"electric",themeColor:"#FF2D95",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"laser-grid",name:"Laser Grid",description:"A neon green palette with very high saturation in the green range at high brightness, paired with a deep navy-blue primary at moderate saturation and very low brightness. The primary creates a rich midnight-blue canvas that grounds the electric neon greens with cool depth rather than purple darkness. A warm neon yellow-green accent adds scanning-beam highlights. Ideal for VR arcades, cybersecurity firms, and synthwave-inspired brands seeking retrofuturistic intensity.",category:"electric",themeColor:"#16275F",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"plasma-wave",name:"Plasma Wave",description:"An electric violet palette with a bright orchid-purple accent at high saturation and medium-high brightness, paired with hot pink secondary at very high saturation. The accent delivers a vivid, luminous purple that lifts the palette with vibrant energy against the dark primary base. The dual-neon pairing of orchid and hot pink creates surging plasma energy. Ideal for electronic music labels, esports teams, and futuristic beauty brands.",category:"electric",themeColor:"#974CA1",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"acid-mint",name:"Acid Mint",description:"An electric palette with a bright lemon-yellow primary at high brightness and moderate saturation in the yellow range, creating a vivid, energetic warm base. The primary delivers punchy sunshine intensity that pairs with the neon green accent for maximum electric contrast. A dark graphite secondary provides legible contrast. A vivid green accent adds electric punch against the vibrant yellow canvas. Ideal for energy drink brands, fitness apps, and tech startups seeking electric brightness.",category:"electric",themeColor:"#00E676",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"ultra-violet",name:"Ultra Violet",description:"An electric palette with a vivid sky-blue primary at high brightness and moderate saturation in the cyan range, creating a bright, cheerful cool base. The primary delivers a bold, saturated blue lightness that energizes the layout. A deep dark-purple secondary provides dramatic contrast. A hot neon magenta accent adds electric highlights against the vibrant blue canvas. Ideal for music festivals, creative agencies, and beauty brands seeking a light-on-neon aesthetic.",category:"electric",themeColor:"#D946EF",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"vibrant-market",name:"Vibrant Market",description:"A bold, highly saturated color palette featuring deep indigo-navy primary tones paired with vivid hot pink secondary accents. The primary scale provides moderate saturation at low-medium brightness, creating a rich, dramatic dark base. The secondary offers high-saturation warm pink tones that create maximum visual energy and contrast against the cool primary. A warm golden-orange accent adds further vibrancy. This is the most chromatic and energetic scheme in the collection. Ideal for artisan markets, craft fairs, creative collectives, mixed-media artists, and vibrant street-food vendors seeking a bold, festival-inspired, maximalist aesthetic.",category:"playful",themeColor:"#E77493",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"candy-pop",name:"Candy Pop",description:"A bright bubblegum-pink palette with high saturation in the pink range at high brightness, paired with sunshine-yellow secondary at very high saturation and maximum brightness. Both scales are intensely cheerful with warm, sugary energy. A turquoise accent at high saturation and medium brightness adds a cool counterpoint. Ideal for ice cream shops, children's brands, and party supply businesses seeking maximum joyfulness.",category:"playful",themeColor:"#FF69B4",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"tropical-splash",name:"Tropical Splash",description:"A bright tropical palette with a sunny lemon-yellow primary at high brightness and moderate saturation, paired with vivid coral secondary at high saturation for warm-cool tropical contrast. The primary delivers cheerful sunshine energy while the coral and aqua accents create vibrant island warmth. Ideal for smoothie bars, surf shops, and tropical vacation brands seeking vibrant island vibes.",category:"playful",themeColor:"#FF6B6B",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"confetti-burst",name:"Confetti Burst",description:"A bold purple palette with high saturation in the violet range at medium brightness, paired with tangerine secondary at very high saturation and high brightness. The complementary purple-orange pairing creates maximum chromatic contrast. A lime-green accent at high saturation and high brightness adds a third voice of celebration. Ideal for event planners, craft supply stores, and carnival brands seeking bold, multi-hued excitement.",category:"playful",themeColor:"#7C3AED",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"sunshine-pop",name:"Sunshine Pop",description:"A bright sunshine-yellow palette with very high saturation in the yellow range at high brightness, paired with a deep navy secondary for strong readable contrast. A rich crimson accent at moderate-high saturation and low-medium brightness provides a bold, deeply saturated background base. The dark red grounds the playful energy with confident warmth while the yellow and navy add vibrant focal points. Ideal for lemonade stands, kids' toy brands, and summer festival promoters seeking bold, warm playfulness.",category:"playful",themeColor:"#FFE533",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"neon-splash",name:"Neon Splash",description:"A bold playful palette with a rich ocean-blue primary providing cool depth, paired with a vivid neon-lime secondary that delivers maximum chartreuse energy as a punchy counterpoint. The warm-cool contrast between electric green and deep blue creates high-energy visual tension. A vivid hot-pink accent adds playful dynamism. Ideal for smoothie bars, trampoline parks, and skateboard brands seeking maximum visual punch.",category:"playful",themeColor:"#13578A",themeColorCategory:"primary",sectionColorOverrides:{}}],typographyStyles:["default","elegant-serif","ibm-plex-serif-inter","instrument-serif-inter","modern","bricolage-grotesque","playfair-source","nunito","oswald-source","oswald-inter","outfit","space-grotesk","space-grotesk-inter","unbounded-geist","albert-sans","libre-baskerville","fraunces-open-sans","work-sans-rubik","lexend","figtree","crimson-pro","syne-geist","montagu-slab","roboto-serif-dm-sans","literata-noto-sans","raleway-lato","playpen-sans-grandstander","josefin-sans-karla","manrope-lora","bitter-nunito-sans","schibsted-grotesk-noto-serif","sora-barlow","newsreader-plus-jakarta-sans","archivo-alegreya","anybody-frank-ruhl-libre","libre-bodoni-chivo","red-hat-display-source-serif-4","petrona-hanken-grotesk","familjen-grotesk-be-vietnam-pro","funnel-display-onest","rethink-sans-commissioner","gabarito-atkinson-hyperlegible-next","signika-asap","fredoka-quicksand","vollkorn-jost","platypi-maven-pro","plus-jakarta-sans-inter"],iconStyles:["vinyl","material"],defaultTypographyStyleId:"libre-baskerville",defaultIconStyleId:"vinyl",defaultKickerVariantId:"text-kicker"},sections:{header:{"header-basic":{},"header-marketer":{},"header-detached-transparent":{},"header-pill-nav":{}},footer:{"footer-contact-split":{},"footer-detached":{},"footer-info-grid":{},"footer-editorial-split":{},"footer-logo-highlight":{},"footer-logo-nav":{}},banner:{"banner-text-and-image":{},"banner-text-and-background-image":{},"banner-text-only":{},"banner-card-and-background-image":{},"banner-bottom-card":{},"banner-diagonal-grid":{},"banner-double-image-bottom":{},"banner-image-full-split":{},"banner-orbit":{},"banner-bento-grid":{},"banner-grid":{},"banner-full-image":{},"banner-basic":{},"banner-background-corner-image":{},"banner-card":{},"banner-compact-background":{},"banner-double-carousel":{}},feature:{"feature-grid":{},"feature-grid-with-image":{},"feature-bento-grid":{},"feature-carousel":{},"feature-carousel-accordion":{},"feature-expandable-carousel":{},"feature-centered-carousel":{},"feature-card-carousel":{},"feature-progress-accordion":{},"feature-text-stacked":{},"feature-three-card":{},"feature-images-carousel":{},"feature-mini-image-cards":{},"feature-portrait-carousel":{},"feature-icons":{},"feature-menu-grid":{},"feature-menu-list":{},"feature-menu-list-text":{},"feature-sticky-image":{},"feature-video":{}},testimonial:{"testimonial-carousel":{},"testimonial-carousel-card":{},"testimonial-background-cards":{},"testimonial-fullscreen-slider":{},"testimonial-grid":{},"testimonial-double-slider":{},"testimonial-single-carousel":{},"testimonial-centered-carousel":{}},gallery:{"gallery-grid":{},"gallery-bento":{},"gallery-slideshow":{},"gallery-slideshow-labelled":{},"gallery-flat-bento":{},"gallery-carousel":{},"gallery-bento-editorial":{},"gallery-center-stage":{}},pricing:{"pricing-table":{},"pricing-editorial-highlight":{},"pricing-table-2":{},"pricing-table-3":{}},team:{"team-grid":{},"team-editorial-grid":{},"team-grid-columns":{},"team-staggered":{}},cta:{"cta-basic":{},"cta-card":{},"cta-card-2":{},"cta-background-image":{},"cta-editorial-image":{}},contact:{"contact-form-image":{},"contact-form-map":{},"contact-form-links":{},"contact-form-text":{},"contact-editorial-split":{},"contact-form-watermark":{},"contact-image-links":{}},faq:{"faq-accordion":{},"faq-editorial-split":{},"faq-accordion-image":{},"faq-accordion-merged":{},"faq-stretch":{},"faq-card":{}},showcase:{"showcase-bento-cards":{},"showcase-grid":{},"showcase-grid-highlight":{},"showcase-list":{},"showcase-strip-images":{}},text:{"text-basic":{},"text-scroll-reveal":{}},metrics:{"metrics-basic":{},"metrics-editorial-split":{},"metrics-card-grid":{},"metrics-card-highlight":{},"metrics-big-numbers":{},"metrics-numbers":{}},location:{"location-map":{},"location-text-and-map":{},"location-editorial-map":{},"location-business-hours":{},"location-card":{}},embed:{"embed-code":{}},blog:{"blog-feed":{},"blog-featured":{},"blog-list":{}}}},"professional-structure":{id:"professional-structure",name:"Professional Structure",description:"A clean, professional template with muted tones and clear hierarchy, and organized grid layouts. Best for a polished, sophisticated look.",tags:["professional","polished"],isPublished:!0,themeConfig:{colorSchemes:[{id:"figma-blooms",name:"Figma Blooms",description:"The source Professional Structure palette from Figma: deep olive canvas, cream and pale green surfaces, mint dividers, and warm orange CTAs. The restrained greens carry the editorial botanical mood while flower imagery supplies the saturated moments. Ideal for premium florists, event studios, boutiques, and lifestyle brands that need a moody natural presence.",category:"preferred",themeColor:"#E78745",themeColorCategory:"accent",sectionColorOverrides:{"banner-bottom-card":[{id:"1",description:"Cream editorial section with a mint top divider and botanical green text."}],"banner-text-and-image":[{id:"1",description:"Cream editorial section with a mint top divider and botanical green text."}],"team-editorial-grid":[{id:"1",description:"Warm orange featured team section with dark text."}],"metrics-editorial-split":[{id:"1",description:"Cream metrics section with botanical green headings, brown body text, and mint dividers."}],"testimonial-background-cards":[{id:"1",description:"Image-backed testimonial section with white header text and cream testimonial cards."}],"gallery-center-stage":[{id:"1",description:"Dark botanical gallery with a white heading, orange kicker, and green carousel controls."}],"feature-progress-accordion":[{id:"1",description:"Dark botanical services section with orange kickers/numbers, light mint heading text, and brown dividers."}],"faq-editorial-split":[{id:"1",description:"Cream FAQ section with green text, black answers, and mint dividers."}],"pricing-editorial-highlight":[{id:"1",description:"Dark botanical pricing section with a light featured card and warm orange accents."}],"contact-editorial-split":[{id:"1",description:"Dark botanical contact section with orange labels, cream form panel, and mint separators."}],"location-editorial-map":[{id:"1",description:"Dark botanical map section with split white heading text and warm orange kicker."}],"cta-editorial-image":[{id:"1",description:"Image-backed editorial CTA with white text and a dark botanical overlay."}],"footer-editorial-split":[{id:"1",description:"Dark botanical editorial footer with light text, mint dividers, and warm icon accents."}]}},{id:"fresh-studio",name:"Fresh Studio",description:"A fresh, high-brightness botanical palette featuring muted green primary tones, pale cream surfaces, and a warm medium-saturation accent. The palette keeps a natural editorial quality while feeling lighter and more approachable than the darker preferred scheme. Suitable for florists, plant shops, studios, and lifestyle businesses that want organic polish with inviting warmth.",category:"preferred",themeColor:"#E78745",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-cloud",name:"Neutral Cloud",description:"A clean neutral palette inspired by soft grayscale gradients, pairing misty mid-gray structure with bright silver surfaces and charcoal accents. The tones stay balanced and understated while preserving strong readability and hierarchy. Ideal for professional brands that need a minimal, calm, and versatile visual baseline.",category:"light",themeColor:"#404040",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-porcelain",name:"Neutral Porcelain",description:"A light porcelain-inspired neutral palette with airy stone-gray foundations, soft silver surfaces, and balanced graphite accents for calm, minimal layouts.",category:"light",themeColor:"#212121",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"tranquil-rest",name:"Tranquil Rest",description:"A refined, calm color palette featuring warm cream-beige primary tones paired with deep charcoal secondary accents. The primary scale delivers low-to-moderate saturation with very high brightness, creating soft, peaceful backgrounds that evoke rest and mindfulness. The secondary provides rich, dark contrast through near-black tones that ground the palette. A saturated deep blue accent adds focused pops of color. High brightness-to-darkness contrast creates clear visual hierarchy while maintaining a serene, contemplative mood. Ideal for wellness brands, creative studios, mindfulness spaces, and artisan businesses seeking a calm, sophisticated, sleep-and-rest-inspired aesthetic.",category:"light",themeColor:"#15118B",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"morning-mist",name:"Morning Mist",description:"A soft, high-brightness palette with barely-there lavender-white primaries and muted slate-blue accents. Both scales sit at very low saturation with extreme brightness, producing an airy, misty calm. The accent introduces a medium-saturation cool violet for focused contrast. Ideal for wellness studios, spas, and creative agencies seeking a delicate, dreamlike lightness.",category:"light",themeColor:"#5B4FA0",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"pearl-shimmer",name:"Pearl Shimmer",description:"An iridescent cream palette with very low saturation primaries at near-maximum brightness paired with warm rose-gold accents at moderate saturation. The secondary provides a soft blush warmth that prevents the light base from feeling cold. High brightness across both scales with gentle tonal variance creates a luminous, pearlescent quality. Ideal for jewelry brands, wedding services, and luxury boutiques.",category:"light",themeColor:"#9B5E4A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"honey-dew",name:"Honey Dew",description:"A warm honey-tinted palette with very low saturation in the yellow range at near-maximum brightness, paired with soft olive secondary tones. The primary delivers sunlit warmth without intensity while the secondary grounds with quiet green-gray. A muted gold accent adds gentle focal points. Ideal for organic grocers, honey farms, and daycare centers seeking a warm, approachable lightness.",category:"light",themeColor:"#B8922F",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-graphite",name:"Neutral Graphite",description:"A deep neutral palette inspired by graphite swatches, using layered charcoal tones with cool gray contrast and a soft lilac-gray highlight accent.",category:"dark",themeColor:"#424143",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"modern-grid",name:"Modern Grid",description:"A dark modern palette with steel-blue structure, deep cool-gray surfaces, and a clean turquoise accent for product-forward interfaces.",category:"dark",themeColor:"#2FA39A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"obsidian-ember",name:"Obsidian Ember",description:"A near-black palette with very low brightness primaries and deep crimson accents at high saturation. The primary provides obsidian-dark foundations while the secondary adds warm charcoal tones. The accent introduces smoldering red at moderate-to-high saturation, creating dramatic ember-like focal points against the void. Ideal for premium steakhouses, whiskey brands, and luxury automotive services.",category:"dark",themeColor:"#1A1114",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"midnight-ink",name:"Midnight Ink",description:"A deep navy-black palette with very low brightness and moderate saturation in the cool-blue range, paired with warm gold accents at high saturation and medium brightness. The primary evokes the depth of ink on dark paper while the secondary adds deep blue-gray structure. The gold accent creates luxurious contrast against the dark canvas. Ideal for law firms, financial advisors, publishing houses, and luxury brands seeking authoritative elegance.",category:"dark",themeColor:"#0D1B2A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"deep-burgundy",name:"Deep Burgundy",description:"A richly saturated dark wine palette with moderate-to-high saturation in the red-purple range at low brightness, paired with dusty rose secondary tones. The primary delivers deep velvet darkness with visible chromatic warmth rather than flat black. A warm copper accent adds luxurious metallic highlights. Ideal for wine bars, fine dining, and high-end fashion brands seeking saturated dark elegance.",category:"dark",themeColor:"#2D0A1E",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"deep-ocean",name:"Deep Ocean",description:"A saturated deep-blue palette with high saturation in the blue range at very low brightness, paired with warm amber secondary for striking contrast. The primary evokes abyssal oceanic depth with visible blue chromatic intensity rather than neutral black. A bright teal accent adds bioluminescent focal points. Ideal for dive shops, aquatic brands, and oceanography organizations seeking vivid dark depth.",category:"dark",themeColor:"#091B3A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"classic-persian",name:"Classic Persian",description:"A high-contrast classic palette with a rich golden-amber primary foundation, deep navy-charcoal support tones, and a warm muted neutral range. The primary scale radiates warm saturated gold that anchors the palette with opulent warmth, while the secondary provides grounding darkness. A bold crimson accent introduces a strong chromatic focal point for actions and highlights. Suitable for traditional brands that want a composed but confident visual rhythm.",category:"warm",themeColor:"#D13F31",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"desert-canyon",name:"Desert Canyon",description:"A warm terracotta palette with moderate saturation in the orange-red range at medium brightness, paired with burnt sienna secondary tones. Both scales share warm undertones but differ in lightness, creating depth through tonal warmth rather than hue contrast. A warm gold accent adds sun-baked highlights. Ideal for outdoor adventure brands, southwestern restaurants, and travel agencies.",category:"warm",themeColor:"#D4A03C",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"golden-hour",name:"Golden Hour",description:"A rich amber palette with high saturation in the golden-orange range at medium-high brightness, paired with deep bronze secondary tones at low brightness. The primary radiates warm sunset energy while the secondary provides grounding depth. A burnt orange accent at high saturation bridges the two. Ideal for photography studios, wine bars, and artisan food brands seeking a golden, atmospheric warmth.",category:"warm",themeColor:"#D4782F",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"spiced-saffron",name:"Spiced Saffron",description:"A deep saffron palette with high saturation in the yellow-orange range at medium brightness, paired with cinnamon secondary tones at moderate saturation and low-medium brightness. The primary exudes aromatic richness while the secondary adds spiced depth. A warm ivory accent at very low saturation and high brightness provides breathing room. Ideal for spice shops, Indian restaurants, and artisan tea brands.",category:"warm",themeColor:"#E8A317",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"molten-sunset",name:"Molten Sunset",description:"A deep burnt-umber palette with high saturation in the dark red-brown range at low brightness, used as a bold, moody saturated background. The primary delivers smoldering warmth with rich chocolatey depth. Deep charcoal secondary provides grounding contrast against the dark base. A warm yellow accent adds solar highlights that pop against the deep umber. Ideal for BBQ joints, fire pit bars, and adventure touring brands.",category:"warm",themeColor:"#932700",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"rosewood",name:"Rosewood",description:"A rich, saturated pinkish-red palette with moderate-to-high saturation in the warm rose range at medium brightness, creating a bold rosy background. The primary radiates warm chromatic intensity. Ivory secondary provides soft, breathable contrast. A deep plum accent adds sophisticated depth. Ideal for florists, romantic restaurants, and beauty salons seeking saturated warmth.",category:"warm",themeColor:"#C94C60",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"glacier-blue",name:"Glacier Blue",description:"A deep ice-blue palette with moderate saturation in the blue range at low-medium brightness, paired with steel-gray secondary tones at very low saturation. The primary evokes glacial depth while the secondary provides neutral structure. A frost-white accent at very high brightness creates crisp highlights against the cool base. Ideal for HVAC companies, ski resorts, and cold-storage logistics brands.",category:"cool",themeColor:"#1A6B8A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"moonlit-ocean",name:"Moonlit Ocean",description:"A deep teal palette with moderate-to-high saturation in the blue-green range at low brightness, paired with silver secondary tones at very low saturation and high brightness. The contrast between deep oceanic primaries and luminous silver surfaces creates moonlit reflections. A midnight-blue accent adds depth. Ideal for marine services, aquariums, and coastal hospitality seeking mysterious, nocturnal cool tones.",category:"cool",themeColor:"#0B3D4A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"northern-sky",name:"Northern Sky",description:"A pale sky-blue palette with low saturation in the blue range at very high brightness, paired with cloud-gray secondary tones at minimal saturation. Both scales sit in the high-brightness range, creating an open, expansive feel. A deep teal accent at high saturation and low brightness adds rich, grounded contrast against the airy base. Ideal for airlines, cloud services, and meditation apps seeking serene openness.",category:"cool",themeColor:"#00425A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"frozen-slate",name:"Frozen Slate",description:"A dark blue-gray palette with low-to-moderate saturation in the cool blue range at very low brightness, creating a frozen, overcast atmosphere. The primary delivers icy darkness with subtle blue undertones. A pale ice-blue secondary provides crisp contrast against the dark base. A steel-blue accent adds cold metallic focus. Ideal for winter sports brands, cold brew companies, and Scandinavian furniture studios.",category:"cool",themeColor:"#1A2530",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"abyss-green",name:"Abyss Green",description:"A dark cold-green palette with moderate saturation in the blue-green range at very low brightness, evoking deep underwater chill. The primary delivers dark emerald depth with cool undertones. A silver-white secondary creates stark contrast. A muted cyan accent adds cold oceanic highlights. Ideal for environmental nonprofits, deep-sea documentaries, and premium seafood restaurants.",category:"cool",themeColor:"#0A2A28",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"polar-night",name:"Polar Night",description:"A very dark indigo palette with moderate saturation in the violet-blue range at very low brightness, capturing the deep blue-purple of arctic night skies. The primary delivers inky cool darkness with chromatic depth. A pale lavender secondary creates ethereal contrast. A bright aurora-blue accent adds celestial highlights. Ideal for planetariums, luxury sleep brands, and Nordic travel agencies.",category:"cool",themeColor:"#11132B",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"dusty-rose",name:"Dusty Rose",description:"A refined, warm color palette featuring desaturated dusty-rose primary tones paired with muted sage-green secondary accents. The primary scale delivers low-to-moderate saturation with medium brightness, producing a gentle, romantic warmth without veering into vibrant pinks. The secondary offers cool, desaturated green tones that ground the palette with an organic contrast. High brightness backgrounds with soft, muted solid tones create an understated elegance. Ideal for florists, boutique bakeries, handmade cosmetics, artisan candle makers, and craft studios seeking a soft, feminine yet sophisticated handcrafted aesthetic.",category:"natural",themeColor:"#3A693A",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"forest-floor",name:"Forest Floor",description:"A deep moss-green palette with moderate saturation in the green range at low-medium brightness, paired with bark-brown secondary tones at low saturation and low brightness. The primary captures damp forest depth while the secondary adds woody grounding. A mushroom-cream accent at very low saturation and high brightness creates organic highlights. Ideal for landscapers, organic farms, and eco-lodges seeking rich woodland character.",category:"natural",themeColor:"#3A5F40",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"clay-earth",name:"Clay Earth",description:"A warm clay palette with moderate saturation in the red-orange range at medium brightness, paired with ochre secondary tones at moderate saturation and medium-high brightness. Both scales share earthy undertones at different lightness levels, creating a sun-baked, terracotta warmth. A dried-grass accent at low saturation and medium brightness adds organic texture. Ideal for pottery studios, natural skincare brands, and farm-to-table restaurants.",category:"natural",themeColor:"#A0522D",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"stone-garden",name:"Stone Garden",description:"A soft sage palette with low saturation in the green-gray range at high brightness, paired with warm limestone secondary tones at very low saturation and high brightness. Both scales are gentle and muted, creating a zen-garden tranquility. A river-pebble accent at low saturation and medium brightness adds subtle grounding. Ideal for yoga studios, garden centers, and sustainable fashion brands seeking understated organic elegance.",category:"natural",themeColor:"#5B7A5E",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"peat-moss",name:"Peat Moss",description:"A dark olive-green palette with moderate saturation in the green-brown range at very low brightness, evoking rich forest undergrowth and decomposing leaf litter. The primary delivers deep moss darkness with organic warmth. A warm sand secondary provides earthy contrast. A muted amber accent adds fungal-gold highlights. Ideal for hiking brands, national park services, and mushroom foragers.",category:"natural",themeColor:"#1C2A16",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"volcanic-soil",name:"Volcanic Soil",description:"A dark warm-brown palette with low-to-moderate saturation in the red-brown range at very low brightness, evoking rich volcanic earth and dark mineral soil. The primary delivers deep umber darkness with organic depth. A warm terracotta secondary provides earthy warmth. A burnt sienna accent adds iron-oxide focal points. Ideal for coffee roasters, chocolate makers, and geothermal spas.",category:"natural",themeColor:"#1E140E",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"electric-clash",name:"Electric Clash",description:"A max-intensity electric palette that pairs signal red with saturated cobalt and a vivid lime accent for loud, attention-grabbing interfaces.",category:"electric",themeColor:"#2C1249",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"neon-pulse",name:"Neon Pulse",description:"A max-saturation neon palette with hot magenta primary at very high saturation and medium brightness, paired with electric cyan secondary at very high saturation and medium-high brightness. Both scales push chromatic intensity to the limit against a near-black base. The complementary warm-cool neon pairing creates pulsing visual energy. Ideal for nightclubs, gaming studios, and streetwear brands seeking maximum visual impact.",category:"electric",themeColor:"#FF2D95",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"laser-grid",name:"Laser Grid",description:"A neon green palette with very high saturation in the green range at high brightness, paired with a deep navy-blue primary at moderate saturation and very low brightness. The primary creates a rich midnight-blue canvas that grounds the electric neon greens with cool depth rather than purple darkness. A warm neon yellow-green accent adds scanning-beam highlights. Ideal for VR arcades, cybersecurity firms, and synthwave-inspired brands seeking retrofuturistic intensity.",category:"electric",themeColor:"#16275F",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"plasma-wave",name:"Plasma Wave",description:"An electric violet palette with a bright orchid-purple accent at high saturation and medium-high brightness, paired with hot pink secondary at very high saturation. The accent delivers a vivid, luminous purple that lifts the palette with vibrant energy against the dark primary base. The dual-neon pairing of orchid and hot pink creates surging plasma energy. Ideal for electronic music labels, esports teams, and futuristic beauty brands.",category:"electric",themeColor:"#974CA1",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"acid-mint",name:"Acid Mint",description:"An electric palette with a bright lemon-yellow primary at high brightness and moderate saturation in the yellow range, creating a vivid, energetic warm base. The primary delivers punchy sunshine intensity that pairs with the neon green accent for maximum electric contrast. A dark graphite secondary provides legible contrast. A vivid green accent adds electric punch against the vibrant yellow canvas. Ideal for energy drink brands, fitness apps, and tech startups seeking electric brightness.",category:"electric",themeColor:"#00E676",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"ultra-violet",name:"Ultra Violet",description:"An electric palette with a vivid sky-blue primary at high brightness and moderate saturation in the cyan range, creating a bright, cheerful cool base. The primary delivers a bold, saturated blue lightness that energizes the layout. A deep dark-purple secondary provides dramatic contrast. A hot neon magenta accent adds electric highlights against the vibrant blue canvas. Ideal for music festivals, creative agencies, and beauty brands seeking a light-on-neon aesthetic.",category:"electric",themeColor:"#D946EF",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"vibrant-market",name:"Vibrant Market",description:"A bold, highly saturated color palette featuring deep indigo-navy primary tones paired with vivid hot pink secondary accents. The primary scale provides moderate saturation at low-medium brightness, creating a rich, dramatic dark base. The secondary offers high-saturation warm pink tones that create maximum visual energy and contrast against the cool primary. A warm golden-orange accent adds further vibrancy. This is the most chromatic and energetic scheme in the collection. Ideal for artisan markets, craft fairs, creative collectives, mixed-media artists, and vibrant street-food vendors seeking a bold, festival-inspired, maximalist aesthetic.",category:"playful",themeColor:"#E77493",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"candy-pop",name:"Candy Pop",description:"A bright bubblegum-pink palette with high saturation in the pink range at high brightness, paired with sunshine-yellow secondary at very high saturation and maximum brightness. Both scales are intensely cheerful with warm, sugary energy. A turquoise accent at high saturation and medium brightness adds a cool counterpoint. Ideal for ice cream shops, children's brands, and party supply businesses seeking maximum joyfulness.",category:"playful",themeColor:"#FF69B4",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"tropical-splash",name:"Tropical Splash",description:"A bright tropical palette with a sunny lemon-yellow primary at high brightness and moderate saturation, paired with vivid coral secondary at high saturation for warm-cool tropical contrast. The primary delivers cheerful sunshine energy while the coral and aqua accents create vibrant island warmth. Ideal for smoothie bars, surf shops, and tropical vacation brands seeking vibrant island vibes.",category:"playful",themeColor:"#FF6B6B",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"confetti-burst",name:"Confetti Burst",description:"A bold purple palette with high saturation in the violet range at medium brightness, paired with tangerine secondary at very high saturation and high brightness. The complementary purple-orange pairing creates maximum chromatic contrast. A lime-green accent at high saturation and high brightness adds a third voice of celebration. Ideal for event planners, craft supply stores, and carnival brands seeking bold, multi-hued excitement.",category:"playful",themeColor:"#7C3AED",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"sunshine-pop",name:"Sunshine Pop",description:"A bright sunshine-yellow palette with very high saturation in the yellow range at high brightness, paired with a deep navy secondary for strong readable contrast. A rich crimson accent at moderate-high saturation and low-medium brightness provides a bold, deeply saturated background base. The dark red grounds the playful energy with confident warmth while the yellow and navy add vibrant focal points. Ideal for lemonade stands, kids' toy brands, and summer festival promoters seeking bold, warm playfulness.",category:"playful",themeColor:"#FFE533",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"neon-splash",name:"Neon Splash",description:"A bold playful palette with a rich ocean-blue primary providing cool depth, paired with a vivid neon-lime secondary that delivers maximum chartreuse energy as a punchy counterpoint. The warm-cool contrast between electric green and deep blue creates high-energy visual tension. A vivid hot-pink accent adds playful dynamism. Ideal for smoothie bars, trampoline parks, and skateboard brands seeking maximum visual punch.",category:"playful",themeColor:"#13578A",themeColorCategory:"primary",sectionColorOverrides:{}}],typographyStyles:["libre-baskerville","playfair-source","libre-bodoni-chivo","newsreader-plus-jakarta-sans","fraunces-open-sans","elegant-serif","work-sans-rubik","manrope-lora","literata-noto-sans","crimson-pro"],iconStyles:["vinyl","material"],defaultTypographyStyleId:"libre-baskerville",defaultIconStyleId:"vinyl",defaultKickerVariantId:"text-kicker"},sections:{header:{"header-basic":{overrides:{navAlignment:"right",isSticky:!1,showButtons:!0,showSocial:!1}}},banner:{"banner-bottom-card":{overrides:{fillViewport:!0,showButtons:!0}},"banner-text-and-image":{overrides:{imagePositionOptions:{imagePosition:"right",hasImagePadding:!1},fillViewportOptions:{fillViewport:!1},showTopDivider:!1,showButtons:!0}}},feature:{"feature-progress-accordion":{overrides:{showButtons:!0}}},metrics:{"metrics-editorial-split":{}},team:{"team-editorial-grid":{overrides:{showImages:!0,showButtons:!1}}},testimonial:{"testimonial-background-cards":{overrides:{showImages:!1}}},gallery:{"gallery-center-stage":{overrides:{showButtons:!1}}},faq:{"faq-editorial-split":{overrides:{showButtons:!1}}},pricing:{"pricing-editorial-highlight":{overrides:{showItemButtons:!0}}},contact:{"contact-editorial-split":{}},location:{"location-editorial-map":{}},cta:{"cta-editorial-image":{overrides:{showButtons:!0}}},footer:{"footer-editorial-split":{overrides:{showSocial:!0,showLegalLinks:!0}}},showcase:{"showcase-list":{}},text:{"text-basic":{}},embed:{},blog:{"blog-feed":{},"blog-featured":{}}}},"airy-spacious":{id:"airy-spacious",name:"Airy Spacious",description:"Moody minimalist template with generous whitespace. Best for a creative, premium look with quiet drama.",tags:["creative","premium"],isPublished:!0,themeConfig:{colorSchemes:[{id:"dark-contrast",name:"Dark Contrast",description:"A grey, editorial floral palette featuring a near-black background paired with a soft, pale amber-cream accent. The deep, low-brightness base creates a moody, cinematic canvas that lets botanical imagery glow, while the warm cream theme color adds a barely-there, refined highlight on headings and accents. Cool off-white neutrals keep long-form copy legible against the dark surface. Ideal for upscale florists, floral studios, event designers, and premium lifestyle brands seeking a dramatic, gallery-like atmosphere.",category:"preferred",themeColor:"#000000",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"light-contrast",name:"Light Contrast",description:"A light, editorial floral palette featuring a near-white background paired with a soft, dark grey accent. The deep, low-brightness base creates a moody, cinematic canvas that lets botanical imagery glow, while the warm cream theme color adds a barely-there, refined highlight on headings and accents. Cool off-white neutrals keep long-form copy legible against the dark surface. Ideal for upscale florists, floral studios, event designers, and premium lifestyle brands seeking a dramatic, gallery-like atmosphere.",category:"preferred",themeColor:"#171717",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"soft-linen",name:"Soft Linen",description:"A soft, light floral palette featuring warm linen and blush backgrounds paired with a muted terracotta accent. The airy, near-white base feels gentle and romantic, while the earthy terracotta theme color grounds the design with a natural warmth. Warm neutral tones keep the aesthetic organic and inviting. Perfect for boutique florists, wedding designers, and lifestyle brands wanting a delicate, editorial feel.",category:"preferred",themeColor:"#B5764B",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-cloud",name:"Neutral Cloud",description:"A clean neutral palette inspired by soft grayscale gradients, pairing misty mid-gray structure with bright silver surfaces and charcoal accents. The tones stay balanced and understated while preserving strong readability and hierarchy. Ideal for professional brands that need a minimal, calm, and versatile visual baseline.",category:"light",themeColor:"#404040",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-porcelain",name:"Neutral Porcelain",description:"A light porcelain-inspired neutral palette with airy stone-gray foundations, soft silver surfaces, and balanced graphite accents for calm, minimal layouts.",category:"light",themeColor:"#212121",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"tranquil-rest",name:"Tranquil Rest",description:"A refined, calm color palette featuring warm cream-beige primary tones paired with deep charcoal secondary accents. The primary scale delivers low-to-moderate saturation with very high brightness, creating soft, peaceful backgrounds that evoke rest and mindfulness. The secondary provides rich, dark contrast through near-black tones that ground the palette. A saturated deep blue accent adds focused pops of color. High brightness-to-darkness contrast creates clear visual hierarchy while maintaining a serene, contemplative mood. Ideal for wellness brands, creative studios, mindfulness spaces, and artisan businesses seeking a calm, sophisticated, sleep-and-rest-inspired aesthetic.",category:"light",themeColor:"#15118B",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"morning-mist",name:"Morning Mist",description:"A soft, high-brightness palette with barely-there lavender-white primaries and muted slate-blue accents. Both scales sit at very low saturation with extreme brightness, producing an airy, misty calm. The accent introduces a medium-saturation cool violet for focused contrast. Ideal for wellness studios, spas, and creative agencies seeking a delicate, dreamlike lightness.",category:"light",themeColor:"#5B4FA0",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"pearl-shimmer",name:"Pearl Shimmer",description:"An iridescent cream palette with very low saturation primaries at near-maximum brightness paired with warm rose-gold accents at moderate saturation. The secondary provides a soft blush warmth that prevents the light base from feeling cold. High brightness across both scales with gentle tonal variance creates a luminous, pearlescent quality. Ideal for jewelry brands, wedding services, and luxury boutiques.",category:"light",themeColor:"#9B5E4A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"honey-dew",name:"Honey Dew",description:"A warm honey-tinted palette with very low saturation in the yellow range at near-maximum brightness, paired with soft olive secondary tones. The primary delivers sunlit warmth without intensity while the secondary grounds with quiet green-gray. A muted gold accent adds gentle focal points. Ideal for organic grocers, honey farms, and daycare centers seeking a warm, approachable lightness.",category:"light",themeColor:"#B8922F",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-graphite",name:"Neutral Graphite",description:"A deep neutral palette inspired by graphite swatches, using layered charcoal tones with cool gray contrast and a soft lilac-gray highlight accent.",category:"dark",themeColor:"#424143",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"modern-grid",name:"Modern Grid",description:"A dark modern palette with steel-blue structure, deep cool-gray surfaces, and a clean turquoise accent for product-forward interfaces.",category:"dark",themeColor:"#2FA39A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"obsidian-ember",name:"Obsidian Ember",description:"A near-black palette with very low brightness primaries and deep crimson accents at high saturation. The primary provides obsidian-dark foundations while the secondary adds warm charcoal tones. The accent introduces smoldering red at moderate-to-high saturation, creating dramatic ember-like focal points against the void. Ideal for premium steakhouses, whiskey brands, and luxury automotive services.",category:"dark",themeColor:"#1A1114",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"midnight-ink",name:"Midnight Ink",description:"A deep navy-black palette with very low brightness and moderate saturation in the cool-blue range, paired with warm gold accents at high saturation and medium brightness. The primary evokes the depth of ink on dark paper while the secondary adds deep blue-gray structure. The gold accent creates luxurious contrast against the dark canvas. Ideal for law firms, financial advisors, publishing houses, and luxury brands seeking authoritative elegance.",category:"dark",themeColor:"#0D1B2A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"deep-burgundy",name:"Deep Burgundy",description:"A richly saturated dark wine palette with moderate-to-high saturation in the red-purple range at low brightness, paired with dusty rose secondary tones. The primary delivers deep velvet darkness with visible chromatic warmth rather than flat black. A warm copper accent adds luxurious metallic highlights. Ideal for wine bars, fine dining, and high-end fashion brands seeking saturated dark elegance.",category:"dark",themeColor:"#2D0A1E",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"deep-ocean",name:"Deep Ocean",description:"A saturated deep-blue palette with high saturation in the blue range at very low brightness, paired with warm amber secondary for striking contrast. The primary evokes abyssal oceanic depth with visible blue chromatic intensity rather than neutral black. A bright teal accent adds bioluminescent focal points. Ideal for dive shops, aquatic brands, and oceanography organizations seeking vivid dark depth.",category:"dark",themeColor:"#091B3A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"classic-persian",name:"Classic Persian",description:"A high-contrast classic palette with a rich golden-amber primary foundation, deep navy-charcoal support tones, and a warm muted neutral range. The primary scale radiates warm saturated gold that anchors the palette with opulent warmth, while the secondary provides grounding darkness. A bold crimson accent introduces a strong chromatic focal point for actions and highlights. Suitable for traditional brands that want a composed but confident visual rhythm.",category:"warm",themeColor:"#D13F31",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"desert-canyon",name:"Desert Canyon",description:"A warm terracotta palette with moderate saturation in the orange-red range at medium brightness, paired with burnt sienna secondary tones. Both scales share warm undertones but differ in lightness, creating depth through tonal warmth rather than hue contrast. A warm gold accent adds sun-baked highlights. Ideal for outdoor adventure brands, southwestern restaurants, and travel agencies.",category:"warm",themeColor:"#D4A03C",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"golden-hour",name:"Golden Hour",description:"A rich amber palette with high saturation in the golden-orange range at medium-high brightness, paired with deep bronze secondary tones at low brightness. The primary radiates warm sunset energy while the secondary provides grounding depth. A burnt orange accent at high saturation bridges the two. Ideal for photography studios, wine bars, and artisan food brands seeking a golden, atmospheric warmth.",category:"warm",themeColor:"#D4782F",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"spiced-saffron",name:"Spiced Saffron",description:"A deep saffron palette with high saturation in the yellow-orange range at medium brightness, paired with cinnamon secondary tones at moderate saturation and low-medium brightness. The primary exudes aromatic richness while the secondary adds spiced depth. A warm ivory accent at very low saturation and high brightness provides breathing room. Ideal for spice shops, Indian restaurants, and artisan tea brands.",category:"warm",themeColor:"#E8A317",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"molten-sunset",name:"Molten Sunset",description:"A deep burnt-umber palette with high saturation in the dark red-brown range at low brightness, used as a bold, moody saturated background. The primary delivers smoldering warmth with rich chocolatey depth. Deep charcoal secondary provides grounding contrast against the dark base. A warm yellow accent adds solar highlights that pop against the deep umber. Ideal for BBQ joints, fire pit bars, and adventure touring brands.",category:"warm",themeColor:"#932700",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"rosewood",name:"Rosewood",description:"A rich, saturated pinkish-red palette with moderate-to-high saturation in the warm rose range at medium brightness, creating a bold rosy background. The primary radiates warm chromatic intensity. Ivory secondary provides soft, breathable contrast. A deep plum accent adds sophisticated depth. Ideal for florists, romantic restaurants, and beauty salons seeking saturated warmth.",category:"warm",themeColor:"#C94C60",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"glacier-blue",name:"Glacier Blue",description:"A deep ice-blue palette with moderate saturation in the blue range at low-medium brightness, paired with steel-gray secondary tones at very low saturation. The primary evokes glacial depth while the secondary provides neutral structure. A frost-white accent at very high brightness creates crisp highlights against the cool base. Ideal for HVAC companies, ski resorts, and cold-storage logistics brands.",category:"cool",themeColor:"#1A6B8A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"moonlit-ocean",name:"Moonlit Ocean",description:"A deep teal palette with moderate-to-high saturation in the blue-green range at low brightness, paired with silver secondary tones at very low saturation and high brightness. The contrast between deep oceanic primaries and luminous silver surfaces creates moonlit reflections. A midnight-blue accent adds depth. Ideal for marine services, aquariums, and coastal hospitality seeking mysterious, nocturnal cool tones.",category:"cool",themeColor:"#0B3D4A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"northern-sky",name:"Northern Sky",description:"A pale sky-blue palette with low saturation in the blue range at very high brightness, paired with cloud-gray secondary tones at minimal saturation. Both scales sit in the high-brightness range, creating an open, expansive feel. A deep teal accent at high saturation and low brightness adds rich, grounded contrast against the airy base. Ideal for airlines, cloud services, and meditation apps seeking serene openness.",category:"cool",themeColor:"#00425A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"frozen-slate",name:"Frozen Slate",description:"A dark blue-gray palette with low-to-moderate saturation in the cool blue range at very low brightness, creating a frozen, overcast atmosphere. The primary delivers icy darkness with subtle blue undertones. A pale ice-blue secondary provides crisp contrast against the dark base. A steel-blue accent adds cold metallic focus. Ideal for winter sports brands, cold brew companies, and Scandinavian furniture studios.",category:"cool",themeColor:"#1A2530",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"abyss-green",name:"Abyss Green",description:"A dark cold-green palette with moderate saturation in the blue-green range at very low brightness, evoking deep underwater chill. The primary delivers dark emerald depth with cool undertones. A silver-white secondary creates stark contrast. A muted cyan accent adds cold oceanic highlights. Ideal for environmental nonprofits, deep-sea documentaries, and premium seafood restaurants.",category:"cool",themeColor:"#0A2A28",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"polar-night",name:"Polar Night",description:"A very dark indigo palette with moderate saturation in the violet-blue range at very low brightness, capturing the deep blue-purple of arctic night skies. The primary delivers inky cool darkness with chromatic depth. A pale lavender secondary creates ethereal contrast. A bright aurora-blue accent adds celestial highlights. Ideal for planetariums, luxury sleep brands, and Nordic travel agencies.",category:"cool",themeColor:"#11132B",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"dusty-rose",name:"Dusty Rose",description:"A refined, warm color palette featuring desaturated dusty-rose primary tones paired with muted sage-green secondary accents. The primary scale delivers low-to-moderate saturation with medium brightness, producing a gentle, romantic warmth without veering into vibrant pinks. The secondary offers cool, desaturated green tones that ground the palette with an organic contrast. High brightness backgrounds with soft, muted solid tones create an understated elegance. Ideal for florists, boutique bakeries, handmade cosmetics, artisan candle makers, and craft studios seeking a soft, feminine yet sophisticated handcrafted aesthetic.",category:"natural",themeColor:"#3A693A",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"forest-floor",name:"Forest Floor",description:"A deep moss-green palette with moderate saturation in the green range at low-medium brightness, paired with bark-brown secondary tones at low saturation and low brightness. The primary captures damp forest depth while the secondary adds woody grounding. A mushroom-cream accent at very low saturation and high brightness creates organic highlights. Ideal for landscapers, organic farms, and eco-lodges seeking rich woodland character.",category:"natural",themeColor:"#3A5F40",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"clay-earth",name:"Clay Earth",description:"A warm clay palette with moderate saturation in the red-orange range at medium brightness, paired with ochre secondary tones at moderate saturation and medium-high brightness. Both scales share earthy undertones at different lightness levels, creating a sun-baked, terracotta warmth. A dried-grass accent at low saturation and medium brightness adds organic texture. Ideal for pottery studios, natural skincare brands, and farm-to-table restaurants.",category:"natural",themeColor:"#A0522D",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"stone-garden",name:"Stone Garden",description:"A soft sage palette with low saturation in the green-gray range at high brightness, paired with warm limestone secondary tones at very low saturation and high brightness. Both scales are gentle and muted, creating a zen-garden tranquility. A river-pebble accent at low saturation and medium brightness adds subtle grounding. Ideal for yoga studios, garden centers, and sustainable fashion brands seeking understated organic elegance.",category:"natural",themeColor:"#5B7A5E",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"peat-moss",name:"Peat Moss",description:"A dark olive-green palette with moderate saturation in the green-brown range at very low brightness, evoking rich forest undergrowth and decomposing leaf litter. The primary delivers deep moss darkness with organic warmth. A warm sand secondary provides earthy contrast. A muted amber accent adds fungal-gold highlights. Ideal for hiking brands, national park services, and mushroom foragers.",category:"natural",themeColor:"#1C2A16",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"volcanic-soil",name:"Volcanic Soil",description:"A dark warm-brown palette with low-to-moderate saturation in the red-brown range at very low brightness, evoking rich volcanic earth and dark mineral soil. The primary delivers deep umber darkness with organic depth. A warm terracotta secondary provides earthy warmth. A burnt sienna accent adds iron-oxide focal points. Ideal for coffee roasters, chocolate makers, and geothermal spas.",category:"natural",themeColor:"#1E140E",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"electric-clash",name:"Electric Clash",description:"A max-intensity electric palette that pairs signal red with saturated cobalt and a vivid lime accent for loud, attention-grabbing interfaces.",category:"electric",themeColor:"#2C1249",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"neon-pulse",name:"Neon Pulse",description:"A max-saturation neon palette with hot magenta primary at very high saturation and medium brightness, paired with electric cyan secondary at very high saturation and medium-high brightness. Both scales push chromatic intensity to the limit against a near-black base. The complementary warm-cool neon pairing creates pulsing visual energy. Ideal for nightclubs, gaming studios, and streetwear brands seeking maximum visual impact.",category:"electric",themeColor:"#FF2D95",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"laser-grid",name:"Laser Grid",description:"A neon green palette with very high saturation in the green range at high brightness, paired with a deep navy-blue primary at moderate saturation and very low brightness. The primary creates a rich midnight-blue canvas that grounds the electric neon greens with cool depth rather than purple darkness. A warm neon yellow-green accent adds scanning-beam highlights. Ideal for VR arcades, cybersecurity firms, and synthwave-inspired brands seeking retrofuturistic intensity.",category:"electric",themeColor:"#16275F",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"plasma-wave",name:"Plasma Wave",description:"An electric violet palette with a bright orchid-purple accent at high saturation and medium-high brightness, paired with hot pink secondary at very high saturation. The accent delivers a vivid, luminous purple that lifts the palette with vibrant energy against the dark primary base. The dual-neon pairing of orchid and hot pink creates surging plasma energy. Ideal for electronic music labels, esports teams, and futuristic beauty brands.",category:"electric",themeColor:"#974CA1",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"acid-mint",name:"Acid Mint",description:"An electric palette with a bright lemon-yellow primary at high brightness and moderate saturation in the yellow range, creating a vivid, energetic warm base. The primary delivers punchy sunshine intensity that pairs with the neon green accent for maximum electric contrast. A dark graphite secondary provides legible contrast. A vivid green accent adds electric punch against the vibrant yellow canvas. Ideal for energy drink brands, fitness apps, and tech startups seeking electric brightness.",category:"electric",themeColor:"#00E676",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"ultra-violet",name:"Ultra Violet",description:"An electric palette with a vivid sky-blue primary at high brightness and moderate saturation in the cyan range, creating a bright, cheerful cool base. The primary delivers a bold, saturated blue lightness that energizes the layout. A deep dark-purple secondary provides dramatic contrast. A hot neon magenta accent adds electric highlights against the vibrant blue canvas. Ideal for music festivals, creative agencies, and beauty brands seeking a light-on-neon aesthetic.",category:"electric",themeColor:"#D946EF",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"vibrant-market",name:"Vibrant Market",description:"A bold, highly saturated color palette featuring deep indigo-navy primary tones paired with vivid hot pink secondary accents. The primary scale provides moderate saturation at low-medium brightness, creating a rich, dramatic dark base. The secondary offers high-saturation warm pink tones that create maximum visual energy and contrast against the cool primary. A warm golden-orange accent adds further vibrancy. This is the most chromatic and energetic scheme in the collection. Ideal for artisan markets, craft fairs, creative collectives, mixed-media artists, and vibrant street-food vendors seeking a bold, festival-inspired, maximalist aesthetic.",category:"playful",themeColor:"#E77493",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"candy-pop",name:"Candy Pop",description:"A bright bubblegum-pink palette with high saturation in the pink range at high brightness, paired with sunshine-yellow secondary at very high saturation and maximum brightness. Both scales are intensely cheerful with warm, sugary energy. A turquoise accent at high saturation and medium brightness adds a cool counterpoint. Ideal for ice cream shops, children's brands, and party supply businesses seeking maximum joyfulness.",category:"playful",themeColor:"#FF69B4",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"tropical-splash",name:"Tropical Splash",description:"A bright tropical palette with a sunny lemon-yellow primary at high brightness and moderate saturation, paired with vivid coral secondary at high saturation for warm-cool tropical contrast. The primary delivers cheerful sunshine energy while the coral and aqua accents create vibrant island warmth. Ideal for smoothie bars, surf shops, and tropical vacation brands seeking vibrant island vibes.",category:"playful",themeColor:"#FF6B6B",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"confetti-burst",name:"Confetti Burst",description:"A bold purple palette with high saturation in the violet range at medium brightness, paired with tangerine secondary at very high saturation and high brightness. The complementary purple-orange pairing creates maximum chromatic contrast. A lime-green accent at high saturation and high brightness adds a third voice of celebration. Ideal for event planners, craft supply stores, and carnival brands seeking bold, multi-hued excitement.",category:"playful",themeColor:"#7C3AED",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"sunshine-pop",name:"Sunshine Pop",description:"A bright sunshine-yellow palette with very high saturation in the yellow range at high brightness, paired with a deep navy secondary for strong readable contrast. A rich crimson accent at moderate-high saturation and low-medium brightness provides a bold, deeply saturated background base. The dark red grounds the playful energy with confident warmth while the yellow and navy add vibrant focal points. Ideal for lemonade stands, kids' toy brands, and summer festival promoters seeking bold, warm playfulness.",category:"playful",themeColor:"#FFE533",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"neon-splash",name:"Neon Splash",description:"A bold playful palette with a rich ocean-blue primary providing cool depth, paired with a vivid neon-lime secondary that delivers maximum chartreuse energy as a punchy counterpoint. The warm-cool contrast between electric green and deep blue creates high-energy visual tension. A vivid hot-pink accent adds playful dynamism. Ideal for smoothie bars, trampoline parks, and skateboard brands seeking maximum visual punch.",category:"playful",themeColor:"#13578A",themeColorCategory:"primary",sectionColorOverrides:{}}],typographyStyles:["bitter-nunito-sans","elegant-serif","playfair-source","libre-baskerville","fraunces-open-sans","crimson-pro","montagu-slab","roboto-serif-dm-sans","literata-noto-sans","manrope-lora","libre-bodoni-chivo","newsreader-plus-jakarta-sans","vollkorn-jost"],iconStyles:["vinyl","material"],defaultTypographyStyleId:"vollkorn-jost",defaultIconStyleId:"vinyl",defaultKickerVariantId:"text-kicker"},sections:{header:{"header-pill-nav":{}},banner:{"banner-compact-background":{}},text:{"text-scroll-reveal":{}},feature:{"feature-sticky-image":{}},gallery:{"gallery-bento-editorial":{}},testimonial:{"testimonial-centered-carousel":{}},team:{"team-staggered":{}},blog:{"blog-list":{}},contact:{"contact-form-watermark":{}},footer:{"footer-contact-split":{}},cta:{"cta-card":{overrides:{textAlignment:"center"}}},faq:{"faq-accordion":{}},pricing:{"pricing-table-2":{}},showcase:{"showcase-strip-images":{}},metrics:{"metrics-basic":{}},location:{"location-text-and-map":{}},embed:{}}},"vibrant-blooms":{id:"vibrant-blooms",name:"Vibrant Blooms",description:"Fresh organic brightness — lively saturated color, earthy undertones, soft rounded corners, and open layouts with generous padding. Best for an inviting, naturally expressive look.",tags:["playful","organic","bright","fresh"],isPublished:!0,themeConfig:{colorSchemes:[{id:"warm-earthy",name:"Warm Earthy",description:"A warm, earthy color palette featuring deep brown primary tones paired with muted forest green secondary accents. The primary scale offers rich, low-brightness brown solid colors that create a grounded, natural aesthetic. The secondary provides organic green tones that complement the warmth of the primary. High contrast between light backgrounds and dark solid colors establishes clear visual hierarchy. Ideal for florists, garden centers, nurseries, and nature-focused businesses seeking an organic, premium feel.",category:"preferred",themeColor:"#C2703E",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"rich-contrast",name:"Rich Contrast",description:"A soft, elegant color palette featuring warm blush primary tones paired with deep navy secondary accents. The primary blush provides a gentle, sophisticated base while the secondary navy adds depth and contrast. The warm primary creates an inviting, feminine aesthetic while the dark secondary grounds the design with bold accents. Clear brightness contrast between light backgrounds and deep solid colors. Perfect for upscale florists, boutique event planners, and premium lifestyle brands seeking refined elegance.",category:"preferred",themeColor:"#C96A5A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-cloud",name:"Neutral Cloud",description:"A clean neutral palette inspired by soft grayscale gradients, pairing misty mid-gray structure with bright silver surfaces and charcoal accents. The tones stay balanced and understated while preserving strong readability and hierarchy. Ideal for professional brands that need a minimal, calm, and versatile visual baseline.",category:"light",themeColor:"#404040",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-porcelain",name:"Neutral Porcelain",description:"A light porcelain-inspired neutral palette with airy stone-gray foundations, soft silver surfaces, and balanced graphite accents for calm, minimal layouts.",category:"light",themeColor:"#212121",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"tranquil-rest",name:"Tranquil Rest",description:"A refined, calm color palette featuring warm cream-beige primary tones paired with deep charcoal secondary accents. The primary scale delivers low-to-moderate saturation with very high brightness, creating soft, peaceful backgrounds that evoke rest and mindfulness. The secondary provides rich, dark contrast through near-black tones that ground the palette. A saturated deep blue accent adds focused pops of color. High brightness-to-darkness contrast creates clear visual hierarchy while maintaining a serene, contemplative mood. Ideal for wellness brands, creative studios, mindfulness spaces, and artisan businesses seeking a calm, sophisticated, sleep-and-rest-inspired aesthetic.",category:"light",themeColor:"#15118B",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"morning-mist",name:"Morning Mist",description:"A soft, high-brightness palette with barely-there lavender-white primaries and muted slate-blue accents. Both scales sit at very low saturation with extreme brightness, producing an airy, misty calm. The accent introduces a medium-saturation cool violet for focused contrast. Ideal for wellness studios, spas, and creative agencies seeking a delicate, dreamlike lightness.",category:"light",themeColor:"#5B4FA0",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"pearl-shimmer",name:"Pearl Shimmer",description:"An iridescent cream palette with very low saturation primaries at near-maximum brightness paired with warm rose-gold accents at moderate saturation. The secondary provides a soft blush warmth that prevents the light base from feeling cold. High brightness across both scales with gentle tonal variance creates a luminous, pearlescent quality. Ideal for jewelry brands, wedding services, and luxury boutiques.",category:"light",themeColor:"#9B5E4A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"honey-dew",name:"Honey Dew",description:"A warm honey-tinted palette with very low saturation in the yellow range at near-maximum brightness, paired with soft olive secondary tones. The primary delivers sunlit warmth without intensity while the secondary grounds with quiet green-gray. A muted gold accent adds gentle focal points. Ideal for organic grocers, honey farms, and daycare centers seeking a warm, approachable lightness.",category:"light",themeColor:"#B8922F",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-graphite",name:"Neutral Graphite",description:"A deep neutral palette inspired by graphite swatches, using layered charcoal tones with cool gray contrast and a soft lilac-gray highlight accent.",category:"dark",themeColor:"#424143",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"modern-grid",name:"Modern Grid",description:"A dark modern palette with steel-blue structure, deep cool-gray surfaces, and a clean turquoise accent for product-forward interfaces.",category:"dark",themeColor:"#2FA39A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"obsidian-ember",name:"Obsidian Ember",description:"A near-black palette with very low brightness primaries and deep crimson accents at high saturation. The primary provides obsidian-dark foundations while the secondary adds warm charcoal tones. The accent introduces smoldering red at moderate-to-high saturation, creating dramatic ember-like focal points against the void. Ideal for premium steakhouses, whiskey brands, and luxury automotive services.",category:"dark",themeColor:"#1A1114",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"midnight-ink",name:"Midnight Ink",description:"A deep navy-black palette with very low brightness and moderate saturation in the cool-blue range, paired with warm gold accents at high saturation and medium brightness. The primary evokes the depth of ink on dark paper while the secondary adds deep blue-gray structure. The gold accent creates luxurious contrast against the dark canvas. Ideal for law firms, financial advisors, publishing houses, and luxury brands seeking authoritative elegance.",category:"dark",themeColor:"#0D1B2A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"deep-burgundy",name:"Deep Burgundy",description:"A richly saturated dark wine palette with moderate-to-high saturation in the red-purple range at low brightness, paired with dusty rose secondary tones. The primary delivers deep velvet darkness with visible chromatic warmth rather than flat black. A warm copper accent adds luxurious metallic highlights. Ideal for wine bars, fine dining, and high-end fashion brands seeking saturated dark elegance.",category:"dark",themeColor:"#2D0A1E",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"deep-ocean",name:"Deep Ocean",description:"A saturated deep-blue palette with high saturation in the blue range at very low brightness, paired with warm amber secondary for striking contrast. The primary evokes abyssal oceanic depth with visible blue chromatic intensity rather than neutral black. A bright teal accent adds bioluminescent focal points. Ideal for dive shops, aquatic brands, and oceanography organizations seeking vivid dark depth.",category:"dark",themeColor:"#091B3A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"classic-persian",name:"Classic Persian",description:"A high-contrast classic palette with a rich golden-amber primary foundation, deep navy-charcoal support tones, and a warm muted neutral range. The primary scale radiates warm saturated gold that anchors the palette with opulent warmth, while the secondary provides grounding darkness. A bold crimson accent introduces a strong chromatic focal point for actions and highlights. Suitable for traditional brands that want a composed but confident visual rhythm.",category:"warm",themeColor:"#D13F31",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"desert-canyon",name:"Desert Canyon",description:"A warm terracotta palette with moderate saturation in the orange-red range at medium brightness, paired with burnt sienna secondary tones. Both scales share warm undertones but differ in lightness, creating depth through tonal warmth rather than hue contrast. A warm gold accent adds sun-baked highlights. Ideal for outdoor adventure brands, southwestern restaurants, and travel agencies.",category:"warm",themeColor:"#D4A03C",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"golden-hour",name:"Golden Hour",description:"A rich amber palette with high saturation in the golden-orange range at medium-high brightness, paired with deep bronze secondary tones at low brightness. The primary radiates warm sunset energy while the secondary provides grounding depth. A burnt orange accent at high saturation bridges the two. Ideal for photography studios, wine bars, and artisan food brands seeking a golden, atmospheric warmth.",category:"warm",themeColor:"#D4782F",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"spiced-saffron",name:"Spiced Saffron",description:"A deep saffron palette with high saturation in the yellow-orange range at medium brightness, paired with cinnamon secondary tones at moderate saturation and low-medium brightness. The primary exudes aromatic richness while the secondary adds spiced depth. A warm ivory accent at very low saturation and high brightness provides breathing room. Ideal for spice shops, Indian restaurants, and artisan tea brands.",category:"warm",themeColor:"#E8A317",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"molten-sunset",name:"Molten Sunset",description:"A deep burnt-umber palette with high saturation in the dark red-brown range at low brightness, used as a bold, moody saturated background. The primary delivers smoldering warmth with rich chocolatey depth. Deep charcoal secondary provides grounding contrast against the dark base. A warm yellow accent adds solar highlights that pop against the deep umber. Ideal for BBQ joints, fire pit bars, and adventure touring brands.",category:"warm",themeColor:"#932700",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"rosewood",name:"Rosewood",description:"A rich, saturated pinkish-red palette with moderate-to-high saturation in the warm rose range at medium brightness, creating a bold rosy background. The primary radiates warm chromatic intensity. Ivory secondary provides soft, breathable contrast. A deep plum accent adds sophisticated depth. Ideal for florists, romantic restaurants, and beauty salons seeking saturated warmth.",category:"warm",themeColor:"#C94C60",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"glacier-blue",name:"Glacier Blue",description:"A deep ice-blue palette with moderate saturation in the blue range at low-medium brightness, paired with steel-gray secondary tones at very low saturation. The primary evokes glacial depth while the secondary provides neutral structure. A frost-white accent at very high brightness creates crisp highlights against the cool base. Ideal for HVAC companies, ski resorts, and cold-storage logistics brands.",category:"cool",themeColor:"#1A6B8A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"moonlit-ocean",name:"Moonlit Ocean",description:"A deep teal palette with moderate-to-high saturation in the blue-green range at low brightness, paired with silver secondary tones at very low saturation and high brightness. The contrast between deep oceanic primaries and luminous silver surfaces creates moonlit reflections. A midnight-blue accent adds depth. Ideal for marine services, aquariums, and coastal hospitality seeking mysterious, nocturnal cool tones.",category:"cool",themeColor:"#0B3D4A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"northern-sky",name:"Northern Sky",description:"A pale sky-blue palette with low saturation in the blue range at very high brightness, paired with cloud-gray secondary tones at minimal saturation. Both scales sit in the high-brightness range, creating an open, expansive feel. A deep teal accent at high saturation and low brightness adds rich, grounded contrast against the airy base. Ideal for airlines, cloud services, and meditation apps seeking serene openness.",category:"cool",themeColor:"#00425A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"frozen-slate",name:"Frozen Slate",description:"A dark blue-gray palette with low-to-moderate saturation in the cool blue range at very low brightness, creating a frozen, overcast atmosphere. The primary delivers icy darkness with subtle blue undertones. A pale ice-blue secondary provides crisp contrast against the dark base. A steel-blue accent adds cold metallic focus. Ideal for winter sports brands, cold brew companies, and Scandinavian furniture studios.",category:"cool",themeColor:"#1A2530",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"abyss-green",name:"Abyss Green",description:"A dark cold-green palette with moderate saturation in the blue-green range at very low brightness, evoking deep underwater chill. The primary delivers dark emerald depth with cool undertones. A silver-white secondary creates stark contrast. A muted cyan accent adds cold oceanic highlights. Ideal for environmental nonprofits, deep-sea documentaries, and premium seafood restaurants.",category:"cool",themeColor:"#0A2A28",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"polar-night",name:"Polar Night",description:"A very dark indigo palette with moderate saturation in the violet-blue range at very low brightness, capturing the deep blue-purple of arctic night skies. The primary delivers inky cool darkness with chromatic depth. A pale lavender secondary creates ethereal contrast. A bright aurora-blue accent adds celestial highlights. Ideal for planetariums, luxury sleep brands, and Nordic travel agencies.",category:"cool",themeColor:"#11132B",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"dusty-rose",name:"Dusty Rose",description:"A refined, warm color palette featuring desaturated dusty-rose primary tones paired with muted sage-green secondary accents. The primary scale delivers low-to-moderate saturation with medium brightness, producing a gentle, romantic warmth without veering into vibrant pinks. The secondary offers cool, desaturated green tones that ground the palette with an organic contrast. High brightness backgrounds with soft, muted solid tones create an understated elegance. Ideal for florists, boutique bakeries, handmade cosmetics, artisan candle makers, and craft studios seeking a soft, feminine yet sophisticated handcrafted aesthetic.",category:"natural",themeColor:"#3A693A",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"forest-floor",name:"Forest Floor",description:"A deep moss-green palette with moderate saturation in the green range at low-medium brightness, paired with bark-brown secondary tones at low saturation and low brightness. The primary captures damp forest depth while the secondary adds woody grounding. A mushroom-cream accent at very low saturation and high brightness creates organic highlights. Ideal for landscapers, organic farms, and eco-lodges seeking rich woodland character.",category:"natural",themeColor:"#3A5F40",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"clay-earth",name:"Clay Earth",description:"A warm clay palette with moderate saturation in the red-orange range at medium brightness, paired with ochre secondary tones at moderate saturation and medium-high brightness. Both scales share earthy undertones at different lightness levels, creating a sun-baked, terracotta warmth. A dried-grass accent at low saturation and medium brightness adds organic texture. Ideal for pottery studios, natural skincare brands, and farm-to-table restaurants.",category:"natural",themeColor:"#A0522D",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"stone-garden",name:"Stone Garden",description:"A soft sage palette with low saturation in the green-gray range at high brightness, paired with warm limestone secondary tones at very low saturation and high brightness. Both scales are gentle and muted, creating a zen-garden tranquility. A river-pebble accent at low saturation and medium brightness adds subtle grounding. Ideal for yoga studios, garden centers, and sustainable fashion brands seeking understated organic elegance.",category:"natural",themeColor:"#5B7A5E",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"peat-moss",name:"Peat Moss",description:"A dark olive-green palette with moderate saturation in the green-brown range at very low brightness, evoking rich forest undergrowth and decomposing leaf litter. The primary delivers deep moss darkness with organic warmth. A warm sand secondary provides earthy contrast. A muted amber accent adds fungal-gold highlights. Ideal for hiking brands, national park services, and mushroom foragers.",category:"natural",themeColor:"#1C2A16",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"volcanic-soil",name:"Volcanic Soil",description:"A dark warm-brown palette with low-to-moderate saturation in the red-brown range at very low brightness, evoking rich volcanic earth and dark mineral soil. The primary delivers deep umber darkness with organic depth. A warm terracotta secondary provides earthy warmth. A burnt sienna accent adds iron-oxide focal points. Ideal for coffee roasters, chocolate makers, and geothermal spas.",category:"natural",themeColor:"#1E140E",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"electric-clash",name:"Electric Clash",description:"A max-intensity electric palette that pairs signal red with saturated cobalt and a vivid lime accent for loud, attention-grabbing interfaces.",category:"electric",themeColor:"#2C1249",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"neon-pulse",name:"Neon Pulse",description:"A max-saturation neon palette with hot magenta primary at very high saturation and medium brightness, paired with electric cyan secondary at very high saturation and medium-high brightness. Both scales push chromatic intensity to the limit against a near-black base. The complementary warm-cool neon pairing creates pulsing visual energy. Ideal for nightclubs, gaming studios, and streetwear brands seeking maximum visual impact.",category:"electric",themeColor:"#FF2D95",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"laser-grid",name:"Laser Grid",description:"A neon green palette with very high saturation in the green range at high brightness, paired with a deep navy-blue primary at moderate saturation and very low brightness. The primary creates a rich midnight-blue canvas that grounds the electric neon greens with cool depth rather than purple darkness. A warm neon yellow-green accent adds scanning-beam highlights. Ideal for VR arcades, cybersecurity firms, and synthwave-inspired brands seeking retrofuturistic intensity.",category:"electric",themeColor:"#16275F",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"plasma-wave",name:"Plasma Wave",description:"An electric violet palette with a bright orchid-purple accent at high saturation and medium-high brightness, paired with hot pink secondary at very high saturation. The accent delivers a vivid, luminous purple that lifts the palette with vibrant energy against the dark primary base. The dual-neon pairing of orchid and hot pink creates surging plasma energy. Ideal for electronic music labels, esports teams, and futuristic beauty brands.",category:"electric",themeColor:"#974CA1",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"acid-mint",name:"Acid Mint",description:"An electric palette with a bright lemon-yellow primary at high brightness and moderate saturation in the yellow range, creating a vivid, energetic warm base. The primary delivers punchy sunshine intensity that pairs with the neon green accent for maximum electric contrast. A dark graphite secondary provides legible contrast. A vivid green accent adds electric punch against the vibrant yellow canvas. Ideal for energy drink brands, fitness apps, and tech startups seeking electric brightness.",category:"electric",themeColor:"#00E676",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"ultra-violet",name:"Ultra Violet",description:"An electric palette with a vivid sky-blue primary at high brightness and moderate saturation in the cyan range, creating a bright, cheerful cool base. The primary delivers a bold, saturated blue lightness that energizes the layout. A deep dark-purple secondary provides dramatic contrast. A hot neon magenta accent adds electric highlights against the vibrant blue canvas. Ideal for music festivals, creative agencies, and beauty brands seeking a light-on-neon aesthetic.",category:"electric",themeColor:"#D946EF",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"vibrant-market",name:"Vibrant Market",description:"A bold, highly saturated color palette featuring deep indigo-navy primary tones paired with vivid hot pink secondary accents. The primary scale provides moderate saturation at low-medium brightness, creating a rich, dramatic dark base. The secondary offers high-saturation warm pink tones that create maximum visual energy and contrast against the cool primary. A warm golden-orange accent adds further vibrancy. This is the most chromatic and energetic scheme in the collection. Ideal for artisan markets, craft fairs, creative collectives, mixed-media artists, and vibrant street-food vendors seeking a bold, festival-inspired, maximalist aesthetic.",category:"playful",themeColor:"#E77493",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"candy-pop",name:"Candy Pop",description:"A bright bubblegum-pink palette with high saturation in the pink range at high brightness, paired with sunshine-yellow secondary at very high saturation and maximum brightness. Both scales are intensely cheerful with warm, sugary energy. A turquoise accent at high saturation and medium brightness adds a cool counterpoint. Ideal for ice cream shops, children's brands, and party supply businesses seeking maximum joyfulness.",category:"playful",themeColor:"#FF69B4",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"tropical-splash",name:"Tropical Splash",description:"A bright tropical palette with a sunny lemon-yellow primary at high brightness and moderate saturation, paired with vivid coral secondary at high saturation for warm-cool tropical contrast. The primary delivers cheerful sunshine energy while the coral and aqua accents create vibrant island warmth. Ideal for smoothie bars, surf shops, and tropical vacation brands seeking vibrant island vibes.",category:"playful",themeColor:"#FF6B6B",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"confetti-burst",name:"Confetti Burst",description:"A bold purple palette with high saturation in the violet range at medium brightness, paired with tangerine secondary at very high saturation and high brightness. The complementary purple-orange pairing creates maximum chromatic contrast. A lime-green accent at high saturation and high brightness adds a third voice of celebration. Ideal for event planners, craft supply stores, and carnival brands seeking bold, multi-hued excitement.",category:"playful",themeColor:"#7C3AED",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"sunshine-pop",name:"Sunshine Pop",description:"A bright sunshine-yellow palette with very high saturation in the yellow range at high brightness, paired with a deep navy secondary for strong readable contrast. A rich crimson accent at moderate-high saturation and low-medium brightness provides a bold, deeply saturated background base. The dark red grounds the playful energy with confident warmth while the yellow and navy add vibrant focal points. Ideal for lemonade stands, kids' toy brands, and summer festival promoters seeking bold, warm playfulness.",category:"playful",themeColor:"#FFE533",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"neon-splash",name:"Neon Splash",description:"A bold playful palette with a rich ocean-blue primary providing cool depth, paired with a vivid neon-lime secondary that delivers maximum chartreuse energy as a punchy counterpoint. The warm-cool contrast between electric green and deep blue creates high-energy visual tension. A vivid hot-pink accent adds playful dynamism. Ideal for smoothie bars, trampoline parks, and skateboard brands seeking maximum visual punch.",category:"playful",themeColor:"#13578A",themeColorCategory:"primary",sectionColorOverrides:{}}],typographyStyles:["elegant-serif","modern","bricolage-grotesque","playfair-source","nunito","oswald-source","space-grotesk","unbounded-geist","albert-sans","libre-baskerville","fraunces-open-sans","work-sans-rubik","lexend","figtree","crimson-pro","syne-geist","montagu-slab","roboto-serif-dm-sans","literata-noto-sans","manrope-lora","libre-bodoni-chivo","newsreader-plus-jakarta-sans","raleway-lato","petrona-hanken-grotesk","vollkorn-jost"],iconStyles:["vinyl","material"],defaultTypographyStyleId:"elegant-serif",defaultIconStyleId:"vinyl",defaultKickerVariantId:"text-kicker"},sections:{banner:{"banner-text-and-background-image":{},"banner-text-and-image":{}},feature:{"feature-grid":{},"feature-bento-grid":{},"feature-carousel":{},"feature-carousel-accordion":{}},testimonial:{"testimonial-grid":{}},gallery:{"gallery-grid":{}},team:{"team-grid":{}},cta:{"cta-basic":{overrides:{textAlignment:"center"}},"cta-background-image":{overrides:{textAlignment:"center"}}},contact:{"contact-form-text":{},"contact-form-map":{}},faq:{"faq-accordion":{}},pricing:{"pricing-table":{}},showcase:{"showcase-grid":{}},text:{"text-basic":{}},metrics:{"metrics-basic":{}},location:{"location-map":{},"location-text-and-map":{}},header:{"header-basic":{}},embed:{},footer:{"footer-logo-highlight":{}},blog:{"blog-feed":{},"blog-featured":{}}}},"growth-engine":{id:"growth-engine",name:"Growth Engine",description:"High-impact monochrome energy — sharp corners, stark contrast, electric accents, strong sans-serif typography, and generous whitespace. Best for a bold look.",tags:["bold","modern","high-contrast","energetic"],isPublished:!0,themeConfig:{colorSchemes:[{id:"bold-signal",name:"Bold Signal",description:"A bold, high-energy color palette featuring vibrant coral-orange primary tones paired with deep charcoal secondary accents. The primary scale offers saturated, attention-grabbing solid colors that convey creativity and momentum. The secondary provides sophisticated dark tones for contrast and grounding. Strong brightness contrast between vibrant primary and dark secondary creates dynamic visual impact. Ideal for marketing agencies, creative studios, and growth-focused businesses seeking to project energy, innovation, and results-driven confidence.",category:"preferred",themeColor:"#000000",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"strategic-growth",name:"Strategic Growth",description:"A sophisticated, strategic color palette featuring deep purple primary tones paired with electric teal secondary accents. The primary scale offers rich, confident colors that convey expertise and creativity. The secondary provides energetic accent colors that suggest innovation and forward momentum. Balanced saturation creates a polished, premium feel. Perfect for marketing consultancies, brand agencies, and strategic growth partners seeking to project both creativity and business acumen.",category:"preferred",themeColor:"#7C3AED",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"neutral-cloud",name:"Neutral Cloud",description:"A clean neutral palette inspired by soft grayscale gradients, pairing misty mid-gray structure with bright silver surfaces and charcoal accents. The tones stay balanced and understated while preserving strong readability and hierarchy. Ideal for professional brands that need a minimal, calm, and versatile visual baseline.",category:"light",themeColor:"#404040",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-porcelain",name:"Neutral Porcelain",description:"A light porcelain-inspired neutral palette with airy stone-gray foundations, soft silver surfaces, and balanced graphite accents for calm, minimal layouts.",category:"light",themeColor:"#212121",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"tranquil-rest",name:"Tranquil Rest",description:"A refined, calm color palette featuring warm cream-beige primary tones paired with deep charcoal secondary accents. The primary scale delivers low-to-moderate saturation with very high brightness, creating soft, peaceful backgrounds that evoke rest and mindfulness. The secondary provides rich, dark contrast through near-black tones that ground the palette. A saturated deep blue accent adds focused pops of color. High brightness-to-darkness contrast creates clear visual hierarchy while maintaining a serene, contemplative mood. Ideal for wellness brands, creative studios, mindfulness spaces, and artisan businesses seeking a calm, sophisticated, sleep-and-rest-inspired aesthetic.",category:"light",themeColor:"#15118B",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"morning-mist",name:"Morning Mist",description:"A soft, high-brightness palette with barely-there lavender-white primaries and muted slate-blue accents. Both scales sit at very low saturation with extreme brightness, producing an airy, misty calm. The accent introduces a medium-saturation cool violet for focused contrast. Ideal for wellness studios, spas, and creative agencies seeking a delicate, dreamlike lightness.",category:"light",themeColor:"#5B4FA0",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"pearl-shimmer",name:"Pearl Shimmer",description:"An iridescent cream palette with very low saturation primaries at near-maximum brightness paired with warm rose-gold accents at moderate saturation. The secondary provides a soft blush warmth that prevents the light base from feeling cold. High brightness across both scales with gentle tonal variance creates a luminous, pearlescent quality. Ideal for jewelry brands, wedding services, and luxury boutiques.",category:"light",themeColor:"#9B5E4A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"honey-dew",name:"Honey Dew",description:"A warm honey-tinted palette with very low saturation in the yellow range at near-maximum brightness, paired with soft olive secondary tones. The primary delivers sunlit warmth without intensity while the secondary grounds with quiet green-gray. A muted gold accent adds gentle focal points. Ideal for organic grocers, honey farms, and daycare centers seeking a warm, approachable lightness.",category:"light",themeColor:"#B8922F",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-graphite",name:"Neutral Graphite",description:"A deep neutral palette inspired by graphite swatches, using layered charcoal tones with cool gray contrast and a soft lilac-gray highlight accent.",category:"dark",themeColor:"#424143",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"modern-grid",name:"Modern Grid",description:"A dark modern palette with steel-blue structure, deep cool-gray surfaces, and a clean turquoise accent for product-forward interfaces.",category:"dark",themeColor:"#2FA39A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"obsidian-ember",name:"Obsidian Ember",description:"A near-black palette with very low brightness primaries and deep crimson accents at high saturation. The primary provides obsidian-dark foundations while the secondary adds warm charcoal tones. The accent introduces smoldering red at moderate-to-high saturation, creating dramatic ember-like focal points against the void. Ideal for premium steakhouses, whiskey brands, and luxury automotive services.",category:"dark",themeColor:"#1A1114",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"midnight-ink",name:"Midnight Ink",description:"A deep navy-black palette with very low brightness and moderate saturation in the cool-blue range, paired with warm gold accents at high saturation and medium brightness. The primary evokes the depth of ink on dark paper while the secondary adds deep blue-gray structure. The gold accent creates luxurious contrast against the dark canvas. Ideal for law firms, financial advisors, publishing houses, and luxury brands seeking authoritative elegance.",category:"dark",themeColor:"#0D1B2A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"deep-burgundy",name:"Deep Burgundy",description:"A richly saturated dark wine palette with moderate-to-high saturation in the red-purple range at low brightness, paired with dusty rose secondary tones. The primary delivers deep velvet darkness with visible chromatic warmth rather than flat black. A warm copper accent adds luxurious metallic highlights. Ideal for wine bars, fine dining, and high-end fashion brands seeking saturated dark elegance.",category:"dark",themeColor:"#2D0A1E",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"deep-ocean",name:"Deep Ocean",description:"A saturated deep-blue palette with high saturation in the blue range at very low brightness, paired with warm amber secondary for striking contrast. The primary evokes abyssal oceanic depth with visible blue chromatic intensity rather than neutral black. A bright teal accent adds bioluminescent focal points. Ideal for dive shops, aquatic brands, and oceanography organizations seeking vivid dark depth.",category:"dark",themeColor:"#091B3A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"classic-persian",name:"Classic Persian",description:"A high-contrast classic palette with a rich golden-amber primary foundation, deep navy-charcoal support tones, and a warm muted neutral range. The primary scale radiates warm saturated gold that anchors the palette with opulent warmth, while the secondary provides grounding darkness. A bold crimson accent introduces a strong chromatic focal point for actions and highlights. Suitable for traditional brands that want a composed but confident visual rhythm.",category:"warm",themeColor:"#D13F31",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"desert-canyon",name:"Desert Canyon",description:"A warm terracotta palette with moderate saturation in the orange-red range at medium brightness, paired with burnt sienna secondary tones. Both scales share warm undertones but differ in lightness, creating depth through tonal warmth rather than hue contrast. A warm gold accent adds sun-baked highlights. Ideal for outdoor adventure brands, southwestern restaurants, and travel agencies.",category:"warm",themeColor:"#D4A03C",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"golden-hour",name:"Golden Hour",description:"A rich amber palette with high saturation in the golden-orange range at medium-high brightness, paired with deep bronze secondary tones at low brightness. The primary radiates warm sunset energy while the secondary provides grounding depth. A burnt orange accent at high saturation bridges the two. Ideal for photography studios, wine bars, and artisan food brands seeking a golden, atmospheric warmth.",category:"warm",themeColor:"#D4782F",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"spiced-saffron",name:"Spiced Saffron",description:"A deep saffron palette with high saturation in the yellow-orange range at medium brightness, paired with cinnamon secondary tones at moderate saturation and low-medium brightness. The primary exudes aromatic richness while the secondary adds spiced depth. A warm ivory accent at very low saturation and high brightness provides breathing room. Ideal for spice shops, Indian restaurants, and artisan tea brands.",category:"warm",themeColor:"#E8A317",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"molten-sunset",name:"Molten Sunset",description:"A deep burnt-umber palette with high saturation in the dark red-brown range at low brightness, used as a bold, moody saturated background. The primary delivers smoldering warmth with rich chocolatey depth. Deep charcoal secondary provides grounding contrast against the dark base. A warm yellow accent adds solar highlights that pop against the deep umber. Ideal for BBQ joints, fire pit bars, and adventure touring brands.",category:"warm",themeColor:"#932700",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"rosewood",name:"Rosewood",description:"A rich, saturated pinkish-red palette with moderate-to-high saturation in the warm rose range at medium brightness, creating a bold rosy background. The primary radiates warm chromatic intensity. Ivory secondary provides soft, breathable contrast. A deep plum accent adds sophisticated depth. Ideal for florists, romantic restaurants, and beauty salons seeking saturated warmth.",category:"warm",themeColor:"#C94C60",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"glacier-blue",name:"Glacier Blue",description:"A deep ice-blue palette with moderate saturation in the blue range at low-medium brightness, paired with steel-gray secondary tones at very low saturation. The primary evokes glacial depth while the secondary provides neutral structure. A frost-white accent at very high brightness creates crisp highlights against the cool base. Ideal for HVAC companies, ski resorts, and cold-storage logistics brands.",category:"cool",themeColor:"#1A6B8A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"moonlit-ocean",name:"Moonlit Ocean",description:"A deep teal palette with moderate-to-high saturation in the blue-green range at low brightness, paired with silver secondary tones at very low saturation and high brightness. The contrast between deep oceanic primaries and luminous silver surfaces creates moonlit reflections. A midnight-blue accent adds depth. Ideal for marine services, aquariums, and coastal hospitality seeking mysterious, nocturnal cool tones.",category:"cool",themeColor:"#0B3D4A",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"northern-sky",name:"Northern Sky",description:"A pale sky-blue palette with low saturation in the blue range at very high brightness, paired with cloud-gray secondary tones at minimal saturation. Both scales sit in the high-brightness range, creating an open, expansive feel. A deep teal accent at high saturation and low brightness adds rich, grounded contrast against the airy base. Ideal for airlines, cloud services, and meditation apps seeking serene openness.",category:"cool",themeColor:"#00425A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"frozen-slate",name:"Frozen Slate",description:"A dark blue-gray palette with low-to-moderate saturation in the cool blue range at very low brightness, creating a frozen, overcast atmosphere. The primary delivers icy darkness with subtle blue undertones. A pale ice-blue secondary provides crisp contrast against the dark base. A steel-blue accent adds cold metallic focus. Ideal for winter sports brands, cold brew companies, and Scandinavian furniture studios.",category:"cool",themeColor:"#1A2530",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"abyss-green",name:"Abyss Green",description:"A dark cold-green palette with moderate saturation in the blue-green range at very low brightness, evoking deep underwater chill. The primary delivers dark emerald depth with cool undertones. A silver-white secondary creates stark contrast. A muted cyan accent adds cold oceanic highlights. Ideal for environmental nonprofits, deep-sea documentaries, and premium seafood restaurants.",category:"cool",themeColor:"#0A2A28",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"polar-night",name:"Polar Night",description:"A very dark indigo palette with moderate saturation in the violet-blue range at very low brightness, capturing the deep blue-purple of arctic night skies. The primary delivers inky cool darkness with chromatic depth. A pale lavender secondary creates ethereal contrast. A bright aurora-blue accent adds celestial highlights. Ideal for planetariums, luxury sleep brands, and Nordic travel agencies.",category:"cool",themeColor:"#11132B",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"dusty-rose",name:"Dusty Rose",description:"A refined, warm color palette featuring desaturated dusty-rose primary tones paired with muted sage-green secondary accents. The primary scale delivers low-to-moderate saturation with medium brightness, producing a gentle, romantic warmth without veering into vibrant pinks. The secondary offers cool, desaturated green tones that ground the palette with an organic contrast. High brightness backgrounds with soft, muted solid tones create an understated elegance. Ideal for florists, boutique bakeries, handmade cosmetics, artisan candle makers, and craft studios seeking a soft, feminine yet sophisticated handcrafted aesthetic.",category:"natural",themeColor:"#3A693A",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"forest-floor",name:"Forest Floor",description:"A deep moss-green palette with moderate saturation in the green range at low-medium brightness, paired with bark-brown secondary tones at low saturation and low brightness. The primary captures damp forest depth while the secondary adds woody grounding. A mushroom-cream accent at very low saturation and high brightness creates organic highlights. Ideal for landscapers, organic farms, and eco-lodges seeking rich woodland character.",category:"natural",themeColor:"#3A5F40",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"clay-earth",name:"Clay Earth",description:"A warm clay palette with moderate saturation in the red-orange range at medium brightness, paired with ochre secondary tones at moderate saturation and medium-high brightness. Both scales share earthy undertones at different lightness levels, creating a sun-baked, terracotta warmth. A dried-grass accent at low saturation and medium brightness adds organic texture. Ideal for pottery studios, natural skincare brands, and farm-to-table restaurants.",category:"natural",themeColor:"#A0522D",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"stone-garden",name:"Stone Garden",description:"A soft sage palette with low saturation in the green-gray range at high brightness, paired with warm limestone secondary tones at very low saturation and high brightness. Both scales are gentle and muted, creating a zen-garden tranquility. A river-pebble accent at low saturation and medium brightness adds subtle grounding. Ideal for yoga studios, garden centers, and sustainable fashion brands seeking understated organic elegance.",category:"natural",themeColor:"#5B7A5E",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"peat-moss",name:"Peat Moss",description:"A dark olive-green palette with moderate saturation in the green-brown range at very low brightness, evoking rich forest undergrowth and decomposing leaf litter. The primary delivers deep moss darkness with organic warmth. A warm sand secondary provides earthy contrast. A muted amber accent adds fungal-gold highlights. Ideal for hiking brands, national park services, and mushroom foragers.",category:"natural",themeColor:"#1C2A16",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"volcanic-soil",name:"Volcanic Soil",description:"A dark warm-brown palette with low-to-moderate saturation in the red-brown range at very low brightness, evoking rich volcanic earth and dark mineral soil. The primary delivers deep umber darkness with organic depth. A warm terracotta secondary provides earthy warmth. A burnt sienna accent adds iron-oxide focal points. Ideal for coffee roasters, chocolate makers, and geothermal spas.",category:"natural",themeColor:"#1E140E",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"electric-clash",name:"Electric Clash",description:"A max-intensity electric palette that pairs signal red with saturated cobalt and a vivid lime accent for loud, attention-grabbing interfaces.",category:"electric",themeColor:"#2C1249",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"neon-pulse",name:"Neon Pulse",description:"A max-saturation neon palette with hot magenta primary at very high saturation and medium brightness, paired with electric cyan secondary at very high saturation and medium-high brightness. Both scales push chromatic intensity to the limit against a near-black base. The complementary warm-cool neon pairing creates pulsing visual energy. Ideal for nightclubs, gaming studios, and streetwear brands seeking maximum visual impact.",category:"electric",themeColor:"#FF2D95",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"laser-grid",name:"Laser Grid",description:"A neon green palette with very high saturation in the green range at high brightness, paired with a deep navy-blue primary at moderate saturation and very low brightness. The primary creates a rich midnight-blue canvas that grounds the electric neon greens with cool depth rather than purple darkness. A warm neon yellow-green accent adds scanning-beam highlights. Ideal for VR arcades, cybersecurity firms, and synthwave-inspired brands seeking retrofuturistic intensity.",category:"electric",themeColor:"#16275F",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"plasma-wave",name:"Plasma Wave",description:"An electric violet palette with a bright orchid-purple accent at high saturation and medium-high brightness, paired with hot pink secondary at very high saturation. The accent delivers a vivid, luminous purple that lifts the palette with vibrant energy against the dark primary base. The dual-neon pairing of orchid and hot pink creates surging plasma energy. Ideal for electronic music labels, esports teams, and futuristic beauty brands.",category:"electric",themeColor:"#974CA1",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"acid-mint",name:"Acid Mint",description:"An electric palette with a bright lemon-yellow primary at high brightness and moderate saturation in the yellow range, creating a vivid, energetic warm base. The primary delivers punchy sunshine intensity that pairs with the neon green accent for maximum electric contrast. A dark graphite secondary provides legible contrast. A vivid green accent adds electric punch against the vibrant yellow canvas. Ideal for energy drink brands, fitness apps, and tech startups seeking electric brightness.",category:"electric",themeColor:"#00E676",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"ultra-violet",name:"Ultra Violet",description:"An electric palette with a vivid sky-blue primary at high brightness and moderate saturation in the cyan range, creating a bright, cheerful cool base. The primary delivers a bold, saturated blue lightness that energizes the layout. A deep dark-purple secondary provides dramatic contrast. A hot neon magenta accent adds electric highlights against the vibrant blue canvas. Ideal for music festivals, creative agencies, and beauty brands seeking a light-on-neon aesthetic.",category:"electric",themeColor:"#D946EF",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"vibrant-market",name:"Vibrant Market",description:"A bold, highly saturated color palette featuring deep indigo-navy primary tones paired with vivid hot pink secondary accents. The primary scale provides moderate saturation at low-medium brightness, creating a rich, dramatic dark base. The secondary offers high-saturation warm pink tones that create maximum visual energy and contrast against the cool primary. A warm golden-orange accent adds further vibrancy. This is the most chromatic and energetic scheme in the collection. Ideal for artisan markets, craft fairs, creative collectives, mixed-media artists, and vibrant street-food vendors seeking a bold, festival-inspired, maximalist aesthetic.",category:"playful",themeColor:"#E77493",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"candy-pop",name:"Candy Pop",description:"A bright bubblegum-pink palette with high saturation in the pink range at high brightness, paired with sunshine-yellow secondary at very high saturation and maximum brightness. Both scales are intensely cheerful with warm, sugary energy. A turquoise accent at high saturation and medium brightness adds a cool counterpoint. Ideal for ice cream shops, children's brands, and party supply businesses seeking maximum joyfulness.",category:"playful",themeColor:"#FF69B4",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"tropical-splash",name:"Tropical Splash",description:"A bright tropical palette with a sunny lemon-yellow primary at high brightness and moderate saturation, paired with vivid coral secondary at high saturation for warm-cool tropical contrast. The primary delivers cheerful sunshine energy while the coral and aqua accents create vibrant island warmth. Ideal for smoothie bars, surf shops, and tropical vacation brands seeking vibrant island vibes.",category:"playful",themeColor:"#FF6B6B",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"confetti-burst",name:"Confetti Burst",description:"A bold purple palette with high saturation in the violet range at medium brightness, paired with tangerine secondary at very high saturation and high brightness. The complementary purple-orange pairing creates maximum chromatic contrast. A lime-green accent at high saturation and high brightness adds a third voice of celebration. Ideal for event planners, craft supply stores, and carnival brands seeking bold, multi-hued excitement.",category:"playful",themeColor:"#7C3AED",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"sunshine-pop",name:"Sunshine Pop",description:"A bright sunshine-yellow palette with very high saturation in the yellow range at high brightness, paired with a deep navy secondary for strong readable contrast. A rich crimson accent at moderate-high saturation and low-medium brightness provides a bold, deeply saturated background base. The dark red grounds the playful energy with confident warmth while the yellow and navy add vibrant focal points. Ideal for lemonade stands, kids' toy brands, and summer festival promoters seeking bold, warm playfulness.",category:"playful",themeColor:"#FFE533",themeColorCategory:"primary",sectionColorOverrides:{}},{id:"neon-splash",name:"Neon Splash",description:"A bold playful palette with a rich ocean-blue primary providing cool depth, paired with a vivid neon-lime secondary that delivers maximum chartreuse energy as a punchy counterpoint. The warm-cool contrast between electric green and deep blue creates high-energy visual tension. A vivid hot-pink accent adds playful dynamism. Ideal for smoothie bars, trampoline parks, and skateboard brands seeking maximum visual punch.",category:"playful",themeColor:"#13578A",themeColorCategory:"primary",sectionColorOverrides:{}}],typographyStyles:["space-grotesk","modern","bricolage-grotesque","syne-geist","unbounded-geist","oswald-source","albert-sans","work-sans-rubik","lexend","figtree","nunito","elegant-serif","playfair-source","libre-baskerville","fraunces-open-sans","crimson-pro","montagu-slab","sora-barlow","rethink-sans-commissioner","funnel-display-onest","raleway-lato","archivo-alegreya","familjen-grotesk-be-vietnam-pro","josefin-sans-karla","schibsted-grotesk-noto-serif","red-hat-display-source-serif-4"],iconStyles:["material","vinyl"],defaultTypographyStyleId:"elegant-serif",defaultIconStyleId:"material",defaultKickerVariantId:"inline-kicker"},sections:{header:{"header-marketer":{overrides:{navAlignment:"center",showButtons:!0}}},banner:{"banner-double-image-bottom":{}},feature:{"feature-images-carousel":{}},gallery:{"gallery-grid":{}},text:{"text-basic":{overrides:{alignment:"split"}}},showcase:{"showcase-grid":{overrides:{contentAlignment:"split",itemSize:"sm"}}},metrics:{"metrics-big-numbers":{}},testimonial:{"testimonial-grid":{},"testimonial-single-carousel":{}},team:{"team-grid":{overrides:{showImages:!0}}},pricing:{"pricing-table-3":{}},faq:{"faq-stretch":{}},cta:{"cta-card":{overrides:{textAlignment:"center"}}},contact:{"contact-form-links":{overrides:{contentAlignment:"left"}},"contact-form-map":{}},location:{"location-map":{},"location-text-and-map":{}},embed:{},footer:{"footer-info-grid":{overrides:{showSocial:!0,showLegalLinks:!0}}},blog:{"blog-feed":{},"blog-featured":{}}}},"clay-cool":{id:"clay-cool",name:"Clay Cool",description:"Moody artisan minimalism — dark slate canvas, serif and sans-serif mix, muted organic tones, clean grid layout. Best for a sophisticated, understated look.",tags:["moody","creative","minimal"],isPublished:!0,themeConfig:{colorSchemes:[{id:"bold-contrast",name:"Bold Contrast",description:"A refined high-contrast color palette featuring low-brightness, moderately saturated primary surfaces paired with a soft, high-brightness theme color. The primary scale creates a grounded dark canvas while the secondary scale introduces gentle warmth for key actions and accents. Strong dark-to-light contrast creates clear hierarchy with a boutique, handcrafted feel. Ideal for creative studios, artisan shops, pottery businesses, and premium local services seeking a polished but tactile presence.",category:"preferred",themeColor:"#9C7398",themeColorCategory:"secondary",sectionColorOverrides:{}},{id:"neutral-cloud",name:"Neutral Cloud",description:"A clean neutral palette inspired by soft grayscale gradients, pairing misty mid-gray structure with bright silver surfaces and charcoal accents. The tones stay balanced and understated while preserving strong readability and hierarchy. Ideal for professional brands that need a minimal, calm, and versatile visual baseline.",category:"light",themeColor:"#404040",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"neutral-porcelain",name:"Neutral Porcelain",description:"A light porcelain-inspired neutral palette with airy stone-gray foundations, soft silver surfaces, and balanced graphite accents for calm, minimal layouts.",category:"light",themeColor:"#212121",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"tranquil-rest",name:"Tranquil Rest",description:"A refined, calm color palette featuring warm cream-beige primary tones paired with deep charcoal secondary accents. The primary scale delivers low-to-moderate saturation with very high brightness, creating soft, peaceful backgrounds that evoke rest and mindfulness. The secondary provides rich, dark contrast through near-black tones that ground the palette. A saturated deep blue accent adds focused pops of color. High brightness-to-darkness contrast creates clear visual hierarchy while maintaining a serene, contemplative mood. Ideal for wellness brands, creative studios, mindfulness spaces, and artisan businesses seeking a calm, sophisticated, sleep-and-rest-inspired aesthetic.",category:"light",themeColor:"#15118B",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"morning-mist",name:"Morning Mist",description:"A soft, high-brightness palette with barely-there lavender-white primaries and muted slate-blue accents. Both scales sit at very low saturation with extreme brightness, producing an airy, misty calm. The accent introduces a medium-saturation cool violet for focused contrast. Ideal for wellness studios, spas, and creative agencies seeking a delicate, dreamlike lightness.",category:"light",themeColor:"#5B4FA0",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"pearl-shimmer",name:"Pearl Shimmer",description:"An iridescent cream palette with very low saturation primaries at near-maximum brightness paired with warm rose-gold accents at moderate saturation. The secondary provides a soft blush warmth that prevents the light base from feeling cold. High brightness across both scales with gentle tonal variance creates a luminous, pearlescent quality. Ideal for jewelry brands, wedding services, and luxury boutiques.",category:"light",themeColor:"#9B5E4A",themeColorCategory:"accent",sectionColorOverrides:{}},{id:"honey-dew",name:"Honey Dew",description:"A warm honey-tinted palette with very low saturation in the yellow range at near-maximum brightness, paired with soft olive secondary tones. The primary delivers sunlit warmth without intensity while the secondary grounds with quiet green-gray. A muted gold accent adds gentle focal points. Ideal for organi