ading:"See What Our\nCustomers Are Saying",buttons:[{label:"See more testimonials",href:"#",actionType:"section"}],items:[{quote:"Our backyard has never looked so good! The team turned our outdoor area into a lush paradise, and we couldn't be happier!",name:"Sarah Johnson",title:"Small Business Owner",image:{src:"https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&fit=crop",alt:"Sarah Johnson"}},{quote:"The attention to detail and professionalism was outstanding. They transformed our vision into reality beyond our expectations!",name:"Michael Chen",title:"Marketing Director",image:{src:"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop",alt:"Michael Chen"}},{quote:"Exceptional service from start to finish! The results exceeded what we hoped for, and the process was smooth and stress-free.",name:"Emily Rodriguez",title:"Restaurant Owner",image:{src:"https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&h=100&fit=crop",alt:"Emily Rodriguez"}},{quote:"A fantastic experience! The team was knowledgeable, friendly, and delivered top-notch results that truly enhanced our property.",name:"David Lee",title:"Entrepreneur",image:{src:"https://images.unsplash.com/photo-1527980965255-d3b416303d12?w=100&h=100&fit=crop",alt:"David Lee"}}],showButtons:!0},versionedSchema:T7["testimonial-grid"],colorTokensSchema:nO.colorTokensSchema}),SW=T8({id:"testimonial-single-carousel",name:"Testimonial Single Carousel",description:"A single-testimonial slider with arrow controls and slide counter.",type:"testimonial",visualConfigPresets:[{showImages:!0},{showImages:!1}],exampleConfig:{kicker:"00",heading:"Testimonials",items:[{quote:"Working with Ben was an incredible experience! He completely transformed our brand with a sleek, professional logo and a stunning website that truly represents who we are. His attention to detail and creative vision made the process seamless. We've received so many compliments on our new look—highly recommend!",name:"Morghan G.",title:"Small business owner",image:{src:"https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&fit=crop",alt:"Morghan G."}},{quote:"The attention to detail and professionalism was outstanding. They transformed our vision into reality beyond our expectations, delivering exceptional quality at every step of the process.",name:"Michael Chen",title:"Marketing Director",image:{src:"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop",alt:"Michael Chen"}},{quote:"Exceptional service from start to finish! The results exceeded what we hoped for, and the process was smooth and stress-free. Highly recommend their expertise and dedication.",name:"Emily Rodriguez",title:"Restaurant Owner",image:{src:"https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&h=100&fit=crop",alt:"Emily Rodriguez"}},{quote:"A fantastic experience! The team was knowledgeable, friendly, and delivered top-notch results that truly enhanced our property and exceeded all our expectations.",name:"David Lee",title:"Entrepreneur",image:{src:"https://images.unsplash.com/photo-1527980965255-d3b416303d12?w=100&h=100&fit=crop",alt:"David Lee"}},{quote:"Outstanding work and incredible attention to detail. They took the time to understand our needs and delivered results that perfectly matched our vision. Couldn't be happier!",name:"Jennifer Martinez",title:"Business Owner",image:{src:"https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?w=100&h=100&fit=crop",alt:"Jennifer Martinez"}},{quote:"The team went above and beyond to ensure our complete satisfaction. Their creativity and expertise shone through in every aspect of the project.",name:"Robert Kim",title:"Tech Startup Founder",image:{src:"https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&fit=crop",alt:"Robert Kim"}}]},versionedSchema:T7["testimonial-single-carousel"],colorTokensSchema:nD.colorTokensSchema}),SG=T8({id:"text-basic",name:"Basic Text",description:"A text section with a heading and description.",type:"text",visualConfigPresets:[{alignment:"left"},{alignment:"center"},{alignment:"split"}],exampleConfig:{alignment:"left",kicker:"Our work",heading:"Transform Your Outdoor Space with Our Expert Care",description:"We bring years of expertise, a love for nature, and a commitment to quality to every project. Whether it’s a small garden or a full landscape transformation, we ensure exceptional results."},versionedSchema:T7["text-basic"],colorTokensSchema:nM.colorTokensSchema}),S$=T8({id:"text-scroll-reveal",name:"Scroll Reveal Text",description:"A text section with a kicker and a single large paragraph that reveals word-by-word as the visitor scrolls it into view. Ideal for about/mission statements.",type:"text",visualConfigPresets:[{animateOnScroll:!0},{animateOnScroll:!1}],exampleConfig:{description:"Inspired by nature's unrefined beauty, we established a studio that breaks away from traditional floristry. We source the most exquisite, unconventional blooms. Our mission is clear: to bring the wild, poetic essence of nature into modern spaces.",animateOnScroll:!0},versionedSchema:T7["text-scroll-reveal"],colorTokensSchema:nq.colorTokensSchema}),SK=(0,t.createRegistry)()({"header-basic":Sl,"header-marketer":Sg,"header-detached-transparent":Sd,"header-pill-nav":Sp,"footer-contact-split":I4,"footer-detached":I6,"footer-info-grid":I8,"footer-editorial-split":I7,"footer-logo-highlight":I9,"footer-logo-nav":Se,"banner-text-and-image":Im,"banner-text-and-background-image":Ih,"banner-text-only":Ib,"banner-card-and-background-image":Ii,"banner-bottom-card":Io,"banner-diagonal-grid":Is,"banner-double-image-bottom":Il,"banner-image-full-split":Ip,"banner-orbit":Iu,"banner-bento-grid":Ia,"banner-grid":Ig,"banner-full-image":Id,"banner-basic":It,"banner-background-corner-image":Ie,"banner-card":Ir,"banner-compact-background":In,"banner-double-carousel":Ic,"feature-grid":IG,"feature-grid-with-image":I$,"feature-bento-grid":IV,"feature-carousel":IU,"feature-carousel-accordion":IN,"feature-expandable-carousel":IW,"feature-centered-carousel":IH,"feature-card-carousel":IR,"feature-progress-accordion":I1,"feature-text-stacked":I2,"feature-three-card":I3,"feature-images-carousel":IY,"feature-mini-image-cards":IQ,"feature-portrait-carousel":IJ,"feature-icons":IK,"feature-menu-grid":IX,"feature-menu-list":IZ,"feature-menu-list-text":I_,"feature-sticky-image":I0,"testimonial-carousel":Sq,"testimonial-carousel-card":SV,"testimonial-background-cards":SM,"testimonial-fullscreen-slider":SN,"testimonial-grid":SH,"testimonial-double-slider":SU,"testimonial-single-carousel":SW,"testimonial-centered-carousel":SR,"gallery-grid":Sn,"gallery-bento":St,"gallery-slideshow":Ss,"gallery-slideshow-labelled":Sc,"gallery-flat-bento":Si,"gallery-carousel":So,"gallery-bento-editorial":Sa,"gallery-center-stage":Sr,"team-grid":SP,"team-editorial-grid":SD,"team-grid-columns":SE,"team-staggered":SL,"cta-basic":II,"cta-card":IS,"cta-card-2":IB,"pricing-table":SA,"pricing-editorial-highlight":Sx,"pricing-table-2":SC,"pricing-table-3":ST,"cta-background-image":IT,"cta-editorial-image":IF,"contact-form-image":Ij,"contact-form-map":Ik,"contact-form-links":Iv,"contact-form-text":Ix,"contact-editorial-split":Iw,"contact-form-watermark":IA,"contact-image-links":IC,"faq-accordion":ID,"faq-editorial-split":IM,"faq-accordion-image":IP,"faq-accordion-merged":IE,"faq-stretch":Iq,"faq-card":IL,"showcase-bento-cards":SI,"showcase-grid":SS,"showcase-grid-highlight":SB,"showcase-list":SF,"showcase-strip-images":SO,"metrics-basic":Sy,"metrics-editorial-split":Sv,"metrics-card-grid":Sw,"metrics-card-highlight":Sj,"metrics-big-numbers":Sf,"metrics-numbers":Sk,"text-basic":SG,"text-scroll-reveal":S$,"location-map":Sb,"location-text-and-map":Sz,"location-editorial-map":Sm,"location-business-hours":Su,"blog-feed":Iy,"blog-featured":Iz,"blog-list":If,"location-card":Sh,"embed-code":IO,"feature-video":I5});e.s(["sectionIds",0,["