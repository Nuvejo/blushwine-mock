[{showImages:!0},{showImages:!1}],exampleConfig:{kicker:"Meet the Team",heading:"Our Dedicated Professionals",description:"We are proud to introduce our team of dedicated professionals who are committed to delivering excellence in every project. Get to know the people behind our success.",buttons:[{label:"Contact Us",href:"#contact",actionType:"section"}],items:[{name:"Sarah Mitchell",role:"Chief Executive Officer",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1781902429935-1a20bd6f-f8a0-4fb3-9ad7-0da76d098557.png",alt:"Sarah Mitchell in a navy blazer smiling outdoors"},description:"Sarah brings over 20 years of leadership experience and is passionate about driving innovation and growth across our organization."},{name:"David Okonkwo",role:"Head of Customer Success",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1781902439850-409f1737-af45-425d-bea5-2aaefeac7169.png",alt:"David Okonkwo in a navy suit smiling outdoors"},description:"David ensures our customers achieve their goals through dedicated support, training, and building lasting partnerships."},{name:"Marcus Chen",role:"Chief Technology Officer",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1781902569339-02b80870-57b9-42f2-b150-e3775565c60d.png",alt:"Marcus Chen in a navy suit smiling outdoors"},description:"Marcus leads our technology vision with expertise in AI, cloud architecture, and building scalable systems that power our platform."}],showImages:!0,showButtons:!0},versionedSchema:T7["team-editorial-grid"],colorTokensSchema:ni.colorTokensSchema}),SP=T8({id:"team-grid",name:"Team Grid",description:"A grid layout to showcase team members with images, roles, names, and descriptions.",type:"team",visualConfigPresets:[{showImages:!0},{showImages:!1}],exampleConfig:{kicker:"Meet the Team",heading:"The people behind every clean home",description:"Our residential cleaning specialists bring care, consistency, and a personal touch to every visit—so your home always feels fresh and welcoming.",buttons:[{label:"Book a cleaning",href:"#contact",actionType:"section"}],items:[{name:"Elena Brooks",role:"Scheduling Coordinator",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1782133677525-d380f1fa-8e22-497c-b50d-2e5c591228f5.png",alt:"Elena Brooks smiling in the office beside a cleaning schedule board"},description:"Elena keeps our routes running smoothly, matching the right cleaner to every home and making sure appointments stay on time."},{name:"James Whitfield",role:"Owner & Founder",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1782133814160-06633f7f-d298-4675-9daa-b51f88cd6e37.png",alt:"James Whitfield in a branded polo with cleaning equipment visible behind him"},description:"James founded the company to bring reliable, detail-focused residential cleaning to local neighborhoods—and still helps train every new hire."},{name:"Rachel Torres",role:"Lead Residential Cleaner",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1782133674181-45e3f5ef-031c-4db3-ad38-942d45184546.png",alt:"Rachel Torres smiling in front of a branded cleaning service van"},description:"Rachel leads our in-home cleaning crews with a sharp eye for detail, from kitchens and bathrooms to the finishing touches that make a house feel new."},{name:"Sarah Chen",role:"Operations Manager",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1782133981489-efc2fe26-e9a8-45fe-8eed-6ab58e96a806.png",alt:"Sarah Chen in a navy polo beside scheduling boards and cleaning supplies"},description:"Sarah oversees day-to-day operations, quality checks, and customer care so every clean meets our standards from start to finish."}],showImages:!0,showButtons:!0},versionedSchema:T7["team-grid"],colorTokensSchema:nc.colorTokensSchema}),SE=T8({id:"team-grid-columns",name:"Team Grid Columns",description:"A grid layout to showcase 2-4 team members with horizontal layout (text beside photo) for 2 or 4 members, and vertical layout (text below photo) for 3 members. Includes social media links for each member.",type:"team",visualConfigPresets:[{showImages:!0},{showImages:!1}],exampleConfig:{kicker:"Meet the Team",heading:"Advisors for your taxes and investments",description:"Our specialists help individuals plan with confidence—from personal tax strategy to long-term investment guidance tailored to your goals.",items:[{name:"Sarah Smith",role:"Founder & Personal Tax Advisor",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1773723580898-542fe487-c17a-48df-b25c-3cc098b8791b.png",alt:"Sarah Smith in a charcoal blazer in a bright modern office"},description:"Helping individuals navigate personal tax strategy and year-round planning for over 20 years.",socialLinks:[{platform:"linkedin",label:"LinkedIn",url:"https://linkedin.com/in/sarahsmith"},{platform:"twitter",label:"Twitter",url:"https://twitter.com/sarahsmith"}]},{name:"Marcus Olsen",role:"Investment Strategist",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1773721389781-f4093d34-6d5d-4f52-9bfa-1c152749561c.png",alt:"Marcus Olsen in a charcoal suit in a bright office"},description:"Building diversified portfolios and investment plans aligned with each client's risk and timeline.",socialLinks:[{platform:"linkedin",label:"LinkedIn",url:"https://linkedin.com/in/marcusolsen"},{platform:"twitter",label:"Twitter",url:"https://twitter.com/marcusolsen"}]},{name:"Emily Rodriguez",role:"Wealth Planning Advisor",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1773721391106-a600880d-3059-428e-b961-485d042e6a90.png",alt:"Emily Rodriguez in a charcoal blazer by a bookshelf"},description:"Connecting tax decisions with retirement, savings, and long-term wealth planning.",socialLinks:[{platform:"linkedin",label:"LinkedIn",url:"https://linkedin.com/in/emilyrodriguez"},{platform:"instagram",label:"Instagram",url:"https://instagram.com/emilyrodriguez"}]},{name:"Alice Johnson",role:"Tax Specialist",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1773721434641-1278c58e-4fd7-415e-97f3-2ca9e168a74b.png",alt:"Alice Johnson in a navy blazer in an office study"},description:"Preparing accurate personal returns and uncovering opportunities to reduce tax liability.",socialLinks:[{platform:"linkedin",label:"LinkedIn",url:"https://linkedin.com/in/alicejohnson"},{platform:"twitter",label:"Twitter",url:"https://twitter.com/alicejohnson"}]}],showImages:!0},versionedSchema:T7["team-grid-columns"],colorTokensSchema:ng.colorTokensSchema}),SL=T8({id:"team-staggered",name:"Staggered Team Grid",description:"An editorial team section with a two-line headline, a short intro, and member cards (photo, name, role) laid out in two columns where the right column is offset for a staggered rhythm.",type:"team",visualConfigPresets:[{staggered:!0},{staggered:!1}],exampleConfig:{heading:"Meet\nthe guides",description:"Meet our dedicated team, ready to lead you through every trail. We're here to help you explore with confidence and create unforgettable outdoor experiences.",items:[{image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1783575136941-693e4d37-b25b-401f-84c9-823402c68db3.png",alt:"Clara Wong smiling on a wildflower trail"},name:"Clara Wong",role:"Founder & Lead Guide"},{image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1783575121393-f0d39c88-adc7-4458-bef3-75b9692490e8.png",alt:"Daniel Reyes pausing for water on a mountain hike"},name:"Daniel Reyes",role:"Senior Trail Guide"},{image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1783575251893-a854eeef-d3f6-4af6-bf9a-c1ece2971e12.png",alt:"Maya Patel smiling on a mountain trail"},name:"Maya Patel",role:"Outdoor Experience Lead"}],staggered:!0},versionedSchema:T7["team-staggered"],colorTokensSchema:nb.colorTokensSchema}),SM=T8({id:"testimonial-background-cards",name:"Testimonial Background Cards",description:"A testimonial section with a background image, split heading, and paged testimonial cards.",type:"testimonial",visualConfigPresets:[{showImages:!1},{showImages:!0}],exampleConfig:{kicker:"What clients say",heading:"In Full Bloom.",description:"Every arrangement tells a story. Our florists handcraft seasonal bouquets sourced from sustainable farms worldwide delivering nature's finest to your door, same day.",backgroundImage:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1783382466166-1ea307cc-071e-40c7-bf04-994780d20650.png",alt:"Bright blue sky with scattered white clouds"},items:[{quote:"Aesthetic Blooms transformed our dinner into something cinematic. Every stem felt intentional.",name:"Sarah Mitchell",title:"Founder of Mitchell Creative Studio",image:{src:"https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200&q=80",alt:"Sarah Mitchell"}},{quote:"The arrangements were unexpected, elegant, and completely aligned with our event mood.",name:"Leah Carter",title:"Private Events Director",image:{src:"https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?w=200&q=80",alt:"Leah Carter"}},{quote:"The studio brought a poetic floral language to the room and made everything feel alive.",name:"Mara Wilson",title:"Hospitality Creative Lead",image:{src:"https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=200&q=80",alt:"Mara Wilson"}}],showImages:!1},versionedSchema:T7["testimonial-background-cards"],colorTokensSchema:nA.colorTokensSchema}),Sq=T8({id:"testimonial-carousel",name:"Testimonial Carousel",description:"A horizontal carousel layout to showcase customer testimonials with quotes and navigation controls.",type:"testimonial",visualConfigPresets:[{showDotsOnDesktop:!1,showImages:!0},{showDotsOnDesktop:!0,showImages:!0},{showDotsOnDesktop:!1,showImages:!1}],exampleConfig:{kicker:"Testimonials",heading:"See What Our\nCustomers Are Saying",buttons:[{label:"See more testimonials",href:"#testimonials",actionType:"section"}],items:[{quote:"We are absolutely thrilled with our backyard! The crew worked wonders, transforming our outdoor area into a vibrant oasis that we adore. They meticulously designed every corner, adding lush greenery and colorful flowers.",name:"Sarah Mitchell",title:"Co-founder, Homeowner",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1781902433432-bfa33418-5aa1-43bf-99ad-80542b23d4ec.png",alt:"Sarah Mitchell in a navy blazer in a modern office"}},{quote:"The attention to detail and professionalism was outstanding. They transformed our vision into reality beyond our expectations, delivering exceptional quality at every step of the process.",name:"Marcus Chen",title:"Marketing Director",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1782745862200-4400e536-d698-44f6-b275-92742d656f57.png",alt:"Marcus Chen smiling outdoors by the coast"}},{quote:"Exceptional service from start to finish! The results exceeded what we hoped for, and the process was smooth and stress-free. Highly recommend their expertise and dedication.",name:"Emily Rodriguez",title:"Restaurant Owner",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1773721391106-a600880d-3059-428e-b961-485d042e6a90.png",alt:"Emily Rodriguez in a charcoal blazer by a bookshelf"}},{quote:"A fantastic experience! The team was knowledgeable, friendly, and delivered top-notch results that truly enhanced our property and exceeded all our expectations.",name:"David Okonkwo",title:"Entrepreneur",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1781902439850-409f1737-af45-425d-bea5-2aaefeac7169.png",alt:"David Okonkwo in a navy suit smiling outdoors"}},{quote:"Outstanding work and incredible attention to detail. They took the time to understand our needs and delivered results that perfectly matched our vision. Couldn't be happier!",name:"Priya Patel",title:"Business Owner",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1773723586143-36f0ec0f-9d79-419c-8ce2-4a11700f03ff.png",alt:"Priya Patel in a navy blazer in an office"}}],showDotsOnDesktop:!1,showButtons:!0},versionedSchema:T7["testimonial-carousel"],colorTokensSchema:nC.colorTokensSchema}),SV=T8({id:"testimonial-carousel-card",name:"Testimonial Carousel Card",description:"A responsive testimonial carousel with card layout, kicker, and heading.",type:"testimonial",visualConfigPresets:[{showImages:!0},{showImages:!1}],exampleConfig:{kicker:"Testimonials",heading:"Hear from Those\nWho Practice with Us",items:[{quote:"Joining this studio completely changed how I start my mornings. The classes are calm, structured, and welcoming — I’ve learned to move with intention and breathe with awareness, finding a steady rhythm in my daily routine.",name:"Olivia Brooks",title:"Pilates Member",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1773684567009-hudo55.jpeg",alt:"Olivia Brooks meditating on a yoga mat in a warm studio"}},{quote:"Practicing here has transformed the way I approach my wellness. Every session feels supportive, mindful, and grounding — helping me reconnect with my body, focus my breath, and move through each day with a calmer sense of presence.",name:"Sarah Lin",title:"Yoga Practitioner",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1773686346118-fygh3y.jpeg",alt:"Sarah Lin smiling outdoors in warm golden light"}},{quote:"This studio has become my second home. The instructors guide you with such care and expertise, helping me to grow consistent habits that I carry into my everyday life. It is truly a transformative experience.",name:"Marcus Reed",title:"Meditation Student",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1773686727066-i8qr2b.png",alt:"Marcus Reed smiling in a warm studio setting"}},{quote:"I found a sense of peace here that I couldn't find anywhere else. The environment is perfectly curated to help you let go of the outside world and focus entirely on your inner self.",name:"James Ortega",title:"Member since 2021",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1773685137686-rizadh.png",alt:"James Ortega practicing a seated twist with instructor guidance"}}]},versionedSchema:T7["testimonial-carousel-card"],colorTokensSchema:nT.colorTokensSchema}),SR=T8({id:"testimonial-centered-carousel",name:"Centered Testimonial Carousel",description:"A minimal, centered testimonial carousel with a two-line headline, one large quote at a time, attribution, and centered controls (previous/next arrows, dots, and a counter). Ideal for elegant, editorial social proof.",type:"testimonial",visualConfigPresets:[{}],exampleConfig:{heading:"Kind\nWords",items:[{quote:"Wilde Flower Studio transformed our venue into something out of a dream. Every arrangement was deeply personal and breathtakingly beautiful.",name:"Amanda & James",title:"Wedding, May 2025"},{quote:"They understood our brand instantly and brought it to life with florals that felt wild, intentional, and unforgettable.",name:"Lena Marsh",title:"Brand Activation, March 2025"},{quote:"From the first consultation to the final stem, the team was thoughtful, calm, and endlessly creative. We couldn't have asked for more.",name:"Priya & Sam",title:"Private Event, August 2025"},{quote:"Every space they touch becomes more alive. Our office reception has never felt so welcoming.",name:"Northbank Studio",title:"Corporate Subscription"}]},versionedSchema:T7["testimonial-centered-carousel"],colorTokensSchema:nI.colorTokensSchema}),SU=T8({id:"testimonial-double-slider",name:"Testimonial Double Slider",description:"An auto-scrolling testimonial section with vertical columns on desktop and horizontal scrolling on mobile.",type:"testimonial",visualConfigPresets:[{showImages:!0,showButtons:!0},{showImages:!1,showButtons:!0}],exampleConfig:{kicker:"Testimonials",heading:"See What Our\nCustomers Are Saying",description:"Join thousands of satisfied customers who have transformed their businesses with our solutions.",buttons:[{label:"See more testimonials",href:"#testimonials",actionType:"section"}],items:[{quote:"We are absolutely thrilled with our backyard! The crew worked wonders, transforming our outdoor area into a vibrant oasis that we adore. They meticulously designed every corner, adding lush greenery and colorful flowers.",name:"Sarah Mitchell",title:"Co-founder, Homeowner",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1781902433432-bfa33418-5aa1-43bf-99ad-80542b23d4ec.png",alt:"Sarah Mitchell in a navy blazer in a modern office"}},{quote:"The attention to detail and professionalism was outstanding. They transformed our vision into reality beyond our expectations, delivering exceptional quality at every step of the process.",name:"Marcus Chen",title:"Marketing Director",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1782745862200-4400e536-d698-44f6-b275-92742d656f57.png",alt:"Marcus Chen smiling outdoors by the coast"}},{quote:"Exceptional service from start to finish! The results exceeded what we hoped for, and the process was smooth and stress-free. Highly recommend their expertise and dedication.",name:"Emily Rodriguez",title:"Restaurant Owner",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1773721391106-a600880d-3059-428e-b961-485d042e6a90.png",alt:"Emily Rodriguez in a charcoal blazer by a bookshelf"}},{quote:"A fantastic experience! The team was knowledgeable, friendly, and delivered top-notch results that truly enhanced our property and exceeded all our expectations.",name:"David Okonkwo",title:"Entrepreneur",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1781902439850-409f1737-af45-425d-bea5-2aaefeac7169.png",alt:"David Okonkwo in a navy suit smiling outdoors"}},{quote:"Outstanding work and incredible attention to detail. They took the time to understand our needs and delivered results that perfectly matched our vision. Couldn't be happier!",name:"Priya Patel",title:"Business Owner",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/generated/1773723586143-36f0ec0f-9d79-419c-8ce2-4a11700f03ff.png",alt:"Priya Patel in a navy blazer in an office"}},{quote:"Professional, efficient, and creative. They brought fresh ideas to the table and executed them flawlessly. The final result speaks for itself!",name:"James Thompson",title:"CEO, Tech Startup",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1773686726490-l8mekw.png",alt:"James Thompson in an orange shirt smiling warmly"}}],scrollSpeed:"medium",showButtons:!0},versionedSchema:T7["testimonial-double-slider"],colorTokensSchema:nS.colorTokensSchema}),SN=T8({id:"testimonial-fullscreen-slider",name:"Testimonial Fullscreen Slide