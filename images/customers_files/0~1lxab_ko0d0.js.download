y:"natural",description:"A deep moss-green palette with moderate saturation in the green range at low-medium brightness, paired with bark-brown secondary tones at low saturation and low brightness. The primary captures damp forest depth while the secondary adds woody grounding. A mushroom-cream accent at very low saturation and high brightness creates organic highlights. Ideal for landscapers, organic farms, and eco-lodges seeking rich woodland character.",colorPalette:{primary:{colorSet:_("#F0EBE0"),isDynamic:!0},secondary:{colorSet:_("#3A5F40"),isThemeColor:!0},accent:{colorSet:_("#5C3D2E"),isDynamic:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.olive,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"secondary",scale:"solid"},foregroundColor:{tint:"white",contrast:7}},secondary:{backgroundColor:{category:"primary",scale:"interactive-bg-3"}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"interactive-bg"},featured:{category:"secondary",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"clay-earth":eV({id:"clay-earth",name:"Clay Earth",category:"natural",description:"A warm clay palette with moderate saturation in the red-orange range at medium brightness, paired with ochre secondary tones at moderate saturation and medium-high brightness. Both scales share earthy undertones at different lightness levels, creating a sun-baked, terracotta warmth. A dried-grass accent at low saturation and medium brightness adds organic texture. Ideal for pottery studios, natural skincare brands, and farm-to-table restaurants.",colorPalette:{primary:{colorSet:_("#F5E6D3"),isDynamic:!0},secondary:{colorSet:_("#A0522D"),isThemeColor:!0},accent:{colorSet:_("#8B7D3C"),isDynamic:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.sand,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"secondary",scale:"solid"},foregroundColor:{tint:"white",contrast:7}},secondary:{backgroundColor:{category:"primary",scale:"interactive-bg-3"}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"canvas-bg"},featured:{category:"secondary",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"stone-garden":eV({id:"stone-garden",name:"Stone Garden",category:"natural",description:"A soft sage palette with low saturation in the green-gray range at high brightness, paired with warm limestone secondary tones at very low saturation and high brightness. Both scales are gentle and muted, creating a zen-garden tranquility. A river-pebble accent at low saturation and medium brightness adds subtle grounding. Ideal for yoga studios, garden centers, and sustainable fashion brands seeking understated organic elegance.",colorPalette:{primary:{colorSet:_("#E8ECE4"),isDynamic:!0},secondary:{colorSet:_("#C8BFA8"),isDynamic:!0},accent:{colorSet:_("#5B7A5E"),isThemeColor:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.sage,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"white",contrast:7}},secondary:{backgroundColor:{category:"secondary",scale:"interactive-bg-2"}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"canvas-bg-2"},featured:{category:"accent",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"peat-moss":eV({id:"peat-moss",name:"Peat Moss",category:"natural",description:"A dark olive-green palette with moderate saturation in the green-brown range at very low brightness, evoking rich forest undergrowth and decomposing leaf litter. The primary delivers deep moss darkness with organic warmth. A warm sand secondary provides earthy contrast. A muted amber accent adds fungal-gold highlights. Ideal for hiking brands, national park services, and mushroom foragers.",colorPalette:{primary:{colorSet:_("#1C2A16"),isThemeColor:!0},secondary:{colorSet:_("#DDD2B8"),isDynamic:!0},accent:{colorSet:_("#A8842A"),isDynamic:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.olive,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"black",contrast:10}},secondary:{backgroundColor:{category:"secondary",scale:"interactive-bg-2"}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"interactive-bg",isInverted:!0},featured:{category:"accent",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"volcanic-soil":eV({id:"volcanic-soil",name:"Volcanic Soil",category:"natural",description:"A dark warm-brown palette with low-to-moderate saturation in the red-brown range at very low brightness, evoking rich volcanic earth and dark mineral soil. The primary delivers deep umber darkness with organic depth. A warm terracotta secondary provides earthy warmth. A burnt sienna accent adds iron-oxide focal points. Ideal for coffee roasters, chocolate makers, and geothermal spas.",colorPalette:{primary:{colorSet:_("#1E140E"),isThemeColor:!0},secondary:{colorSet:_("#D4A574"),isDynamic:!0},accent:{colorSet:_("#A0522D"),isDynamic:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.sand,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"secondary",scale:"solid"},foregroundColor:{tint:"black",contrast:10}},secondary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"white",contrast:7}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"interactive-bg",isInverted:!0},featured:{category:"secondary",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"electric-clash":eK,"neon-pulse":eV({id:"neon-pulse",name:"Neon Pulse",category:"electric",description:"A max-saturation neon palette with hot magenta primary at very high saturation and medium brightness, paired with electric cyan secondary at very high saturation and medium-high brightness. Both scales push chromatic intensity to the limit against a near-black base. The complementary warm-cool neon pairing creates pulsing visual energy. Ideal for nightclubs, gaming studios, and streetwear brands seeking maximum visual impact.",colorPalette:{primary:{colorSet:_("#0F0F12"),isDynamic:!0},secondary:{colorSet:_("#00E5FF"),isDynamic:!0},accent:{colorSet:_("#FF2D95"),isThemeColor:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.gray,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"white",contrast:3}},secondary:{backgroundColor:{category:"secondary",scale:"solid"},foregroundColor:{tint:"black",contrast:10}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"interactive-bg",isInverted:!0},featured:{category:"accent",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"laser-grid":eV({id:"laser-grid",name:"Laser Grid",category:"electric",description:"A neon green palette with very high saturation in the green range at high brightness, paired with a deep navy-blue primary at moderate saturation and very low brightness. The primary creates a rich midnight-blue canvas that grounds the electric neon greens with cool depth rather than purple darkness. A warm neon yellow-green accent adds scanning-beam highlights. Ideal for VR arcades, cybersecurity firms, and synthwave-inspired brands seeking retrofuturistic intensity.",colorPalette:{primary:{colorSet:_("#16275F"),isThemeColor:!0},secondary:{colorSet:_("#39FF14"),isDynamic:!0},accent:{colorSet:_("#B8FF00"),isDynamic:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.gray,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"secondary",scale:"solid"},foregroundColor:{tint:"black",contrast:10}},secondary:{backgroundColor:{category:"primary",scale:"interactive-bg"}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"interactive-bg",isInverted:!0},featured:{category:"secondary",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"plasma-wave":eV({id:"plasma-wave",name:"Plasma Wave",category:"electric",description:"An electric violet palette with a bright orchid-purple accent at high saturation and medium-high brightness, paired with hot pink secondary at very high saturation. The accent delivers a vivid, luminous purple that lifts the palette with vibrant energy against the dark primary base. The dual-neon pairing of orchid and hot pink creates surging plasma energy. Ideal for electronic music labels, esports teams, and futuristic beauty brands.",colorPalette:{primary:{colorSet:_("#12081F"),isDynamic:!0},secondary:{colorSet:_("#FF3CAC"),isDynamic:!0},accent:{colorSet:_("#974CA1"),isThemeColor:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.mauve,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"secondary",scale:"solid"},foregroundColor:{tint:"white",contrast:3}},secondary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"white",contrast:7}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"interactive-bg",isInverted:!0},featured:{category:"secondary",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"acid-mint":eV({id:"acid-mint",name:"Acid Mint",category:"electric",description:"An electric palette with a bright lemon-yellow primary at high brightness and moderate saturation in the yellow range, creating a vivid, energetic warm base. The primary delivers punchy sunshine intensity that pairs with the neon green accent for maximum electric contrast. A dark graphite secondary provides legible contrast. A vivid green accent adds electric punch against the vibrant yellow canvas. Ideal for energy drink brands, fitness apps, and tech startups seeking electric brightness.",colorPalette:{primary:{colorSet:_("#FFF98D"),isDynamic:!0},secondary:{colorSet:_("#1A1A2E"),isDynamic:!0},accent:{colorSet:_("#00E676"),isThemeColor:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.gray,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"black",contrast:10}},secondary:{backgroundColor:{category:"secondary",scale:"solid"},foregroundColor:{tint:"white",contrast:7}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"canvas-bg"},featured:{category:"accent",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"ultra-violet":eV({id:"ultra-violet",name:"Ultra Violet",category:"electric",description:"An electric palette with a vivid sky-blue primary at high brightness and moderate saturation in the cyan range, creating a bright, cheerful cool base. The primary delivers a bold, saturated blue lightness that energizes the layout. A deep dark-purple secondary provides dramatic contrast. A hot neon magenta accent adds electric highlights against the vibrant blue canvas. Ideal for music festivals, creative agencies, and beauty brands seeking a light-on-neon aesthetic.",colorPalette:{primary:{colorSet:_("#88D1FF"),isDynamic:!0},secondary:{colorSet:_("#1A0A30"),isDynamic:!0},accent:{colorSet:_("#D946EF"),isThemeColor:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.mauve,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"white",contrast:7}},secondary:{backgroundColor:{category:"secondary",scale:"solid"},foregroundColor:{tint:"white",contrast:7}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"canvas-bg"},featured:{category:"accent",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"vibrant-market":e$,"candy-pop":eV({id:"candy-pop",name:"Candy Pop",category:"playful",description:"A bright bubblegum-pink palette with high saturation in the pink range at high brightness, paired with sunshine-yellow secondary at very high saturation and maximum brightness. Both scales are intensely cheerful with warm, sugary energy. A turquoise accent at high saturation and medium brightness adds a cool counterpoint. Ideal for ice cream shops, children's brands, and party supply businesses seeking maximum joyfulness.",colorPalette:{primary:{colorSet:_("#FFF0F5"),isDynamic:!0},secondary:{colorSet:_("#FF69B4"),isThemeColor:!0},accent:{colorSet:_("#00CED1"),isDynamic:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.gray,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"secondary",scale:"solid"},foregroundColor:{tint:"white",contrast:3}},secondary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"white",contrast:3}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"canvas-bg"},featured:{category:"secondary",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"tropical-splash":eV({id:"tropical-splash",name:"Tropical Splash",category:"playful",description:"A bright tropical palette with a sunny lemon-yellow primary at high brightness and moderate saturation, paired with vivid coral secondary at high saturation for warm-cool tropical contrast. The primary delivers cheerful sunshine energy while the coral and aqua accents create vibrant island warmth. Ideal for smoothie bars, surf shops, and tropical vacation brands seeking vibrant island vibes.",colorPalette:{primary:{colorSet:_("#FFEF7A"),isDynamic:!0},secondary:{colorSet:_("#FF6B6B"),isThemeColor:!0},accent:{colorSet:_("#00B4D8"),isDynamic:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.gray,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"secondary",scale:"solid"},foregroundColor:{tint:"white",contrast:7}},secondary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"white",contrast:7}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"canvas-bg-2"},featured:{category:"secondary",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"confetti-burst":eV({id:"confetti-burst",name:"Confetti Burst",category:"playful",description:"A bold purple palette with high saturation in the violet range at medium brightness, paired with tangerine secondary at very high saturation and high brightness. The complementary purple-orange pairing creates maximum chromatic contrast. A lime-green accent at high saturation and high brightness adds a third voice of celebration. Ideal for event planners, craft supply stores, and carnival brands seeking bold, multi-hued excitement.",colorPalette:{primary:{colorSet:_("#F8F0FF"),isDynamic:!0},secondary:{colorSet:_("#7C3AED"),isThemeColor:!0},accent:{colorSet:_("#FF8C42"),isDynamic:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.gray,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"secondary",scale:"solid"},foregroundColor:{tint:"white",contrast:7}},secondary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"white",contrast:7}}}}},globalColorOverrides:{background:{base:{category:"accent",scale:"canvas-bg-2"},featured:{category:"secondary",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"sunshine-pop":eV({id:"sunshine-pop",name:"Sunshine Pop",category:"playful",description:"A bright sunshine-yellow palette with very high saturation in the yellow range at high brightness, paired with a deep navy secondary for strong readable contrast. A rich crimson accent at moderate-high saturation and low-medium brightness provides a bold, deeply saturated background base. The dark red grounds the playful energy with confident warmth while the yellow and navy add vibrant focal points. Ideal for lemonade stands, kids' toy brands, and summer festival promoters seeking bold, warm playfulness.",colorPalette:{primary:{colorSet:_("#FFE533"),isThemeColor:!0},secondary:{colorSet:_("#1A1A3E"),isDynamic:!0},accent:{colorSet:_("#B53333"),isDynamic:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.gray,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"secondary",scale:"solid"},foregroundColor:{tint:"white",contrast:7}},secondary:{backgroundColor:{category:"primary",scale:"solid"},foregroundColor:{tint:"black",contrast:10}}}}},globalColorOverrides:{background:{base:{category:"accent",scale:"solid"},featured:{category:"secondary",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),"neon-splash":eV({id:"neon-splash",name:"Neon Splash",category:"playful",description:"A bold playful palette with a rich ocean-blue primary providing cool depth, paired with a vivid neon-lime secondary that delivers maximum chartreuse energy as a punchy counterpoint. The warm-cool contrast between electric green and deep blue creates high-energy visual tension. A vivid hot-pink accent adds playful dynamism. Ideal for smoothie bars, trampoline parks, and skateboard brands seeking maximum visual punch.",colorPalette:{primary:{colorSet:_("#13578A"),isThemeColor:!0},secondary:{colorSet:_("#CEFF00"),isDynamic:!0},accent:{colorSet:_("#FF2994"),isDynamic:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.gray,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"secondary",scale:"solid"},foregroundColor:{tint:"white",contrast:7}},secondary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"white",contrast:7}}}}},globalColorOverrides:{background:{base:{category:"primary",scale:"solid"},featured:{category:"secondary",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}})}),eZ={colorSchemes:(a=new Set((o=[eV({id:"warm-earthy",name:"Warm Earthy",category:"preferred",description:"A warm, earthy color palette featuring deep brown primary tones paired with muted forest green secondary accents. The primary scale offers rich, low-brightness brown solid colors that create a grounded, natural aesthetic. The secondary provides organic green tones that complement the warmth of the primary. High contrast between light backgrounds and dark solid colors establishes clear visual hierarchy. Ideal for florists, garden centers, nurseries, and nature-focused businesses seeking an organic, premium feel.",colorPalette:{primary:{colorSet:_("#405F40"),isDynamic:!0},secondary:{colorSet:_("#F5EDE1"),isDynamic:!0},accent:{colorSet:_("#C2703E"),isThemeColor:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.sand,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"secondary",contrast:7}},secondary:{backgroundColor:{category:"secondary",scale:"interactive-bg-2"}}}}},globalColorOverrides:{background:{base:{category:"secondary",scale:"interactive-bg"},featured:{category:"accent",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}}),eV({id:"rich-contrast",name:"Rich Contrast",category:"preferred",description:"A soft, elegant color palette featuring warm blush primary tones paired with deep navy secondary accents. The primary blush provides a gentle, sophisticated base while the secondary navy adds depth and contrast. The warm primary creates an inviting, feminine aesthetic while the dark secondary grounds the design with bold accents. Clear brightness contrast between light backgrounds and deep solid colors. Perfect for upscale florists, boutique event planners, and premium lifestyle brands seeking refined elegance.",colorPalette:{primary:{colorSet:_("#232335"),isDynamic:!0},secondary:{colorSet:_("#EBCEC0"),isDynamic:!0},accent:{colorSet:_("#C96A5A"),isThemeColor:!0},neutral:{colorSet:_(A.referenceBaseColors.neutral.sand,{neutral:!0})}},themableComponentColorOverrides:{button:{"flat-button":{primary:{backgroundColor:{category:"accent",scale:"solid"},foregroundColor:{tint:"secondary",contrast:7}},secondary:{backgroundColor:{category:"secondary",scale:"interactive-bg-2"}}}}},globalColorOverrides:{background:{base:{category:"secondary",scale:"interactive-bg-3"},featured:{category:"accent",scale:"solid"}},foreground:{strong:{tint:"neutral",contrast:9},medium:{tint:"neutral",contrast:7},light:{tint:"neutral",contrast:5},accent:{tint:"theme",contrast:7},divider:{tint:"neutral",contrast:5},border:{tint:"neutral",contrast:2}}}})]).map(e=>e.id)),[...o,...eX.filter(e=>!a.has(e.id))]),typographyStyles:["elegant-serif","modern","bricolage-grotesque","playfair-source","nunito","oswald-source","space-grotesk","unbounded-geist","albert-sans","libre-baskerville","fraunces-open-sans","work-sans-rubik","lexend","figtree","crimson-pro","syne-geist","montagu-slab","roboto-serif-dm-sans","literata-noto-sans","manrope-lora","libre-bodoni-chivo","newsreader-plus-jakarta-sans","raleway-lato","petrona-hanken-grotesk","vollkorn-jost"],iconStyles:["vinyl","material"],defaultTypographyStyleId:"elegant-serif",defaultIconStyleId:"vinyl",themableComponentOverrides:{button:{variant:"flat-button"}}},e_=[{platform:"facebook",url:"https://www.facebook.com",label:"Facebook"},{platform:"instagram",url:"https://www.instagram.com",label:"Instagram"},{platform:"pinterest",url:"https://www.pinterest.com",label:"Pinterest"}],eQ=e=>{let t=l(e.sectionId),{currentVersion:a}=t.schema,o=eL(),r=void 0!==t.colorTokensSchema,i=void 0===e.colorSchemeId?"1":e.colorSchemeId;return{id:o,instanceId:o,sectionId:e.sectionId,schema:{content:e.content,visualConfig:e.visualConfig,...r&&{colors:{schemeId:i}}},schemaVersion:a}},eJ={"header-basic":eQ({sectionType:"header",sectionId:"header-basic",content:{navItems:[{type:"link",link:{label:"Home",actionType:"page",href:"/"}},{type:"dropdown",label:"Services",navItems:[{label:"Landscape Design",actionType:"page",href:"/services/landscape-design"},{label:"Garden Maintenance",actionType:"page",href:"/services/garden-maintenance"}]},{type:"link",link:{label:"About",actionType:"page",href:"/about"}},{type:"link",link:{label:"Contact",actionType:"page",href:"/contact"}},{type:"link",link:{label:"Blog",actionType:"page",href:"/blog"}}],logo:{type:"image",src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/development/website-builder-v2/florora-logo.svg",alt:"Florora"},buttons:[{label:"Sign In",href:"/sign-in",actionType:"page"}],socialLinks:e_},visualConfig:{showButtons:!1,showSocial:!0}}),"banner-text-and-background-image":eQ({sectionType:"banner",sectionId:"banner-text-and-background-image",content:{kicker:"Garden",heading:"Create your \n dream garden with vibrant blooms.",description:"Transform your outdoor space into a vibrant sanctuary. From lush blooms to timeless layouts, we'll bring beauty and balance to your garden.",buttons:[{label:"Get Started",href:"#get-started",actionType:"section"}],backgroundImage:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770075103972-jzfmpg.png?w=1920",alt:"Professional gardener tending to plants in a beautiful garden"}},visualConfig:{textAlignment:"split",fillViewport:!0}}),"banner-text-and-image":eQ({sectionType:"banner",sectionId:"banner-text-and-image",content:{kicker:"Our Services",heading:"The Gardening \nExperts You Can Trust",description:"We bring years of expertise, a love for nature, and a commitment to quality to every project.",buttons:[{label:"Learn More",href:"#",actionType:"section"}],image:{src:"https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?w=1920&h=1080&fit=crop",alt:"Professional landscaping work in progress"}},visualConfig:{imagePositionOptions:{imagePosition:"right",hasImagePadding:!0},fillViewportOptions:{fillViewport:!1}}}),"feature-grid":eQ({sectionType:"feature",sectionId:"feature-grid",content:{description:"We bring years of expertise, a love for nature, and a commitment to quality to every project. Whether it's a small garden or a full landscape transformation, we ensure exceptional results.",kicker:"Why choose us",heading:"Transform Your \nOutdoor Space with \nOur Expert Care",buttons:[{label:"Talk to an expert",href:"#",actionType:"section"}],items:[{title:"Landscape Design",description:"Stunning, tailored gardens and outdoor spaces designed for you, creating lasting natural beauty.",image:{src:"https://images.unsplash.com/photo-1558904541-efa843a96f01?w=800",alt:"Landscape Design"}},{title:"Lawn & Plant Care",description:"Expert care to keep your lawn and plants lush year-round, ensuring optimal growth patterns.",image:{src:"https://images.unsplash.com/photo-1592595896551-12b371d546d5?w=800&q=80",alt:"Lawn & Plant Care"}},{title:"Sustainable Gardening",description:"Low-maintenance, eco-friendly gardens that save water, promoting environmental harmony naturally.",image:{src:"https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=800&q=80",alt:"Sustainable Gardening"}}]},visualConfig:{imageOptions:{showImages:!0,isCaptionInside:!1}}}),"feature-bento-grid":eQ({sectionType:"feature",sectionId:"feature-bento-grid",content:{kicker:"Why choose us",heading:"Transform Your \nOutdoor Space with \nExpert Care",description:"We bring years of expertise, a love for nature, and a commitment to quality to every project. Whether it's a small garden or a full landscape transformation, we ensure exceptional results.",buttons:[{label:"Talk to an expert",href:"#",actionType:"section"}],items:[{type:"text",title:"Seasonal Cleanup & Landscaping",description:"Spring and fall leaf removal, debris clearing, mulching, and small landscaping enhancements such as planting or edging beds.",isInverted:!1},{type:"text",title:"Aeration & Overseeding",description:"Core aeration to improve soil oxygen and water absorption, followed by overseeding to thicken the turf and repair bare patches.",isInverted:!1},{type:"image",src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770076933831-789tv5.png?w=800",alt:"Seasonal Cleanup & Landscaping"},{type:"image",src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770076902666-1iqwf1.png?w=800&q=80",alt:"Professional landscaper at work"},{type:"text",title:"Fertilization & Weed Control",description:"Scheduled nutrient applications and targeted weed treatments to promote lush growth and prevent invasive species.",isInverted:!1},{type:"text",title:"Garden Maintenance",description:"Regular pruning, trimming, and upkeep to keep your garden looking its best throughout the seasons.",isInverted:!0}]},visualConfig:{}}),"feature-carousel":eQ({sectionType:"feature",sectionId:"feature-carousel",content:{items:[{title:"Guided onboarding",kicker:"Step 1",description:"Personalized setup paths enable every role to get productive on day one.",image:{src:"https://images.unsplash.com/photo-1545239351-1141bd82e8a6?w=1600&q=80",alt:"Team collaborating during onboarding"},buttons:[{label:"Onboarding",actionType:"section",href:"#onboarding"}]},{title:"Workflow automations",kicker:"Step 2",description:"Automate repetitive handoffs with adaptable playbooks built for your processes.",image:{src:"https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=1600&q=80",alt:"Automated workflow dashboard on a laptop"},buttons:[{label:"Automations",actionType:"section",href:"#automations"}]},{title:"Actionable insights",kicker:"Step 3",description:"Real-time dashboards surface trends and recommended actions before issues appear.",image:{src:"https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=800&q=80",alt:"Analytics dashboard showing insights"},buttons:[{label:"Insights",actionType:"section",href:"#insights"}]}]},visualConfig:{}}),"feature-carousel-accordion":eQ({sectionType:"feature",sectionId:"feature-carousel-accordion",content:{heading:"Our Services",description:"We offer a wide range of services to help you create the perfect garden. From garden design to garden maintenance, we have you covered.",items:[{title:"Expert Garden Design",description:"Our team of experienced designers will work with you to create a garden that reflects your style and meets your needs.",image:{src:"https://images.unsplash.com/photo-1558904541-efa843a96f01?w=1600&q=80",alt:"Beautiful garden design"}},{title:"Sustainable Practices",description:"We use eco-friendly methods and native plants to create gardens that are both beautiful and environmentally responsible.",image:{src:"https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=1600&q=80",alt:"Sustainable garden practices"}},{title:"Ongoing Maintenance",description:"Keep your garden looking its best year-round with our comprehensive maintenance services.",image:{src:"https://images.unsplash.com/photo-1530836369250-ef72a3f5cda8?w=1600&q=80",alt:"Garden maintenance service"}},{title:"Expert Garden Design",description:"Our team of experienced designers will work with you to create a garden that reflects your style and meets your needs.",image:{src:"https://images.unsplash.com/photo-1558904541-efa843a96f01?w=1600&q=80",alt:"Beautiful garden design"}},{title:"Sustainable Practices",description:"We use eco-friendly methods and native plants to create gardens that are both beautiful and environmentally responsible.",image:{src:"https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=1600&q=80",alt:"Sustainable garden practices"}}]},visualConfig:{}}),"testimonial-grid":eQ({sectionType:"testimonial",sectionId:"testimonial-grid",content:{kicker:"Testimonials",heading:"See What Our\nCustomers Are Saying",buttons:[{label:"See more testimonials",href:"#",actionType:"section"}],items:[{quote:"Our backyard has never looked so good! The team turned our outdoor area into a lush paradise, and we couldn't be happier!",name:"Sarah Johnson",title:"Small Business Owner",image:{src:"https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&fit=crop",alt:"Sarah Johnson"}},{quote:"The attention to detail and professionalism was outstanding. They transformed our vision into reality beyond our expectations!",name:"Michael Chen",title:"Marketing Director",image:{src:"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop",alt:"Michael Chen"}},{quote:"Exceptional service from start to finish! The results exceeded what we hoped for, and the process was smooth and stress-free.",name:"Emily Rodriguez",title:"Restaurant Owner",image:{src:"https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&h=100&fit=crop",alt:"Emily Rodriguez"}},{quote:"A fantastic experience! The team was knowledgeable, friendly, and delivered top-notch results that truly enhanced our property.",name:"David Lee",title:"Entrepreneur",image:{src:"https://images.unsplash.com/photo-1527980965255-d3b416303d12?w=100&h=100&fit=crop",alt:"David Lee"}}]},visualConfig:{}}),"gallery-grid":eQ({sectionType:"gallery",sectionId:"gallery-grid",content:{kicker:"Our work",heading:"Transform Your \nOutdoor Space with \nOur Expert Care",description:"We bring years of expertise, a love for nature, and a commitment to quality to every project. Whether it's a small garden or a full landscape transformation, we ensure exceptional results.",items:[{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770077002456-rpo7tx.png?w=800",alt:"Beautiful mansion with pool"},{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770078019014-d1u620.png?w=800&q=80",alt:"Garden pathway"},{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770078065389-q1jdu4.png?w=800&q=80",alt:"Professional landscaper at work"},{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770078076143-7jhouf.png?w=800&q=80",alt:"Garden maintenance"},{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770078253004-9g6ni6.png?w=800&q=80",alt:"Outdoor landscaping"}]},visualConfig:{}}),"team-grid":eQ({sectionType:"team",sectionId:"team-grid",content:{kicker:"Meet the Team",heading:"Our Passionate \nGardening Experts",description:"Our team of dedicated professionals brings a wealth of knowledge and a love for nature to every project. Get to know the experts who will transform your outdoor space.",items:[{name:"Sarah Mitchell",role:"Founder & Lead Designer",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770072206783-u06icw.png?w=400&h=400&fit=crop",alt:"Sarah Mitchell"},description:"Sarah brings over 20 years of landscape design experience and a passion for creating outdoor spaces that inspire."},{name:"Marcus Chen",role:"Head Horticulturist",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770072490592-fclt9d.png?w=400&h=400&fit=crop",alt:"Marcus Chen"},description:"Marcus specializes in plant science and sustainable gardening practices, ensuring every garden thrives naturally."},{name:"Emily Rodriguez",role:"Garden Care Manager",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770074373284-uaacsb.png?w=400&h=400&fit=crop",alt:"Emily Rodriguez"},description:"Emily leads our maintenance team with meticulous attention to detail and a genuine love for nurturing plants."},{name:"James Thompson",role:"Landscape Architect",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770074543573-i8eh83.png?w=400&h=400&fit=crop",alt:"James Thompson"},description:"James transforms outdoor spaces with innovative designs that balance aesthetics with functionality and sustainability."},{name:"Olivia Park",role:"Irrigation Specialist",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770074829389-ej3i6m.png?w=400&h=400&fit=crop",alt:"Olivia Park"},description:"Olivia designs efficient watering systems that conserve water while keeping landscapes lush and healthy year-round."},{name:"Daniel Williams",role:"Senior Gardener",image:{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/websites/preview-media/1770074981627-bomu7g.png?w=400&h=400&fit=crop",alt:"Daniel Williams"},description:"Daniel brings hands-on expertise to every project, from planting to pruning, with over 15 years of experience."}]},visualConfig:{showImages:!0}}),"cta-basic":eQ({sectionType:"cta",sectionId:"cta-basic",content:{heading:"Get the Yard You Want Today!",description:"Transform your outdoor space into a vibrant sanctuary. From lush blooms to timeless layouts, we'll bring beauty and balance to your garden.",buttons:[{label:"Talk to an Expert",href:"#",actionType:"section"},{label:"Get a Free Quote",href:"#",actionType:"section"}]},visualConfig:{textAlignment:"center"}}),"cta-background-image":eQ({sectionType:"cta",sectionId:"cta-background-image",content:{heading:"Get the Yard You Want Today!",description:"Transform your outdoor space into a vibrant sanctuary.",backgroundImage:{src:"https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=1920",alt:"Professional gardener tending to plants in a beautiful garden"},buttons:[{label:"Talk to an Expert",href:"#",actionType:"section"},{label:"Get a Free Quote",href:"#",actionType:"section"}]},visualConfig:{textAlignment:"center"}}),"contact-form-text":eQ({sectionType:"contact",sectionId:"contact-form-text",content:{kicker:"Contact us",heading:"Send us a message",description:"We would love to hear from you",fields:[{slug:"name",kind:"built-in",question:"Your Name",answerType:"text",required:!0},{slug:"email",kind:"built-in",question:"Email Address",answerType:"text",required:!0},{slug:"message",kind:"built-in",question:"Your Message",answerType:"textarea",required:!1}],submitLabel:"Send Message",businessContact:{contactEmail:"hello@example.com",contactPhone:"+1 (555) 123-4567",contactAddress:"123 Main St, City, Country"},formSuccess:{successTitle:"Thank you!",successMessage:"We'll get back to you soon.",successButtonLabel:"Send another message"}},visualConfig:{contentAlignment:"split"}}),"text-basic":eQ({sectionType:"text",sectionId:"text-basic",content:{kicker:"Our work",heading:"Transform Your Outdoor Space with Our Expert Care",description:"We bring years of expertise, a love for nature, and a commitment to quality to every project. Whether it's a small garden or a full landscape transformation, we ensure exceptional results."},visualConfig:{alignment:"split"}}),"faq-accordion":eQ({sectionType:"faq",sectionId:"faq-accordion",content:{kicker:"FAQ",heading:"Frequently Asked Questions",description:"Have questions about our services? Find answers to the most common inquiries below.",buttons:[{label:"Contact Us",href:"#contact",actionType:"section"}],items:[{question:"What services do you offer for landscape design and maintenance?",answer:"We offer a variety of services for landscape design and maintenance, including custom garden design, lawn care, tree and shrub planting, irrigation system installation, and seasonal clean-up. Our team is dedicated to creating beautiful outdoor spaces that suit your needs and preferences."},{question:"What is the best time to plant a garden?",answer:"The best time to plant a garden depends on your location and the types of plants you want to grow. Generally, spring and fall are ideal for most plants, as temperatures are moderate and rainfall is more consistent. However, some plants thrive in summer or winter, so it's important to research the specific requirements of your chosen plants."},{question:"How do I maintain my landscape throughout the year?",answer:"Maintaining your landscape throughout the year involves regular tasks such as mowing, watering, fertilizing, pruning, and mulching. In spring, focus on planting and fertilizing. Summer requires consistent watering and pest control. Fall is the time for cleanup and preparation for winter. Winter maintenance includes protecting plants from frost and planning for the next growing season."},{question:"What types of plants thrive in my area?",answer:"The types of plants that thrive in your area depend on your climate zone, soil type, and sun exposure. Native plants are often the best choice as they are adapted to local conditions and require less maintenance. Consider consulting with a local nursery or landscape professional to identify plants that will flourish in your specific environment."},{question:"How can I create a sustainable garden?",answer:"Creating a sustainable garden involves choosing native plants, using organic fertilizers and pest control methods, conserving water through efficient irrigation systems and mulching, composting yard waste, and encouraging beneficial insects and wildlife. These practices help create a healthy ecosystem while reducing environmental impact."}]},visualConfig:{contentAlignment:"split"}}),"pricing-table":eQ({sectionType:"pricing",sectionId:"pricing-table",content:{kicker:"Pricing",heading:"Simple, Transparent \nPricing Plans",description:"Choose the plan that fits your garden needs. From basic maintenance to full landscape transformations, we have options for every budget.",items:[{isFeatured:!1,title:"Basic Care",price:"$99/mo",features:[{title:"Weekly lawn mowing"},{title:"Edge trimming"},{title:"Debris cleanup"},{title:"Monthly plant inspection"}],description:"Essential lawn care to keep your yard looking neat and tidy all season long.",button:{label:"Get Started",href:"#contact",actionType:"section"}},{isFeatured:!0,badgeLabel:"Most popular",title:"Complete Garden",price:"$249/mo",features:[{title:"Everything in Basic Care"},{title:"Seasonal planting"},{title:"Fertilization & weed control"},{title:"Shrub & hedge trimming"},{title:"Irrigation system checks"}],description:"Comprehensive care for a thriving, beautiful garden that impresses year-round.",button:{label:"Get Started",href:"#contact",actionType:"section"}},{isFeatured:!1,title:"Premium Estate",price:"$499/mo",features:[{title:"Everything in Complete Garden"},{title:"Custom landscape design"},{title:"Hardscape maintenance"},{title:"Outdoor lighting care"},{title:"Priority scheduling"},{title:"Dedicated account manager"}],description:"White-glove service for estate properties requiring meticulous attention to every detail.",button:{label:"Contact Us",href:"#contact",actionType:"section"}}]},visualConfig:{}}),"showcase-grid":eQ({sectionType:"showcase",sectionId:"showcase-grid",content:{kicker:"Clients",heading:"We work with the top companies",description:"With years of experience and a love for nature, we ensure quality in every project, from small gardens to full landscape makeovers.",items:[{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/infinite-design/example-logos/color/logo-1.svg",alt:"Logo 1"},{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/infinite-design/example-logos/color/logo-2.svg",alt:"Logo 2"},{src:"https://rjdavx8ozyznxeyh.public.blob.vercel-storage.com/production/infinite-design/example-